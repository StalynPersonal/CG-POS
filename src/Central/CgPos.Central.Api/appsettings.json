{
  "ConnectionStrings": {
    "BaseDatosCentral": "Server=.;Database=CgPosCentral;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "BaseDatos": {
    "NivelCompatibilidad": 150
  },
  "Central": {
    // true rechaza las conexiones que no vengan por HTTPS. Solo se pone en false para pruebas en una red local.
    "ExigirHttps": true
  },
  "Seguridad": {
    "ClaveFirmaJwt": ""
  },
  "Dgii": {
    // Cliente → Http (la DGII de verdad; es el predeterminado) · Simulado (acepta todo sin enviar nada, solo desarrollo)
    "Cliente": "Http",
    "Certificado": {
      "Ruta": "",
      "Pin": ""
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Principal": {
        "Url": "https://*:7280"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\CGPOS\\Central\\Logs\\central-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
