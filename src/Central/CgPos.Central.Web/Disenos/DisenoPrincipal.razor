@inherits LayoutComponentBase
@implements IDisposable
@inject AlmacenSesionCentral Almacen
@inject ServicioSesionCentral Sesiones
@inject NavigationManager Navegacion

<ProveedoresCgPos />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _menuAbierto = !_menuAbierto" />
        <MudText Typo="Typo.h6" Class="cg-central__marca">CG-POS<span>Central</span></MudText>
        <MudSpacer />
        @if (Almacen.Sesion is { } sesion)
        {
            @* El botón del menú lo arma el propio MudMenu: un botón propio dentro del activador se queda con el clic y no despliega. *@
            <MudMenu Label="@sesion.Nombre" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AccountCircle"
                     EndIcon="@Icons.Material.Filled.ArrowDropDown" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ChildContent>
                    <div class="cg-central__menu-usuario">
                        <strong>@sesion.Codigo</strong>
                        <span>@sesion.RolNombre</span>
                    </div>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Password" Href="cambiar-contrasena">Cambiar contraseña</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="CerrarSesionAsync">Cerrar sesión</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_menuAbierto" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="@DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Inicio</MudNavLink>
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarOrganizacion">
                <MudNavGroup Title="Organización" Icon="@Icons.Material.Filled.Business" Expanded="@EnRuta("organizacion/")">
                    <MudNavLink Href="organizacion/empresa" Icon="@Icons.Material.Filled.Apartment">Empresa</MudNavLink>
                    <MudNavLink Href="organizacion/sucursales" Icon="@Icons.Material.Filled.Store">Sucursales</MudNavLink>
                    <MudNavLink Href="organizacion/cajas" Icon="@Icons.Material.Filled.PointOfSale">Cajas</MudNavLink>
                    <MudNavLink Href="organizacion/parametros" Icon="@Icons.Material.Filled.Tune">Parámetros</MudNavLink>
                    <MudNavLink Href="organizacion/actualizaciones" Icon="@Icons.Material.Filled.SystemUpdate">Actualización de cajas</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.MonitorearSincronizacion">
                <MudNavGroup Title="Sincronización" Icon="@Icons.Material.Filled.Sync" Expanded="@EnRuta("monitor")">
                    <MudNavLink Href="monitor" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.MonitorHeart">Monitor</MudNavLink>
                    <MudNavLink Href="monitor/comprobantes" Icon="@Icons.Material.Filled.ReceiptLong">e-CF y DGII</MudNavLink>
                    <MudNavLink Href="monitor/conflictos" Icon="@Icons.Material.Filled.ReportProblem">Conflictos</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarMaestros">
                <MudNavGroup Title="Maestros" Icon="@Icons.Material.Filled.Inventory2" Expanded="@EnRuta("articulos", "clientes", "maestros")">
                    <MudNavLink Href="articulos" Icon="@Icons.Material.Filled.Inventory">Artículos</MudNavLink>
                    <MudNavLink Href="clientes" Icon="@Icons.Material.Filled.Groups">Clientes</MudNavLink>
                    <MudNavLink Href="maestros" Icon="@Icons.Material.Filled.ListAlt">Catálogos</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarPrecios">
                <MudNavGroup Title="Precios" Icon="@Icons.Material.Filled.Sell" Expanded="@EnRuta("precios/")">
                    <MudNavLink Href="precios/articulos" Icon="@Icons.Material.Filled.PriceChange">Precios de artículos</MudNavLink>
                    <MudNavLink Href="precios/topes" Icon="@Icons.Material.Filled.Discount">Topes de descuento</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarPromociones">
                <MudNavGroup Title="Promociones" Icon="@Icons.Material.Filled.LocalOffer" Expanded="@EnRuta("promociones")">
                    <MudNavLink Href="promociones" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Campaign">Promociones</MudNavLink>
                    <MudNavLink Href="promociones/importar" Icon="@Icons.Material.Filled.UploadFile">Importar</MudNavLink>
                    <MudNavLink Href="promociones/simular" Icon="@Icons.Material.Filled.Calculate">Simular</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarNotasCredito">
                <MudNavGroup Title="Devoluciones" Icon="@Icons.Material.Filled.AssignmentReturn" Expanded="@EnRuta("notas-credito")">
                    <MudNavLink Href="notas-credito" Icon="@Icons.Material.Filled.ReceiptLong">Notas de crédito</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.ConsultarReportes">
                <MudNavGroup Title="Ventas" Icon="@Icons.Material.Filled.ReceiptLong" Expanded="@EnRuta("facturas")">
                    <MudNavLink Href="facturas" Icon="@Icons.Material.Filled.Receipt">Facturas de las cajas</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            @* Cotizaciones: el presupuesto se arma aquí y lo factura cualquier caja. *@
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarCotizaciones">
                <MudNavGroup Title="Cotizaciones" Icon="@Icons.Material.Filled.RequestQuote" Expanded="@EnRuta("cotizaciones")">
                    <MudNavLink Href="cotizaciones" Icon="@Icons.Material.Filled.Description">Presupuestos</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarListasBoda">
                <MudNavGroup Title="Listas de boda" Icon="@Icons.Material.Filled.Favorite" Expanded="@EnRuta("listas-boda")">
                    <MudNavLink Href="listas-boda" Icon="@Icons.Material.Filled.CardGiftcard">Listas de regalos</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarFidelidad">
                <MudNavGroup Title="Fidelidad" Icon="@Icons.Material.Filled.Loyalty" Expanded="@EnRuta("fidelidad/")">
                    <MudNavLink Href="fidelidad/miembros" Icon="@Icons.Material.Filled.CardMembership">Miembros y puntos</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.OperarDespacho">
                <MudNavGroup Title="Despacho" Icon="@Icons.Material.Filled.LocalShipping" Expanded="@EnRuta("despacho/")">
                    <MudNavLink Href="despacho/pendientes" Icon="@Icons.Material.Filled.Inventory2">Pendientes y envíos</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarFiscal">
                <MudNavGroup Title="Fiscal" Icon="@Icons.Material.Filled.ReceiptLong" Expanded="@EnRuta("fiscal/")">
                    <MudNavLink Href="fiscal/secuencias" Icon="@Icons.Material.Filled.FormatListNumbered">Rangos de e-CF</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarUsuariosCaja">
                <MudNavGroup Title="Usuarios de caja" Icon="@Icons.Material.Filled.Badge" Expanded="@EnRuta("cajas/")">
                    <MudNavLink Href="cajas/usuarios" Icon="@Icons.Material.Filled.PersonPin">Usuarios</MudNavLink>
                    <MudNavLink Href="cajas/roles" Icon="@Icons.Material.Filled.Rule">Roles y permisos</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.ConsultarReportes">
                <MudNavGroup Title="Reportes" Icon="@Icons.Material.Filled.Assessment" Expanded="@EnRuta("reportes")">
                    <MudNavLink Href="reportes" Icon="@Icons.Material.Filled.TableChart">Reportes y exportación</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            <AuthorizeView Policy="@CatalogoPermisosCentral.CerrarSucursal">
                <MudNavGroup Title="Cierre de sucursal" Icon="@Icons.Material.Filled.AccountBalance" Expanded="@EnRuta("cierres-sucursal")">
                    <MudNavLink Href="cierres-sucursal" Icon="@Icons.Material.Filled.FactCheck">Cierre y depósitos</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            @* Corregir un cuadre: en la caja, cerrar es definitivo, así que la corrección se hace aquí. *@
            <AuthorizeView Policy="@CatalogoPermisosCentral.AjustarCierres">
                <MudNavGroup Title="Cierres de caja" Icon="@Icons.Material.Filled.PointOfSale" Expanded="@EnRuta("cierres-caja")">
                    <MudNavLink Href="cierres-caja" Icon="@Icons.Material.Filled.RuleFolder">Cuadres y correcciones</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
            @* Seguridad: usuarios y roles del Central, y la auditoría de todo lo que se hace en él. *@
            @if (TieneAlguno(CatalogoPermisosCentral.AdministrarSeguridad, CatalogoPermisosCentral.ConsultarAuditoria))
            {
            <MudNavGroup Title="Seguridad" Icon="@Icons.Material.Filled.Security" Expanded="@EnRuta("seguridad/")">
                <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarSeguridad">
                    <MudNavLink Href="seguridad/usuarios" Icon="@Icons.Material.Filled.People">Usuarios</MudNavLink>
                    <MudNavLink Href="seguridad/roles" Icon="@Icons.Material.Filled.AdminPanelSettings">Roles y permisos</MudNavLink>
                </AuthorizeView>
                <AuthorizeView Policy="@CatalogoPermisosCentral.ConsultarAuditoria">
                    <MudNavLink Href="seguridad/auditoria" Icon="@Icons.Material.Filled.History">Auditoría</MudNavLink>
                </AuthorizeView>
            </MudNavGroup>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuAbierto = true;

    /// <summary>
    /// El menú se muestra agrupado: cada grupo arranca cerrado y solo queda abierto el de la página en la que se está, para
    /// que no haya que desplazarse por todas las opciones.
    /// </summary>
    /// <summary>El grupo se muestra si el usuario tiene al menos uno de sus permisos; cada opción se filtra por el suyo.</summary>
    private bool TieneAlguno(params string[] permisos) =>
        Almacen.Sesion is { DebeCambiarContrasena: false, Permisos: { } suyos } && permisos.Any(suyos.Contains);

    private bool EnRuta(params string[] prefijos)
    {
        var ruta = Navegacion.ToBaseRelativePath(Navegacion.Uri).Split('?')[0].TrimStart('/');
        return prefijos.Any(prefijo => ruta.StartsWith(prefijo, StringComparison.OrdinalIgnoreCase));
    }

    protected override void OnInitialized()
    {
        Almacen.Cambio += AlCambiarSesion;
        Navegacion.LocationChanged += AlNavegar;
        ExigirCambioContrasena();
    }

    /// <summary>Con una contraseña temporal solo se puede cambiar la contraseña.</summary>
    private void ExigirCambioContrasena()
    {
        if (Almacen.Sesion is { DebeCambiarContrasena: true } && !Navegacion.Uri.EndsWith("/cambiar-contrasena", StringComparison.OrdinalIgnoreCase))
            Navegacion.NavigateTo("cambiar-contrasena", replace: true);
    }

    private void AlNavegar(object? remitente, LocationChangedEventArgs evento)
    {
        ExigirCambioContrasena();
        StateHasChanged();
    }

    private void AlCambiarSesion() => InvokeAsync(() =>
    {
        if (!Almacen.Activa)
            Navegacion.NavigateTo("ingreso", replace: true);
        else
            ExigirCambioContrasena();

        StateHasChanged();
    });

    private Task CerrarSesionAsync() => Sesiones.CerrarAsync();

    public void Dispose()
    {
        Almacen.Cambio -= AlCambiarSesion;
        Navegacion.LocationChanged -= AlNavegar;
    }
}
