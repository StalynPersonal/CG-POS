@* Detalle de una nota de crédito: saldo y movimientos. Una vencida se habilita subiendo los días de vigencia (Devoluciones.DiasVigenciaNotaCredito). *@
@using CgPos.Dominio.Devoluciones
@inject ClienteCentral Central

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="6" sm="3"><div class="cg-central__detalle">Número</div>@Nota.Numero</MudItem>
            <MudItem xs="6" sm="3"><div class="cg-central__detalle">Emitida</div>@Nota.EmitidaEn.ToLocalTime().ToString("dd/MM/yyyy")</MudItem>
            <MudItem xs="6" sm="3"><div class="cg-central__detalle">Sucursal y caja</div>@Nota.SucursalCodigo · @Nota.CajaCodigo</MudItem>
            <MudItem xs="6" sm="3"><div class="cg-central__detalle">Vence</div>@Nota.VenceEn.ToString("dd/MM/yyyy")</MudItem>
            <MudItem xs="12" sm="6"><div class="cg-central__detalle">Cliente</div>@Nota.ClienteNombre (@Nota.ClienteDocumento)</MudItem>
            <MudItem xs="6" sm="3"><div class="cg-central__detalle">Total</div>@Nota.Moneda @Nota.Total.ToString("N2")</MudItem>
            <MudItem xs="6" sm="3">
                <div class="cg-central__detalle">Disponible</div>
                <MudText Typo="Typo.h6" Color="Color.Primary">@Nota.Disponible.ToString("N2")</MudText>
                @if (Nota.Reservado > 0)
                {
                    <div class="cg-central__detalle">Reservado @Nota.Reservado.ToString("N2")</div>
                }
            </MudItem>

            @if (Nota.Sobregirada)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">
                        Las cajas consumieron @Nota.Consumido.ToString("N2") de un total de @Nota.Total.ToString("N2"): revíselo con las sucursales.
                    </MudAlert>
                </MudItem>
            }
            @if (Nota.Estado == EstadoNotaCreditoCentral.Vencida)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Venció con la vigencia configurada. Para que vuelva a poder usarse, suba los días de vigencia de las notas de crédito en los parámetros.
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12"><MudText Typo="Typo.subtitle1">Movimientos</MudText></MudItem>
            <MudItem xs="12">
                <MudSimpleTable Dense="true" Style="max-height: 280px; overflow-y: auto">
                    <thead>
                        <tr><th>Fecha</th><th>Tipo</th><th>Caja</th><th style="text-align: right">Monto</th><th>Detalle</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var movimiento in _movimientos)
                        {
                            <tr>
                                <td>@movimiento.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@movimiento.Tipo</td>
                                <td>@movimiento.CajaCodigo</td>
                                <td style="text-align: right">@(movimiento.Monto == 0 ? "" : movimiento.Monto.ToString("N2"))</td>
                                <td>@movimiento.Detalle</td>
                            </tr>
                        }
                        @if (_movimientos.Count == 0)
                        {
                            <tr><td colspan="5">Sin movimientos.</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>

        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialogo.Cancel()">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter] public DatosNotaCreditoCentral Nota { get; set; } = default!;

    private IReadOnlyList<DatosMovimientoNotaCredito> _movimientos = [];

    protected override async Task OnInitializedAsync() =>
        _movimientos = await Central.ListarMovimientosNotaCreditoAsync(Nota.Id) ?? [];
}
