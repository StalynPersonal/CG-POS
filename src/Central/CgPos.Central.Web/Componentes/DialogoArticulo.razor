@* Alta o edición de un artículo. Los precios solo se indican al crearlo; después se cambian en Precios, con vigencia. *@
@using CgPos.Contratos.Catalogo
@using CgPos.Dominio.Catalogo
@inject ClienteCentral Cliente

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined" Disabled="@(Articulo is not null)" HelperText="No cambia después de crearlo." />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField T="string" @bind-Value="_descripcion" Label="Descripción" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="TipoArticulo" @bind-Value="_tipo" Label="Tipo" Variant="Variant.Outlined" ToStringFunc="EtiquetasArticulo.Tipo">
                    @foreach (var tipo in EtiquetasArticulo.Tipos)
                    {
                        <MudSelectItem T="TipoArticulo" Value="@tipo">@EtiquetasArticulo.Tipo(tipo)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField T="string" @bind-Value="_referencia" Label="Referencia (opcional)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" Value="_departamento" ValueChanged="CambiarDepartamento" Label="Departamento" Placeholder="Seleccione" Variant="Variant.Outlined"
                           ToStringFunc="@(codigo => Referencias.Departamentos.FirstOrDefault(f => f.Codigo == codigo)?.Nombre)">
                    @foreach (var departamento in Referencias.Departamentos.Where(f => f.Activa || f.Codigo == Articulo?.DepartamentoCodigo))
                    {
                        <MudSelectItem T="int?" Value="@departamento.Codigo">@departamento.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" @bind-Value="_categoria" Label="Categoría" Placeholder="Seleccione" Variant="Variant.Outlined" Required="true" RequiredError="Obligatorio"
                           Disabled="@(_departamento is null)" HelperText="@(_departamento is null ? "Elija primero el departamento." : null)"
                           ToStringFunc="@(codigo => Referencias.Categorias.FirstOrDefault(c => c.Codigo == codigo)?.Nombre)">
                    @foreach (var categoria in Referencias.Categorias.Where(c => c.DepartamentoCodigo == _departamento && (c.Activa || c.Codigo == Articulo?.CategoriaCodigo)))
                    {
                        <MudSelectItem T="int?" Value="@categoria.Codigo">@categoria.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" @bind-Value="_marca" Label="Marca (opcional)" Placeholder="Sin marca" Variant="Variant.Outlined" Clearable="true"
                           ToStringFunc="@(codigo => Referencias.Marcas.FirstOrDefault(m => m.Codigo == codigo)?.Nombre)">
                    @foreach (var marca in Referencias.Marcas.Where(m => m.Activa || m.Codigo == Articulo?.MarcaCodigo))
                    {
                        <MudSelectItem T="int?" Value="@marca.Codigo">@marca.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int?" @bind-Value="_unidad" Label="Unidad de medida" Placeholder="Seleccione" Variant="Variant.Outlined"
                           ToStringFunc="@(codigo => Referencias.Unidades.FirstOrDefault(u => u.Codigo == codigo)?.Nombre)">
                    @foreach (var unidad in Referencias.Unidades)
                    {
                        <MudSelectItem T="int?" Value="@unidad.Codigo">@unidad.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" @bind-Value="_impuesto" Label="Impuesto" Placeholder="Seleccione" Variant="Variant.Outlined"
                           ToStringFunc="@(codigo => Referencias.Impuestos.FirstOrDefault(i => i.Codigo == codigo)?.Nombre)">
                    @foreach (var impuesto in Referencias.Impuestos.Where(i => i.Activo || i.Codigo == Articulo?.ImpuestoCodigo))
                    {
                        <MudSelectItem T="string" Value="@impuesto.Codigo">@impuesto.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_codigosBarras" Label="Códigos de barras" Variant="Variant.Outlined" Lines="3" HelperText="Uno por línea." />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_codigosProveedor" Label="Códigos de proveedor" Variant="Variant.Outlined" Lines="3" HelperText="Uno por línea." />
            </MudItem>

            @if (Articulo is null)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1">Precios iniciales</MudText>
                    <MudText Typo="Typo.caption" Class="cg-central__detalle">Detalle, mayor, mínimo y costo sin impuesto: el ITBIS se suma al vender.</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="_precioDetalle" Label="Precio detalle" Variant="Variant.Outlined" HideSpinButtons="true" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="_precioMayor" Label="Precio por mayor" Variant="Variant.Outlined" HideSpinButtons="true" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="_cantidadMinimaMayor" Label="Cantidad mínima para mayor" Variant="Variant.Outlined" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="_precioMinimo" Label="Precio mínimo" Variant="Variant.Outlined" HideSpinButtons="true" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal?" @bind-Value="_costo" Label="Costo" Variant="Variant.Outlined" HideSpinButtons="true" Format="N2" />
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Detalle @Articulo.PrecioDetalle.ToString("N2")@(Articulo.PrecioMayor is { } mayor ? $" · Mayor {mayor:N2}" : "")@(Articulo.PrecioMinimo is { } minimo ? $" · Mínimo {minimo:N2}" : "").
                        Los precios se cambian en Precios de artículos.
                    </MudAlert>
                </MudItem>
            }

            <MudItem xs="12" sm="4">
                <MudNumericField T="decimal?" @bind-Value="_pesoEmpaque" Label="Peso del empaque (pesados)" Variant="Variant.Outlined" HideSpinButtons="true"
                                 HelperText="Se descuenta del peso de la balanza: bandeja, envase o bolsa" />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField T="string" @bind-Value="_rutaImagen" Label="Ruta de la imagen (opcional)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="_mostrarEnCatalogo" Label="Mostrar en el catálogo de la caja" Color="Color.Secondary" />
                <MudSwitch T="bool" @bind-Value="_ventaEnPos" Label="Se vende en la caja" Color="Color.Secondary" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="_esServicio" Label="Es un servicio" Color="Color.Secondary" />
                <MudSwitch T="bool" @bind-Value="_activo" Label="@(_activo ? "Activo" : "Inactivo")" Color="Color.Secondary" />
            </MudItem>

            @if (_mensaje is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@_mensaje</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_procesando" OnClick="GuardarAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter] public ArticuloCarga? Articulo { get; set; }
    [Parameter] public ReferenciasArticulo Referencias { get; set; } = ReferenciasArticulo.Vacias;

    private string? _codigo;
    private string? _descripcion;
    private string? _referencia;
    private TipoArticulo _tipo = TipoArticulo.Normal;
    private int? _departamento;
    private int? _categoria;
    private int? _marca;
    private int? _unidad;
    private string? _impuesto;
    private string? _codigosBarras;
    private string? _codigosProveedor;
    private decimal? _precioDetalle;
    private decimal? _precioMayor;
    private decimal? _cantidadMinimaMayor;
    private decimal? _precioMinimo;
    private decimal? _costo;
    private decimal? _pesoEmpaque;
    private string? _rutaImagen;
    private bool _mostrarEnCatalogo;
    private bool _ventaEnPos = true;
    private bool _esServicio;
    private bool _activo = true;
    private string? _mensaje;
    private bool _procesando;

    protected override void OnInitialized()
    {
        if (Articulo is not { } a)
            return;

        (_codigo, _descripcion, _referencia, _tipo) = (a.Codigo, a.Descripcion, a.Referencia, a.Tipo);
        (_departamento, _unidad, _impuesto) = (a.DepartamentoCodigo, a.UnidadMedidaCodigo, a.ImpuestoCodigo);
        (_categoria, _marca) = (a.CategoriaCodigo, a.MarcaCodigo);
        _codigosBarras = string.Join(Environment.NewLine, a.CodigosBarras ?? []);
        _codigosProveedor = string.Join(Environment.NewLine, a.CodigosProveedor ?? []);
        (_pesoEmpaque, _rutaImagen, _mostrarEnCatalogo, _ventaEnPos, _esServicio, _activo) = (a.PesoEmpaque, a.RutaImagen, a.MostrarEnCatalogo, a.VentaEnPos, a.EsServicio, a.Activo);
    }

    /// <summary>La categoría es del departamento: al cambiarlo se quita si ya no corresponde.</summary>
    private void CambiarDepartamento(int? departamento)
    {
        _departamento = departamento;
        if (_categoria is { } categoria && Referencias.Categorias.FirstOrDefault(c => c.Codigo == categoria)?.DepartamentoCodigo != departamento)
            _categoria = null;
    }

    private static List<string> Lineas(string? texto) =>
        (texto ?? string.Empty).Split(['\n', '\r', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct().ToList();

    private async Task GuardarAsync()
    {
        _mensaje = (_departamento, _unidad, _impuesto) switch
        {
            _ when string.IsNullOrWhiteSpace(_codigo) => "Indique el código.",
            (null, _, _) => "Seleccione el departamento.",
            _ when _categoria is null => "Seleccione la categoría.",
            (_, null, _) => "Seleccione la unidad de medida.",
            (_, _, null) => "Seleccione el impuesto.",
            _ when Articulo is null && _precioDetalle is null => "Indique el precio detalle.",
            _ => null,
        };
        if (_mensaje is not null)
            return;

        var articulo = new ArticuloCarga(
            _codigo!.Trim(),
            _descripcion ?? string.Empty,
            _departamento!.Value,
            _unidad!.Value,
            _impuesto!,
            Articulo?.PrecioDetalle ?? _precioDetalle!.Value,
            Articulo is null ? _precioMayor : Articulo.PrecioMayor,
            _tipo,
            string.IsNullOrWhiteSpace(_referencia) ? null : _referencia.Trim(),
            Articulo is null ? _costo : Articulo.Costo,
            Articulo is null ? _precioMinimo : Articulo.PrecioMinimo,
            Articulo is null ? _cantidadMinimaMayor : Articulo.CantidadMinimaMayor,
            Lineas(_codigosBarras),
            Lineas(_codigosProveedor),
            string.IsNullOrWhiteSpace(_rutaImagen) ? null : _rutaImagen.Trim(),
            _mostrarEnCatalogo,
            _ventaEnPos,
            _activo,
            Articulo?.PreciosVigentesDesde,
            _pesoEmpaque,
            _esServicio,
            _categoria,
            _marca);

        _procesando = true;
        var respuesta = await Cliente.GuardarArticuloAsync(articulo, nuevo: Articulo is null);
        _procesando = false;

        if (respuesta.Exitosa)
            Dialogo.Close(DialogResult.Ok(true));
        else
            _mensaje = respuesta.Mensaje ?? "No se pudo guardar el artículo.";
    }
}
