@* Pide el motivo obligatorio de una operación y lo devuelve como resultado del diálogo. *@

<MudDialog>
    <DialogContent>
        <div class="cg-central__dialogo">
            <MudText Typo="Typo.body1">@Mensaje</MudText>
            <MudTextField T="string" @bind-Value="_motivo" Label="@Etiqueta" Variant="Variant.Outlined" Lines="2" Immediate="true" AutoFocus="true" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@string.IsNullOrWhiteSpace(_motivo)" OnClick="() => Dialogo.Close(DialogResult.Ok(_motivo!.Trim()))">
            @TextoConfirmar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter] public string Mensaje { get; set; } = string.Empty;
    [Parameter] public string Etiqueta { get; set; } = "Motivo";
    [Parameter] public string TextoConfirmar { get; set; } = "Aceptar";

    private string? _motivo;
}
