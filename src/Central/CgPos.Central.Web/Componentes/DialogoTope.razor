@* Alta o edición de un tope de descuento: alcance (general, departamento, categoría, marca o artículo), nivel y máximos. *@
@using CgPos.Contratos.Catalogo
@inject ClienteCentral Cliente

<MudDialog>
    <DialogContent>
        <div class="cg-central__dialogo">
            <MudRadioGroup T="string" @bind-Value="_alcance">
                <MudRadio T="string" Value="@General" Color="Color.Secondary">General</MudRadio>
                <MudRadio T="string" Value="@PorDepartamento" Color="Color.Secondary">Departamento</MudRadio>
                <MudRadio T="string" Value="@PorCategoria" Color="Color.Secondary">Categoría</MudRadio>
                <MudRadio T="string" Value="@PorMarca" Color="Color.Secondary">Marca</MudRadio>
                <MudRadio T="string" Value="@PorArticulo" Color="Color.Secondary">Artículo</MudRadio>
            </MudRadioGroup>

            @if (_alcance == PorDepartamento)
            {
                <MudSelect T="int?" @bind-Value="_departamento" Label="Departamento" Placeholder="Seleccione el departamento" Variant="Variant.Outlined"
                           ToStringFunc="@(codigo => Departamentos.FirstOrDefault(f => f.Codigo == codigo) is { } f ? $"{f.Codigo} · {f.Nombre}" : null)">
                    @foreach (var departamento in Departamentos)
                    {
                        <MudSelectItem T="int?" Value="@departamento.Codigo">@departamento.Codigo · @departamento.Nombre</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (_alcance == PorCategoria)
            {
                <MudSelect T="int?" @bind-Value="_categoria" Label="Categoría" Placeholder="Seleccione la categoría" Variant="Variant.Outlined"
                           ToStringFunc="@(codigo => Categorias.FirstOrDefault(c => c.Codigo == codigo) is { } c ? $"{c.Codigo} · {c.Nombre}" : null)">
                    @foreach (var categoria in Categorias)
                    {
                        <MudSelectItem T="int?" Value="@categoria.Codigo">@categoria.Codigo · @categoria.Nombre</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (_alcance == PorMarca)
            {
                <MudSelect T="int?" @bind-Value="_marca" Label="Marca" Placeholder="Seleccione la marca" Variant="Variant.Outlined"
                           ToStringFunc="@(codigo => Marcas.FirstOrDefault(m => m.Codigo == codigo) is { } m ? $"{m.Codigo} · {m.Nombre}" : null)">
                    @foreach (var marca in Marcas)
                    {
                        <MudSelectItem T="int?" Value="@marca.Codigo">@marca.Codigo · @marca.Nombre</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (_alcance == PorArticulo)
            {
                <MudAutocomplete T="ArticuloCarga" @bind-Value="_articulo" SearchFunc="BuscarArticulosAsync" Label="Artículo" Variant="Variant.Outlined"
                                 ToStringFunc="@(a => a is null ? null : $"{a.Codigo} · {a.Descripcion}")" DebounceInterval="350" MinCharacters="2"
                                 Placeholder="@(_articuloOriginal is not null ? Tope!.Alcance : "Busque por código o descripción")" ResetValueOnEmptyText="true" />
            }

            <MudNumericField T="int" @bind-Value="_nivel" Label="Nivel del autorizador" Variant="Variant.Outlined" Min="1" Max="9"
                             HelperText="El mismo nivel de los roles de caja: 1 cajero, 5 supervisor, 8 gerente." />
            <div class="d-flex gap-3">
                <MudNumericField T="decimal?" @bind-Value="_porcentaje" Label="% máximo" Variant="Variant.Outlined" HideSpinButtons="true" />
                <MudNumericField T="decimal?" @bind-Value="_monto" Label="Monto máximo" Variant="Variant.Outlined" HideSpinButtons="true" Format="N2" />
            </div>
            <MudText Typo="Typo.caption" Class="cg-central__detalle">Indique uno o ambos. Para retirar un tope, déjelo en 0.</MudText>

            @if (_mensaje is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_mensaje</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_procesando" OnClick="GuardarAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string General = "general";
    private const string PorDepartamento = "departamento";
    private const string PorCategoria = "categoria";
    private const string PorMarca = "marca";
    private const string PorArticulo = "articulo";

    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter] public DatosTopeDescuentoCentral? Tope { get; set; }
    [Parameter] public IReadOnlyList<DepartamentoCarga> Departamentos { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoriaCarga> Categorias { get; set; } = [];
    [Parameter] public IReadOnlyList<MarcaCarga> Marcas { get; set; } = [];

    private string _alcance = General;
    private int? _departamento;
    private int? _categoria;
    private int? _marca;
    private ArticuloCarga? _articulo;
    private string? _articuloOriginal;
    private int? _codigo;
    private int _nivel = 1;
    private decimal? _porcentaje;
    private decimal? _monto;
    private string? _mensaje;
    private bool _procesando;

    protected override async Task OnInitializedAsync()
    {
        if (Tope?.Tope is not { } tope)
        {
            // Un tope nuevo recibe el siguiente código; los topes se identifican por él en las cajas.
            _codigo = await Cliente.SiguienteCodigoAsync("precios", "topes");
            return;
        }

        _alcance = tope switch
        {
            { ArticuloCodigo: not null } => PorArticulo,
            { CategoriaCodigo: not null } => PorCategoria,
            { MarcaCodigo: not null } => PorMarca,
            { DepartamentoCodigo: not null } => PorDepartamento,
            _ => General,
        };
        (_codigo, _departamento, _articuloOriginal, _nivel, _porcentaje, _monto) = (tope.Codigo, tope.DepartamentoCodigo, tope.ArticuloCodigo, tope.Nivel, tope.PorcentajeMaximo, tope.MontoMaximo);
        (_categoria, _marca) = (tope.CategoriaCodigo, tope.MarcaCodigo);
    }

    private async Task<IEnumerable<ArticuloCarga>> BuscarArticulosAsync(string texto, CancellationToken cancelacion) =>
        (await Cliente.BuscarArticulosAsync("precios", texto, 0, 20, cancelacion))?.Elementos.Select(e => e.Dato) ?? [];

    private async Task GuardarAsync()
    {
        int? departamento = _alcance == PorDepartamento ? _departamento : null;
        int? categoria = _alcance == PorCategoria ? _categoria : null;
        int? marca = _alcance == PorMarca ? _marca : null;
        var articulo = _alcance == PorArticulo ? _articulo?.Codigo ?? _articuloOriginal : null;

        _mensaje = (_alcance, departamento, articulo) switch
        {
            _ when _codigo is null => "No se pudo obtener el código del tope; vuelva a abrir la ventana.",
            (PorDepartamento, null, _) => "Seleccione el departamento.",
            (PorArticulo, _, null) => "Busque y seleccione el artículo.",
            (PorCategoria, _, _) when categoria is null => "Seleccione la categoría.",
            (PorMarca, _, _) when marca is null => "Seleccione la marca.",
            _ when _porcentaje is null && _monto is null => "Indique el porcentaje o el monto máximo.",
            _ => null,
        };
        if (_mensaje is not null)
            return;

        _procesando = true;
        var respuesta = await Cliente.GuardarTopeAsync(new TopeDescuentoCarga(_codigo!.Value, _nivel, _porcentaje, _monto, departamento, articulo, categoria, marca),
            nuevo: Tope is null);
        _procesando = false;

        if (respuesta.Exitosa)
            Dialogo.Close(DialogResult.Ok(true));
        else
            _mensaje = respuesta.Mensaje ?? "No se pudo guardar el tope.";
    }
}
