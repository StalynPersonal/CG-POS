@* Alta o edición de un cliente con sus direcciones de envío. Cambiar el documento de un cliente existente es una corrección auditada: pide motivo. *@
@using CgPos.Contratos.Catalogo
@using CgPos.Dominio.Catalogo
@using CgPos.Dominio.Fiscal
@inject ClienteCentral Central

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined" Disabled="@(Cliente is not null)"
                              HelperText="Identifica al cliente en las cajas; no cambia después de crearlo." />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="TipoDocumentoIdentidad" @bind-Value="_tipoDocumento" Label="Tipo de documento" Variant="Variant.Outlined"
                           ToStringFunc="EtiquetasCliente.Documento">
                    @foreach (var tipo in EtiquetasCliente.Documentos)
                    {
                        <MudSelectItem T="TipoDocumentoIdentidad" Value="@tipo">@EtiquetasCliente.Documento(tipo)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_documento" Label="Documento" Variant="Variant.Outlined" Immediate="true"
                              HelperText="Cédula de 11 dígitos o RNC de 9, con o sin guiones." />
            </MudItem>
            @if (CorrigeDocumento)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        Se corregirá el documento del cliente. Las facturas y documentos ya emitidos conservan los datos con que se emitieron.
                    </MudAlert>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_motivoCorreccion" Label="Motivo de la corrección" Variant="Variant.Outlined" Required="true"
                                  RequiredError="Obligatorio" HelperText="Queda en la auditoría con el documento anterior y el nuevo." />
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_nombre" Label="Nombre o razón social" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_contacto" Label="Contacto" Variant="Variant.Outlined"
                              HelperText="Persona con la que se trata en este cliente." />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_correo" Label="Correo" Variant="Variant.Outlined" InputType="InputType.Email" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_telefono" Label="Teléfono" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_telefonoAlterno" Label="Otro teléfono" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="TipoComprobante" @bind-Value="_comprobante" Label="Comprobante predeterminado" Variant="Variant.Outlined" ToStringFunc="EtiquetasCliente.Comprobante">
                    @foreach (var tipo in EtiquetasCliente.Comprobantes)
                    {
                        <MudSelectItem T="TipoComprobante" Value="@tipo">@EtiquetasCliente.Comprobante(tipo)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="ListaPrecio" @bind-Value="_lista" Label="Lista de precios" Variant="Variant.Outlined" ToStringFunc="EtiquetasCliente.Lista">
                    @foreach (var lista in EtiquetasCliente.Listas)
                    {
                        <MudSelectItem T="ListaPrecio" Value="@lista">@EtiquetasCliente.Lista(lista)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSwitch T="bool" @bind-Value="_exonerado" Label="Exonerado de ITBIS" Color="Color.Secondary" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSwitch T="bool" @bind-Value="_retencion" Label="Aplica retención" Color="Color.Secondary" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSwitch T="bool" @bind-Value="_activo" Label="@(_activo ? "Activo" : "Inactivo")" Color="Color.Secondary" />
            </MudItem>

            <MudItem xs="12" Class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.subtitle1">Direcciones de envío</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AddLocationAlt" OnClick="AgregarDireccion">Agregar dirección</MudButton>
            </MudItem>
            @if (_direcciones.Count == 0)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="cg-central__detalle">Sin direcciones.</MudText>
                </MudItem>
            }
            @foreach (var direccion in _direcciones)
            {
                <MudItem xs="12">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" @bind-Value="direccion.Alias" Label="Alias" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="8">
                                <MudTextField T="string" @bind-Value="direccion.Direccion" Label="Dirección" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" @bind-Value="direccion.Sector" Label="Sector" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" @bind-Value="direccion.Ciudad" Label="Ciudad" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" @bind-Value="direccion.Telefono" Label="Teléfono" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="8">
                                <MudTextField T="string" @bind-Value="direccion.Referencia" Label="Referencia" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="4" Class="d-flex align-center justify-space-between">
                                <MudCheckBox T="bool" Value="@(_principalId == direccion.Id)" ValueChanged="@((bool marcado) => { if (marcado) _principalId = direccion.Id; })"
                                             Label="Principal" Color="Color.Secondary" Dense="true" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => QuitarDireccion(direccion)" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }

            @if (_mensaje is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@_mensaje</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_procesando" OnClick="GuardarAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private sealed class DireccionEditable
    {
        public Guid Id { get; init; } = Guid.CreateVersion7();
        public string? Alias { get; set; }
        public string? Direccion { get; set; }
        public string? Sector { get; set; }
        public string? Ciudad { get; set; }
        public string? Referencia { get; set; }
        public string? Telefono { get; set; }
    }

    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter] public ClienteCarga? Cliente { get; set; }

    private readonly List<DireccionEditable> _direcciones = [];
    private string? _codigo;
    private TipoDocumentoIdentidad _tipoDocumento = TipoDocumentoIdentidad.Cedula;
    private string? _documento;
    private string? _motivoCorreccion;

    /// <summary>Cliente existente al que se le cambió el tipo o el número de documento.</summary>
    private bool CorrigeDocumento => Cliente is not null
        && (_tipoDocumento != Cliente.TipoDocumento || DocumentoIdentidad.Normalizar(_documento) != DocumentoIdentidad.Normalizar(Cliente.Documento));
    private string? _nombre;
    private string? _telefono;
    private string? _correo;
    private TipoComprobante _comprobante = TipoComprobante.FacturaConsumo;
    private ListaPrecio _lista = ListaPrecio.Detalle;
    private bool _exonerado;
    private bool _retencion;
    private bool _activo = true;
    private string? _contacto;
    private string? _telefonoAlterno;
    private Guid? _principalId;
    private string? _mensaje;
    private bool _procesando;

    protected override void OnInitialized()
    {
        if (Cliente is not { } c)
            return;

        (_codigo, _tipoDocumento, _documento, _nombre, _telefono, _correo) = (c.Codigo, c.TipoDocumento, c.Documento, c.Nombre, c.Telefono, c.Correo);
        (_contacto, _telefonoAlterno) = (c.Contacto, c.TelefonoAlterno);
        (_comprobante, _lista, _exonerado, _retencion, _activo) = (c.TipoComprobante, c.ListaPrecio, c.ExoneradoItbis, c.AplicaRetencion, c.Activo);
        foreach (var d in c.Direcciones ?? [])
            _direcciones.Add(new DireccionEditable { Alias = d.Alias, Direccion = d.Direccion, Sector = d.Sector, Ciudad = d.Ciudad, Referencia = d.Referencia, Telefono = d.Telefono });
        var principal = c.Direcciones?.FirstOrDefault(d => d.EsPrincipal)?.Alias;
        _principalId = _direcciones.FirstOrDefault(d => d.Alias == principal)?.Id ?? _direcciones.FirstOrDefault()?.Id;
    }

    private void AgregarDireccion()
    {
        var nueva = new DireccionEditable { Alias = _direcciones.Count == 0 ? "Principal" : null };
        _direcciones.Add(nueva);
        _principalId ??= nueva.Id;
    }

    private void QuitarDireccion(DireccionEditable direccion)
    {
        _direcciones.Remove(direccion);
        if (_principalId == direccion.Id)
            _principalId = _direcciones.FirstOrDefault()?.Id;
    }

    private static string? Opcional(string? texto) => string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();

    private async Task GuardarAsync()
    {
        _mensaje = string.IsNullOrWhiteSpace(_codigo) ? "Indique el código del cliente."
            : string.IsNullOrWhiteSpace(_documento) ? $"Indique el número de {EtiquetasCliente.Documento(_tipoDocumento).ToLowerInvariant()}."
            : string.IsNullOrWhiteSpace(_nombre) ? "Indique el nombre o la razón social."
            : _direcciones.Any(d => string.IsNullOrWhiteSpace(d.Alias) || string.IsNullOrWhiteSpace(d.Direccion)) ? "Cada dirección necesita alias y dirección."
            : CorrigeDocumento && string.IsNullOrWhiteSpace(_motivoCorreccion) ? "Indique el motivo de la corrección del documento."
            : null;
        if (_mensaje is not null)
            return;

        var direcciones = _direcciones
            .Select(d => new DireccionClienteCarga(d.Alias?.Trim() ?? string.Empty, d.Direccion?.Trim() ?? string.Empty, Opcional(d.Sector), Opcional(d.Ciudad),
                Opcional(d.Referencia), Opcional(d.Telefono), d.Id == _principalId))
            .ToList();
        var cliente = new ClienteCarga(_codigo!.Trim(), _tipoDocumento, _documento?.Trim() ?? string.Empty, _nombre?.Trim() ?? string.Empty,
            _comprobante, _exonerado, _retencion, _lista, Opcional(_telefono), Opcional(_correo), direcciones, _activo,
            Opcional(_contacto), Opcional(_telefonoAlterno));

        _procesando = true;
        _mensaje = null;

        // Primero la corrección auditada del documento; después los demás datos, ya con el documento nuevo.
        if (CorrigeDocumento)
        {
            var correccion = await Central.CorregirDocumentoClienteAsync(Cliente!.Codigo,
                new SolicitudCorreccionDocumentoCliente(_tipoDocumento, _documento?.Trim() ?? string.Empty, _motivoCorreccion!.Trim()));
            if (!correccion.Exitosa)
            {
                _procesando = false;
                _mensaje = correccion.Mensaje ?? "No se pudo corregir el documento.";
                return;
            }

            Cliente = Cliente with { TipoDocumento = _tipoDocumento, Documento = DocumentoIdentidad.Normalizar(_documento) };
        }

        var respuesta = await Central.GuardarClienteAsync(cliente with { Documento = DocumentoIdentidad.Normalizar(cliente.Documento) }, nuevo: Cliente is null);
        _procesando = false;

        if (respuesta.Exitosa)
            Dialogo.Close(DialogResult.Ok(true));
        else
            _mensaje = respuesta.Mensaje ?? "No se pudo guardar el cliente.";
    }
}
