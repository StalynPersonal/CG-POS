@* Alta o edición de una promoción: tipo y valores, vigencia con días y horas, alcance (artículos, departamentos, categorías, marcas, sucursales) y fidelidad. *@
@using CgPos.Contratos.Catalogo
@using CgPos.Dominio.Promociones
@inject ClienteCentral Central

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                @* El código sale de la secuencia de promociones: no se escribe. *@
                <MudTextField T="string" Value="@(_codigo ?? "Se asigna al guardar")" Label="Código" Variant="Variant.Outlined" ReadOnly="true"
                              HelperText="Lo da la secuencia de promociones y no cambia." />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField T="string" @bind-Value="_nombre" Label="Nombre" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="TipoPromocion" @bind-Value="_tipo" Label="Tipo" Variant="Variant.Outlined" ToStringFunc="EtiquetasPromocion.Tipo">
                    @foreach (var tipo in EtiquetasPromocion.Tipos)
                    {
                        <MudSelectItem T="TipoPromocion" Value="@tipo">@EtiquetasPromocion.Tipo(tipo)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (EtiquetasPromocion.EtiquetaValor(_tipo) is { } etiquetaValor)
            {
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?" @bind-Value="_valor" Label="@etiquetaValor" Variant="Variant.Outlined" HideSpinButtons="true" />
                </MudItem>
            }
            @if (_tipo == TipoPromocion.LlevaPaga)
            {
                <MudItem xs="6" sm="3">
                    <MudNumericField T="int?" @bind-Value="_lleva" Label="Lleva" Variant="Variant.Outlined" Min="2" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField T="int?" @bind-Value="_paga" Label="Paga" Variant="Variant.Outlined" Min="1" />
                </MudItem>
            }
            @if (_tipo == TipoPromocion.PrecioPorCantidad)
            {
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal?" @bind-Value="_cantidadMinima" Label="Desde la cantidad" Variant="Variant.Outlined" HideSpinButtons="true" />
                </MudItem>
            }
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal?" @bind-Value="_limite" Label="Límite de unidades por compra (opcional)" Variant="Variant.Outlined" HideSpinButtons="true" />
            </MudItem>

            <MudItem xs="12"><MudText Typo="Typo.subtitle1">Vigencia</MudText></MudItem>
            <MudItem xs="6" sm="3">
                <MudDatePicker @bind-Date="_desdeFecha" Label="Desde" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudTimePicker @bind-Time="_desdeHora" Label="Hora" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudDatePicker @bind-Date="_hastaFecha" Label="Hasta" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudTimePicker @bind-Time="_hastaHora" Label="Hora" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" Class="d-flex flex-wrap align-center gap-1">
                <MudText Typo="Typo.body2" Class="mr-2">Días:</MudText>
                @foreach (var (dia, nombre) in EtiquetasPromocion.Dias)
                {
                    <MudCheckBox T="bool" Value="@_dias.HasFlag(dia)" ValueChanged="@((bool marcado) => _dias = marcado ? _dias | dia : _dias & ~dia)"
                                 Label="@nombre" Color="Color.Secondary" Dense="true" />
                }
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSwitch T="bool" @bind-Value="_conHorario" Label="Solo en un horario" Color="Color.Secondary" />
            </MudItem>
            @if (_conHorario)
            {
                <MudItem xs="6" sm="4">
                    <MudTimePicker @bind-Time="_horaDesde" Label="De" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudTimePicker @bind-Time="_horaHasta" Label="A" Variant="Variant.Outlined" HelperText="Puede cruzar la medianoche." />
                </MudItem>
            }

            <MudItem xs="12"><MudText Typo="Typo.subtitle1">Alcance</MudText></MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int" @bind-SelectedValues="_departamentos" MultiSelection="true" Label="Departamentos" Variant="Variant.Outlined"
                           ToStringFunc="@(codigo => Departamentos.FirstOrDefault(f => f.Codigo == codigo)?.Nombre ?? string.Empty)">
                    @foreach (var departamento in Departamentos)
                    {
                        <MudSelectItem T="int" Value="@departamento.Codigo">@departamento.Codigo · @departamento.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int" @bind-SelectedValues="_categorias" MultiSelection="true" Label="Categorías" Variant="Variant.Outlined"
                           ToStringFunc="@(codigo => Categorias.FirstOrDefault(c => c.Codigo == codigo)?.Nombre ?? string.Empty)">
                    @foreach (var categoria in Categorias)
                    {
                        <MudSelectItem T="int" Value="@categoria.Codigo">@categoria.Codigo · @categoria.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int" @bind-SelectedValues="_marcas" MultiSelection="true" Label="Marcas" Variant="Variant.Outlined"
                           ToStringFunc="@(codigo => Marcas.FirstOrDefault(m => m.Codigo == codigo)?.Nombre ?? string.Empty)">
                    @foreach (var marca in Marcas)
                    {
                        <MudSelectItem T="int" Value="@marca.Codigo">@marca.Codigo · @marca.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-SelectedValues="_sucursales" MultiSelection="true" Label="Sucursales" Variant="Variant.Outlined" HelperText="Ninguna = todas."
                           ToStringFunc="@(codigo => Sucursales.FirstOrDefault(s => s.Codigo == codigo)?.Nombre ?? string.Empty)">
                    @foreach (var sucursal in Sucursales)
                    {
                        <MudSelectItem T="string" Value="@sucursal.Codigo">@sucursal.Codigo · @sucursal.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                @* Se digita el código y Enter lo busca y lo agrega de una vez; el foco vuelve aquí para seguir escaneando. *@
                <MudTextField @ref="_campoCodigo" @bind-Value="_codigoBuscado" Label="Código del artículo" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" OnKeyDown="AlTeclearCodigoAsync" Style="max-width: 280px" Disabled="_buscandoArticulo"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="BuscarYAgregarAsync"
                              AdornmentAriaLabel="Buscar y agregar" />
                @if (_errorArticulo is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_errorArticulo</MudAlert>
                }

                @* Lo último agregado va arriba, para ver que entró lo que se acaba de digitar. *@
                <MudTable T="ArticuloElegido" Items="_articulos" Dense="true" Hover="false" Elevation="0" Breakpoint="Breakpoint.None" Class="mt-2 cg-central__lineas">
                    <HeaderContent>
                        <MudTh>Código</MudTh>
                        <MudTh>Descripción</MudTh>
                        <MudTh Class="cg-numero">Precio antes</MudTh>
                        <MudTh Class="cg-numero">Precio después</MudTh>
                        <MudTh Style="width: 56px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Código">@context.Codigo</MudTd>
                        <MudTd DataLabel="Descripción">@context.Descripcion</MudTd>
                        <MudTd DataLabel="Precio antes" Class="cg-numero">@context.PrecioDetalle.ToString("N2")</MudTd>
                        <MudTd DataLabel="Precio después" Class="cg-numero">@(PrecioDespues(context.PrecioDetalle) is { } despues ? despues.ToString("N2") : "—")</MudTd>
                        <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => _articulos.Remove(context)" /></MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">Sin artículos agregados: digite el código y presione Enter, o use un departamento, categoría o marca.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="_soloFidelidad" Label="Solo miembros del programa de fidelidad" Color="Color.Secondary" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="_activa" Label="@(_activa ? "Activa" : "Inactiva")" Color="Color.Secondary" />
            </MudItem>

            @if (_mensaje is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@_mensaje</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_procesando" OnClick="GuardarAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private sealed record ArticuloElegido(string Codigo, string Descripcion, decimal PrecioDetalle);

    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter] public PromocionCarga? Promocion { get; set; }
    [Parameter] public IReadOnlyList<DepartamentoCarga> Departamentos { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoriaCarga> Categorias { get; set; } = [];
    [Parameter] public IReadOnlyList<MarcaCarga> Marcas { get; set; } = [];
    [Parameter] public IReadOnlyList<DatosSucursal> Sucursales { get; set; } = [];

    private readonly List<ArticuloElegido> _articulos = [];
    private string? _codigo;
    private string? _nombre;
    private TipoPromocion _tipo = TipoPromocion.Porcentaje;
    private decimal? _valor;
    private int? _lleva = 2;
    private int? _paga = 1;
    private decimal? _cantidadMinima;
    private decimal? _limite;
    private DateTime? _desdeFecha = DateTime.Today;
    private TimeSpan? _desdeHora = TimeSpan.Zero;
    private DateTime? _hastaFecha = DateTime.Today.AddDays(7);
    private TimeSpan? _hastaHora = new TimeSpan(23, 59, 0);
    private DiasSemana _dias = DiasSemana.Todos;
    private bool _conHorario;
    private TimeSpan? _horaDesde = new TimeSpan(8, 0, 0);
    private TimeSpan? _horaHasta = new TimeSpan(12, 0, 0);
    private IReadOnlyCollection<int> _departamentos = [];
    private IReadOnlyCollection<int> _categorias = [];
    private IReadOnlyCollection<int> _marcas = [];
    private IReadOnlyCollection<string> _sucursales = [];
    private string? _codigoBuscado;
    private MudTextField<string?>? _campoCodigo;
    private bool _buscandoArticulo;
    private string? _errorArticulo;
    private bool _soloFidelidad;
    private bool _activa = true;
    private string? _mensaje;
    private bool _procesando;

    protected override async Task OnInitializedAsync()
    {
        if (Promocion is not { } p)
            return;

        (_codigo, _nombre, _tipo, _valor, _limite) = (p.Codigo, p.Nombre, p.Tipo, p.Valor, p.LimitePorCliente);
        (_lleva, _paga, _cantidadMinima) = (p.CantidadLleva ?? 2, p.CantidadPaga ?? 1, p.CantidadMinima);
        var desde = p.VigenteDesde.ToLocalTime();
        var hasta = p.VigenteHasta.ToLocalTime();
        (_desdeFecha, _desdeHora, _hastaFecha, _hastaHora) = (desde.Date, desde.TimeOfDay, hasta.Date, hasta.TimeOfDay);
        _dias = p.Dias;
        _conHorario = p.HoraDesde is not null;
        if (p is { HoraDesde: { } horaDesde, HoraHasta: { } horaHasta })
            (_horaDesde, _horaHasta) = (horaDesde.ToTimeSpan(), horaHasta.ToTimeSpan());
        _departamentos = (p.Departamentos ?? []).ToHashSet();
        _categorias = (p.Categorias ?? []).ToHashSet();
        _marcas = (p.Marcas ?? []).ToHashSet();
        _sucursales = (p.Sucursales ?? []).ToHashSet();
        (_soloFidelidad, _activa) = (p.SoloFidelidad, p.Activa);

        var codigos = p.Articulos ?? [];
        var encontrados = (await Central.ArticulosPromocionAsync(codigos)).ToDictionary(a => a.Codigo);
        // El orden de _articulos es el de la pantalla (lo último arriba); como aquí no hay «orden de captura» que
        // respetar, se listan tal como vienen guardados.
        foreach (var codigo in codigos)
            _articulos.Add(encontrados.TryGetValue(codigo, out var a)
                ? new ArticuloElegido(a.Codigo, a.Descripcion, a.PrecioDetalle)
                : new ArticuloElegido(codigo, $"Artículo {codigo}", 0m));
    }

    /// <summary>El precio de la línea con la oferta ya aplicada, para una unidad; nulo si falta algún dato del tipo.</summary>
    private decimal? PrecioDespues(decimal precioDetalle) => _tipo switch
    {
        TipoPromocion.Porcentaje when _valor is { } valor => decimal.Round(precioDetalle * (1 - valor / 100m), 2, MidpointRounding.AwayFromZero),
        TipoPromocion.MontoPorUnidad when _valor is { } valor => Math.Max(0m, precioDetalle - valor),
        TipoPromocion.PrecioEspecial when _valor is { } valor => Math.Min(precioDetalle, valor),
        TipoPromocion.PrecioPorCantidad when _valor is { } valor => Math.Min(precioDetalle, valor),
        // Lleva X paga Y no tiene un precio por unidad propio: se muestra el equivalente al comprar sets completos.
        TipoPromocion.LlevaPaga when _lleva is > 0 and { } lleva && _paga is { } paga =>
            decimal.Round(precioDetalle * paga / lleva, 2, MidpointRounding.AwayFromZero),
        _ => null,
    };

    /// <summary>Enter en el código: busca el artículo (por código o código de barras) y lo agrega de una vez.</summary>
    private async Task AlTeclearCodigoAsync(KeyboardEventArgs tecla)
    {
        if (tecla.Key is "Enter" or "NumpadEnter")
            await BuscarYAgregarAsync();
    }

    private async Task BuscarYAgregarAsync()
    {
        var codigo = (_codigoBuscado ?? string.Empty).Trim();
        _errorArticulo = null;
        if (codigo.Length == 0)
            return;

        _buscandoArticulo = true;
        var articulo = await BuscarPorCodigoAsync(codigo);
        _buscandoArticulo = false;

        if (articulo is null)
            _errorArticulo = $"No se encontró el artículo '{codigo}'.";
        else if (_articulos.Any(a => a.Codigo == articulo.Codigo))
            _errorArticulo = $"El artículo {articulo.Codigo} ya está en la lista.";
        else
            _articulos.Insert(0, new ArticuloElegido(articulo.Codigo, articulo.Descripcion, articulo.PrecioDetalle));

        _codigoBuscado = null;
        await EnfocarAsync(_campoCodigo);
    }

    /// <summary>El artículo cuyo código (o código de barras) se digitó; nulo si no hay uno solo que coincida tal cual.</summary>
    private async Task<ArticuloCarga?> BuscarPorCodigoAsync(string codigo)
    {
        var pagina = await Central.BuscarArticulosAsync("promociones", codigo, 0, 20);
        var articulos = pagina?.Elementos.Select(e => e.Dato).ToList() ?? [];

        return articulos.FirstOrDefault(a => string.Equals(a.Codigo, codigo, StringComparison.OrdinalIgnoreCase))
               ?? articulos.FirstOrDefault(a => a.CodigosBarras?.Any(b => string.Equals(b, codigo, StringComparison.OrdinalIgnoreCase)) == true);
    }

    /// <summary>El foco vuelve solo al código, para seguir escaneando o digitando sin tocar el mouse.</summary>
    private static async Task EnfocarAsync(MudTextField<string?>? campo)
    {
        if (campo is { } destino)
            await destino.FocusAsync();
    }

    private async Task GuardarAsync()
    {
        var desde = EtiquetasPromocion.Momento(_desdeFecha, _desdeHora);
        var hasta = EtiquetasPromocion.Momento(_hastaFecha, _hastaHora);
        _mensaje = string.IsNullOrWhiteSpace(_nombre) ? "Indique el nombre."
            : EtiquetasPromocion.EtiquetaValor(_tipo) is not null && _valor is null ? "Indique el valor de la oferta."
            : desde is null || hasta is null ? "Indique desde y hasta cuándo rige."
            : _dias == DiasSemana.Ninguno ? "Elija al menos un día."
            : _articulos.Count == 0 && _departamentos.Count == 0 && _categorias.Count == 0 && _marcas.Count == 0
                ? "Agregue al menos un artículo, un departamento, una categoría o una marca."
            : null;
        if (_mensaje is not null)
            return;

        // Nueva: va sin código y el Central le da el siguiente de la secuencia.
        var promocion = new PromocionCarga(
            Promocion is null ? string.Empty : _codigo!.Trim(),
            _nombre!.Trim(),
            _tipo,
            _tipo == TipoPromocion.LlevaPaga ? 0m : _valor!.Value,
            desde!.Value,
            hasta!.Value,
            _articulos.Select(a => a.Codigo).ToList(),
            _departamentos.ToList(),
            _sucursales.ToList(),
            _tipo == TipoPromocion.LlevaPaga ? _lleva : null,
            _tipo == TipoPromocion.LlevaPaga ? _paga : null,
            _tipo == TipoPromocion.PrecioPorCantidad ? _cantidadMinima : null,
            _limite,
            _dias,
            _conHorario && _horaDesde is { } horaDesde ? TimeOnly.FromTimeSpan(horaDesde) : null,
            _conHorario && _horaHasta is { } horaHasta ? TimeOnly.FromTimeSpan(horaHasta) : null,
            _soloFidelidad,
            _activa,
            _categorias.ToList(),
            _marcas.ToList());

        _procesando = true;
        var respuesta = await Central.GuardarPromocionAsync(promocion, nueva: Promocion is null);
        _procesando = false;

        if (respuesta.Exitosa)
            Dialogo.Close(DialogResult.Ok(true));
        else
            _mensaje = respuesta.Mensaje ?? "No se pudo guardar la promoción.";
    }
}
