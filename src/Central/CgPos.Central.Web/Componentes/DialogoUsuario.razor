@* Alta o edición de un usuario del Central. El usuario (código) no cambia; la contraseña temporal solo se pide al crearlo. *@
@inject ClienteCentral Cliente

<MudDialog>
    <DialogContent>
        <div class="cg-central__dialogo">
            <MudTextField T="string" @bind-Value="_codigo" Label="Usuario" Variant="Variant.Outlined" Disabled="@(Usuario is not null)"
                          HelperText="Con este nombre ingresa al Central." />
            <MudTextField T="string" @bind-Value="_nombre" Label="Nombre completo" Variant="Variant.Outlined" />
            <MudTextField T="string" @bind-Value="_correo" Label="Correo (opcional)" Variant="Variant.Outlined" InputType="InputType.Email" />
            <MudSelect T="Guid?" @bind-Value="_rolId" Label="Rol" Placeholder="Seleccione el rol" Variant="Variant.Outlined" ToStringFunc="NombreRol">
                @foreach (var rol in Roles.Where(r => r.Activo || r.Id == Usuario?.RolId))
                {
                    <MudSelectItem T="Guid?" Value="@rol.Id">@rol.Nombre</MudSelectItem>
                }
            </MudSelect>
            @if (Usuario is null)
            {
                <MudTextField T="string" @bind-Value="_contrasena" Label="Contraseña temporal" Variant="Variant.Outlined" InputType="InputType.Password"
                              HelperText="El usuario deberá cambiarla al primer ingreso." />
            }
            @if (_mensaje is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_mensaje</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="_procesando" OnClick="GuardarAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter] public DatosUsuarioCentral? Usuario { get; set; }
    [Parameter] public IReadOnlyList<DatosRolCentral> Roles { get; set; } = [];

    private string? _codigo;
    private string? _nombre;
    private string? _correo;
    private string? _contrasena;
    private Guid? _rolId;
    private string? _mensaje;
    private bool _procesando;

    private string NombreRol(Guid? rolId) => Roles.FirstOrDefault(r => r.Id == rolId)?.Nombre ?? string.Empty;

    protected override void OnInitialized()
    {
        if (Usuario is not { } usuario)
            return;

        _codigo = usuario.Codigo;
        _nombre = usuario.Nombre;
        _correo = usuario.Correo;
        _rolId = usuario.RolId;
    }

    private async Task GuardarAsync()
    {
        if (_rolId is not { } rolId)
        {
            _mensaje = "Seleccione el rol del usuario.";
            return;
        }

        _procesando = true;
        _mensaje = null;
        var respuesta = Usuario is null
            ? await Cliente.CrearUsuarioAsync(new SolicitudUsuarioCentral(_codigo ?? string.Empty, _nombre ?? string.Empty, _correo, rolId, _contrasena ?? string.Empty))
            : await Cliente.ActualizarUsuarioAsync(Usuario.Id, new SolicitudActualizarUsuarioCentral(_nombre ?? string.Empty, _correo, rolId));
        _procesando = false;

        if (respuesta.Exitosa)
            Dialogo.Close(DialogResult.Ok(true));
        else
            _mensaje = respuesta.Mensaje ?? "No se pudo guardar el usuario.";
    }
}
