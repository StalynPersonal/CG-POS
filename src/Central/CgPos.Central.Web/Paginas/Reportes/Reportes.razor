@page "/reportes"
@attribute [Authorize(Policy = CatalogoPermisosCentral.ConsultarReportes)]
@inject ClienteCentral Cliente
@inject IJSRuntime Js
@inject ISnackbar Avisos

<PageTitle>Reportes · CG-POS Central</PageTitle>

<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">Reportes</MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">
            Ventas, ITBIS, formato 607, cuadres, e-CF y sincronización, con lo que informan todas las cajas. Se exportan a Excel y PDF.
        </MudText>
    </div>
</div>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <div class="d-flex gap-3 flex-wrap align-center">
        <MudSelect T="TipoReporteCentral" Value="_tipo" ValueChanged="CambiarTipoAsync" Label="Reporte" Dense="true" Style="min-width: 220px">
            @foreach (var tipo in Enum.GetValues<TipoReporteCentral>())
            {
                <MudSelectItem T="TipoReporteCentral" Value="@tipo">@Etiqueta(tipo)</MudSelectItem>
            }
        </MudSelect>
        <MudDatePicker @bind-Date="_desde" Label="Desde" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Style="max-width: 170px" />
        <MudDatePicker @bind-Date="_hasta" Label="Hasta" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Style="max-width: 170px" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="_cargando" OnClick="GenerarAsync">
            Generar
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.GridOn" Disabled="_tabla is null"
                   OnClick='() => DescargarAsync("excel")'>Excel</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" Disabled="_tabla is null"
                   OnClick='() => DescargarAsync("pdf")'>PDF</MudButton>
        @if (_tipo == TipoReporteCentral.Formato607)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Description" Disabled="_tabla is null"
                       OnClick='() => DescargarAsync("607")'>Archivo 607</MudButton>
        }
    </div>
</MudPaper>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudo generar el reporte. Verifique la comunicación con el Central.</MudAlert>
}

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

@if (_tabla is { } tabla)
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6">@tabla.Titulo</MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo mb-3">@tabla.Subtitulo</MudText>

        @if (tabla.Filas.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No hay datos en el período seleccionado.</MudAlert>
        }
        else
        {
            <div style="overflow-x: auto">
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            @for (var columna = 0; columna < tabla.Columnas.Count; columna++)
                            {
                                <th style="@Estilo(tabla, columna)">@tabla.Columnas[columna]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in tabla.Filas)
                        {
                            <tr>
                                @for (var columna = 0; columna < fila.Count; columna++)
                                {
                                    <td style="@Estilo(tabla, columna)">@fila[columna]</td>
                                }
                            </tr>
                        }
                    </tbody>
                    @if (tabla.Totales is { } totales)
                    {
                        <tfoot>
                            <tr>
                                @for (var columna = 0; columna < totales.Count; columna++)
                                {
                                    <td style="@Estilo(tabla, columna)"><strong>@totales[columna]</strong></td>
                                }
                            </tr>
                        </tfoot>
                    }
                </MudSimpleTable>
            </div>
        }
    </MudPaper>
}

@code {
    private TipoReporteCentral _tipo = TipoReporteCentral.Ventas;
    private DateTime? _desde = DateTime.Today.AddDays(1 - DateTime.Today.Day);
    private DateTime? _hasta = DateTime.Today;
    private TablaReporte? _tabla;
    private bool _cargando;
    private bool _error;

    private static string Etiqueta(TipoReporteCentral tipo) => tipo switch
    {
        TipoReporteCentral.Itbis => "ITBIS por tasa",
        TipoReporteCentral.Formato607 => "Formato 607 (DGII)",
        TipoReporteCentral.Cuadres => "Cuadres de caja",
        TipoReporteCentral.Ecf => "e-CF y DGII",
        TipoReporteCentral.Sincronizacion => "Sincronización",
        _ => "Ventas",
    };

    private static string Estilo(TablaReporte tabla, int columna) =>
        columna < tabla.Alineaciones.Count && tabla.Alineaciones[columna] ? "text-align: right; white-space: nowrap" : "white-space: nowrap";

    protected override Task OnInitializedAsync() => GenerarAsync();

    private Task CambiarTipoAsync(TipoReporteCentral tipo)
    {
        _tipo = tipo;
        return GenerarAsync();
    }

    private async Task GenerarAsync()
    {
        if (_desde is not { } desde || _hasta is not { } hasta)
            return;

        _cargando = true;
        _tabla = await Cliente.ReporteAsync(_tipo, DateOnly.FromDateTime(desde), DateOnly.FromDateTime(hasta), null);
        _error = _tabla is null;
        _cargando = false;
    }

    private async Task DescargarAsync(string formato)
    {
        if (_desde is not { } desde || _hasta is not { } hasta)
            return;

        var archivo = await Cliente.DescargarReporteAsync(_tipo, formato, DateOnly.FromDateTime(desde), DateOnly.FromDateTime(hasta), null);
        if (archivo is not { } generado)
        {
            Avisos.Add("No se pudo generar el archivo del reporte.", Severity.Error);
            return;
        }

        await Js.InvokeVoidAsync("cgCentral.descargarArchivo", generado.Nombre, generado.TipoContenido, Convert.ToBase64String(generado.Contenido));
    }
}
