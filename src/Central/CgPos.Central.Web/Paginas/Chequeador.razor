@page "/chequeador"
@page "/chequeador/{Sucursal}"
@layout DisenoIngreso
@using CgPos.Contratos.Serializacion
@using System.Net.Http.Json
@inject IHttpClientFactory FabricaHttp
@inject IJSRuntime Js

<PageTitle>Chequeador de precios · CG-POS</PageTitle>

@* Pantalla del chequeador de la tienda: el cliente escanea y ve descripción, precio y ofertas. No pide sesión. *@
<div class="cg-chequeador">
    @* Encabezado con la instrucción para el cliente y la sucursal en la que está el equipo. *@
    <div class="cg-chequeador__encabezado">
        <MudText Typo="Typo.h3">Consulte su precio</MudText>
        <MudText Typo="Typo.h6">Pase el código de barras del producto por el lector</MudText>
        @* La sucursal viene en la dirección del equipo (…/chequeador/01), así el cliente no tiene que elegirla. El
           selector solo aparece si el equipo no la trae y hay más de una: es para que tecnología la ajuste. *@
        @if (_sucursalId is not null && _nombreSucursal is { Length: > 0 })
        {
            <MudText Typo="Typo.subtitle1" Class="cg-chequeador__sucursal">@_nombreSucursal</MudText>
        }
        else if (_sucursales.Count > 1)
        {
            <MudSelect T="int?" @bind-Value="_sucursalId" Label="Sucursal" Dense="true" Variant="Variant.Outlined" Style="max-width: 280px">
                @foreach (var sucursal in _sucursales)
                {
                    <MudSelectItem T="int?" Value="@sucursal.Id">@sucursal.Codigo · @sucursal.Nombre</MudSelectItem>
                }
            </MudSelect>
        }
    </div>

    @* Campo de escaneo: siempre enfocado, para que el lector escriba aquí sin tocar nada. *@
    <div class="cg-chequeador__escaneo">
        <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="Size.Large" />
        <input @ref="_campo" class="cg-chequeador__campo" autocomplete="off" spellcheck="false" placeholder="Código del producto"
               value="@_entrada" @oninput="evento => _entrada = evento.Value?.ToString() ?? string.Empty" @onkeydown="AlTeclearAsync" />
    </div>

    @if (!_habilitado)
    {
        @* El chequeador está apagado en el Central: se avisa sin consultar nada. *@
        <div class="cg-chequeador__aviso">
            <MudAlert Severity="Severity.Warning">El chequeador de precios está apagado. Actívelo en el Central (Central.Chequeador.Habilitado).</MudAlert>
        </div>
    }
    else if (_articulo is { } articulo)
    {
        @* Resultado de la consulta: lo que el cliente necesita ver de lejos. *@
        <div class="cg-chequeador__resultado">
            <MudText Typo="Typo.h4" Class="cg-chequeador__descripcion">@articulo.Descripcion</MudText>
            <MudText Typo="Typo.body1">@articulo.Codigo · @articulo.UnidadMedida</MudText>
            <div class="cg-chequeador__precio">@articulo.Precio.ToString("C2")</div>

            @if (articulo is { PrecioMayor: { } mayor, CantidadMinimaMayor: { } minima })
            {
                @* Precio por cantidad: se le dice desde cuántas unidades aplica. *@
                <div class="cg-chequeador__mayor">Llevando @minima.ToString("0.##") o más: @mayor.ToString("C2") cada uno</div>
            }

            @foreach (var oferta in articulo.Ofertas)
            {
                @* Oferta vigente que alcanza al artículo, con hasta cuándo dura. *@
                <div class="cg-chequeador__oferta">
                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" />
                    <span>@oferta.Descripcion · @oferta.Nombre</span>
                    <span class="cg-chequeador__vigencia">hasta el @oferta.VigenteHasta.ToString("dd/MM/yyyy")</span>
                </div>
            }
        </div>
    }
    else if (_mensaje is { } mensaje)
    {
        @* Código que no existe o Central que no responde. *@
        <div class="cg-chequeador__aviso">
            <MudAlert Severity="Severity.Info">@mensaje</MudAlert>
        </div>
    }
</div>

@code {
    private static readonly TimeSpan TiempoEnPantalla = TimeSpan.FromSeconds(20);

    private readonly List<DatosSucursalChequeador> _sucursales = [];
    private ElementReference _campo;
    private DatosPrecioChequeador? _articulo;
    private string _entrada = string.Empty;
    private string? _mensaje;
    /// <summary>Código de la sucursal en la que está este equipo, tomado de la dirección (…/chequeador/01).</summary>
    [Parameter] public string? Sucursal { get; set; }

    private int? _sucursalId;
    private string? _nombreSucursal;
    private bool _habilitado = true;
    private CancellationTokenSource? _limpieza;

    // El chequeador no tiene sesión: usa el cliente sin token.
    private HttpClient Http => FabricaHttp.CreateClient(ServicioSesionCentral.NombreHttpSinSesion);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var configuracion = await Http.GetFromJsonAsync<DatosConfiguracionChequeador>("api/chequeador/configuracion", OpcionesJson.Predeterminadas);
            _habilitado = configuracion?.Habilitado ?? false;
            _sucursales.AddRange(configuracion?.Sucursales ?? []);

            // La sucursal de la dirección manda; si no viene y hay una sola, se toma esa.
            var deLaDireccion = Sucursal is { Length: > 0 } codigo
                ? _sucursales.FirstOrDefault(s => string.Equals(s.Codigo, codigo.Trim().PadLeft(2, '0'), StringComparison.Ordinal))
                : null;

            var elegida = deLaDireccion ?? (_sucursales.Count == 1 ? _sucursales[0] : null);
            _sucursalId = elegida?.Id;
            _nombreSucursal = elegida?.Nombre;
        }
        catch (HttpRequestException)
        {
            _habilitado = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        // El lector escribe en el campo enfocado: el foco vuelve solo después de cada consulta.
        await _campo.FocusAsync();
    }

    private async Task AlTeclearAsync(KeyboardEventArgs evento)
    {
        if (evento.Key is not ("Enter" or "NumpadEnter"))
            return;

        var codigo = _entrada.Trim();
        _entrada = string.Empty;
        if (codigo.Length == 0 || !_habilitado)
            return;

        await ConsultarAsync(codigo);
    }

    private async Task ConsultarAsync(string codigo)
    {
        var ruta = $"api/chequeador/articulos/{Uri.EscapeDataString(codigo)}" + (_sucursalId is { } sucursal ? $"?sucursalId={sucursal}" : string.Empty);
        try
        {
            using var respuesta = await Http.GetAsync(ruta);
            if (respuesta.IsSuccessStatusCode)
            {
                _articulo = await respuesta.Content.ReadFromJsonAsync<DatosPrecioChequeador>(OpcionesJson.Predeterminadas);
                _mensaje = null;
            }
            else
            {
                _articulo = null;
                _mensaje = $"No encontramos el producto {codigo}. Pregunte a un colaborador.";
            }
        }
        catch (Exception excepcion) when (excepcion is HttpRequestException or System.Text.Json.JsonException)
        {
            _articulo = null;
            _mensaje = "No hay comunicación con el sistema. Intente de nuevo en un momento.";
        }

        await LimpiarLuegoAsync();
    }

    /// <summary>La consulta se borra sola para que la siguiente persona encuentre la pantalla en blanco.</summary>
    private async Task LimpiarLuegoAsync()
    {
        _limpieza?.Cancel();
        _limpieza?.Dispose();
        _limpieza = new CancellationTokenSource();
        var cancelacion = _limpieza.Token;

        try
        {
            await Task.Delay(TiempoEnPantalla, cancelacion);
            _articulo = null;
            _mensaje = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // Llegó otra consulta antes: esa maneja su propio tiempo.
        }
    }
}
