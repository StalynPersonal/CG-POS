@page "/articulos"
@attribute [Authorize(Policy = CatalogoPermisosCentral.AdministrarMaestros)]
@using CgPos.Contratos.Catalogo
@using CgPos.Contratos.Central
@inject ClienteCentral Cliente
@inject IDialogService Dialogos
@inject ISnackbar Avisos

<PageTitle>Artículos · CG-POS Central</PageTitle>

<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">Artículos</MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">Datos, códigos y presentación en la caja. Los precios de un artículo existente se cambian en Precios.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => AbrirDialogoAsync(null)">Nuevo artículo</MudButton>
</div>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar los artículos. Verifique la comunicación con el Central.</MudAlert>
}

<MudPaper Elevation="1">
    <MudTable @ref="_tabla" T="DatosMaestroCentral<ArticuloCarga>" ServerData="CargarAsync" Hover="true" Class="cg-central__tabla" Breakpoint="Breakpoint.Sm"
              Elevation="0" RowsPerPage="10">
        <ToolBarContent>
            @* Dónde buscar: la descripción va por parecido y el código tiene que escribirse completo. *@
            <div class="d-flex gap-2 align-center">
                <MudSelect T="string" Value="_campo" ValueChanged="CambiarCampoAsync" Label="Buscar por" Dense="true" Margin="Margin.Dense"
                           Style="width: 200px">
                    <MudSelectItem T="string" Value="@CamposBusquedaArticulo.Descripcion">Descripción</MudSelectItem>
                    <MudSelectItem T="string" Value="@CamposBusquedaArticulo.Codigo">Código</MudSelectItem>
                </MudSelect>
                <MudTextField T="string" Value="_buscar" ValueChanged="BuscarAsync" DebounceInterval="400" Placeholder="@Placeholder"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Style="width: 380px" />

                @* El tipo acota además de lo que se busque: «alambre» entre los pesados es las dos cosas. *@
                <MudSelect T="string" Value="_tipo" ValueChanged="CambiarTipoAsync" Label="Tipo" Dense="true" Margin="Margin.Dense" Clearable="true"
                           Style="width: 170px">
                    <MudSelectItem T="string" Value="@(null as string)">Todos</MudSelectItem>
                    @foreach (var tipo in EtiquetasArticulo.Tipos)
                    {
                        <MudSelectItem T="string" Value="@tipo.ToString()">@EtiquetasArticulo.Tipo(tipo)</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Descripción</MudTh>
            <MudTh>Departamento</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh Style="text-align: right">Detalle</MudTh>
            <MudTh Style="text-align: right">Mayor</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Modificado</MudTh>
            <MudTh Style="width: 56px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Código"><strong>@context.Dato.Codigo</strong></MudTd>
            <MudTd DataLabel="Descripción">
                @context.Dato.Descripcion
                @if ((context.Dato.CodigosBarras?.Count ?? 0) > 0)
                {
                    <div class="cg-central__detalle">@string.Join(", ", context.Dato.CodigosBarras!)</div>
                }
            </MudTd>
            <MudTd DataLabel="Departamento">
                @NombreDepartamento(context.Dato.DepartamentoCodigo)
                @if (Clasificacion(context.Dato) is { Length: > 0 } detalle)
                {
                    <div class="cg-central__detalle">@detalle</div>
                }
            </MudTd>
            <MudTd DataLabel="Tipo">@EtiquetasArticulo.Tipo(context.Dato.Tipo)</MudTd>
            <MudTd DataLabel="Detalle" Style="text-align: right">@context.Dato.PrecioDetalle.ToString("N2")</MudTd>
            <MudTd DataLabel="Mayor" Style="text-align: right">@context.Dato.PrecioMayor?.ToString("N2")</MudTd>
            <MudTd DataLabel="Estado">
                @if (context.Dato.Activo)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Activo</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Inactivo</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Modificado">
                <div>@context.ModificadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                <div class="cg-central__detalle">@context.ModificadoPor</div>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => AbrirDialogoAsync(context.Dato)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay artículos que coincidan.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página:" InfoFormat="{first_item}-{last_item} de {all_items}" PageSizeOptions="new[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<DatosMaestroCentral<ArticuloCarga>>? _tabla;
    private ReferenciasArticulo _referencias = ReferenciasArticulo.Vacias;
    private string? _buscar;
    private bool _error;

    protected override async Task OnInitializedAsync() => _referencias = await ReferenciasArticulo.CargarAsync(Cliente);

    private string NombreDepartamento(int departamento) => _referencias.Departamentos.FirstOrDefault(f => f.Codigo == departamento)?.Nombre ?? string.Empty;

    /// <summary>Categoría y marca debajo del departamento.</summary>
    private string Clasificacion(ArticuloCarga articulo) => string.Join(" · ", new[]
    {
        _referencias.Categorias.FirstOrDefault(c => c.Codigo == articulo.CategoriaCodigo)?.Nombre,
        _referencias.Marcas.FirstOrDefault(m => m.Codigo == articulo.MarcaCodigo)?.Nombre,
    }.Where(texto => !string.IsNullOrEmpty(texto)));

    private async Task<TableData<DatosMaestroCentral<ArticuloCarga>>> CargarAsync(TableState estado, CancellationToken cancelacion)
    {
        var pagina = await Cliente.BuscarArticulosAsync("maestros", _buscar, estado.Page, estado.PageSize, cancelacion, _campo, _tipo);
        _error = pagina is null;
        return new TableData<DatosMaestroCentral<ArticuloCarga>> { Items = pagina?.Elementos ?? [], TotalItems = pagina?.Total ?? 0 };
    }

    /// <summary>Dónde se busca. Se arranca por código, que es con lo que se llega a un artículo concreto.</summary>
    private string _campo = CamposBusquedaArticulo.Codigo;

    /// <summary>Tipo por el que se acota; vacío son todos.</summary>
    private string? _tipo;

    private string Placeholder => _campo == CamposBusquedaArticulo.Codigo
        ? "Código interno, de barras o de proveedor, completo"
        : "Parte de la descripción";

    /// <summary>Al cambiar de campo se vuelve a buscar, para no dejar en pantalla el resultado del anterior.</summary>
    private Task CambiarCampoAsync(string campo)
    {
        _campo = campo;
        return _tabla?.ReloadServerData() ?? Task.CompletedTask;
    }

    /// <summary>Al cambiar el tipo se vuelve a buscar, y se vuelve a la primera página.</summary>
    private Task CambiarTipoAsync(string? tipo)
    {
        _tipo = tipo;
        return _tabla?.ReloadServerData() ?? Task.CompletedTask;
    }

    private Task BuscarAsync(string? texto)
    {
        _buscar = texto;
        return _tabla?.ReloadServerData() ?? Task.CompletedTask;
    }

    private async Task AbrirDialogoAsync(ArticuloCarga? articulo)
    {
        var parametros = new DialogParameters<DialogoArticulo> { { d => d.Articulo, articulo }, { d => d.Referencias, _referencias } };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var referencia = await Dialogos.ShowAsync<DialogoArticulo>(articulo is null ? "Nuevo artículo" : $"Editar artículo {articulo.Codigo}", parametros, opciones);
        if (await referencia.Result is not { Canceled: false })
            return;

        Avisos.Add(articulo is null ? "Artículo creado." : "Artículo actualizado.", Severity.Success);
        await (_tabla?.ReloadServerData() ?? Task.CompletedTask);
    }
}
