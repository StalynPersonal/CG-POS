@page "/"
@attribute [Authorize]
@inject AlmacenSesionCentral Almacen

<PageTitle>Inicio · CG-POS Central</PageTitle>

<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">Hola, @Almacen.Sesion?.Nombre</MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">@Almacen.Sesion?.RolNombre · CG-POS Central</MudText>
    </div>
</div>

<div class="cg-central__tarjetas">
    <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarOrganizacion">
        <MudPaper Elevation="1" Class="cg-central__tarjeta">
            <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Sucursales y cajas</MudText>
            <MudText Typo="Typo.body2" Class="cg-central__subtitulo">Alta de sucursales y cajas, habilitación y credenciales para conectarse al Central.</MudText>
            <MudButton Href="organizacion/cajas" Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.ArrowForward">Administrar</MudButton>
        </MudPaper>
        <MudPaper Elevation="1" Class="cg-central__tarjeta">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Parámetros</MudText>
            <MudText Typo="Typo.body2" Class="cg-central__subtitulo">Reglas de negocio de las cajas y del Central, generales o por sucursal y caja.</MudText>
            <MudButton Href="organizacion/parametros" Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.ArrowForward">Configurar</MudButton>
        </MudPaper>
    </AuthorizeView>
    <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarMaestros">
        <MudPaper Elevation="1" Class="cg-central__tarjeta">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Catálogos</MudText>
            <MudText Typo="Typo.body2" Class="cg-central__subtitulo">Monedas, familias, impuestos, formas de pago y demás maestros que usan las cajas.</MudText>
            <MudButton Href="maestros" Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.ArrowForward">Administrar</MudButton>
        </MudPaper>
        <MudPaper Elevation="1" Class="cg-central__tarjeta">
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Artículos</MudText>
            <MudText Typo="Typo.body2" Class="cg-central__subtitulo">Datos, familia, impuesto, códigos de barras y presentación en la caja.</MudText>
            <MudButton Href="articulos" Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.ArrowForward">Administrar</MudButton>
        </MudPaper>
    </AuthorizeView>
    <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarPrecios">
        <MudPaper Elevation="1" Class="cg-central__tarjeta">
            <MudIcon Icon="@Icons.Material.Filled.Sell" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Precios y topes</MudText>
            <MudText Typo="Typo.body2" Class="cg-central__subtitulo">Precios detalle, por mayor y mínimo con vigencia, y topes de descuento por nivel.</MudText>
            <MudButton Href="precios/articulos" Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.ArrowForward">Administrar</MudButton>
        </MudPaper>
    </AuthorizeView>
    <AuthorizeView Policy="@CatalogoPermisosCentral.AdministrarSeguridad">
        <MudPaper Elevation="1" Class="cg-central__tarjeta">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Usuarios del Central</MudText>
            <MudText Typo="Typo.body2" Class="cg-central__subtitulo">Altas, roles, contraseñas temporales, bloqueos y desactivaciones.</MudText>
            <MudButton Href="seguridad/usuarios" Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.ArrowForward">Administrar</MudButton>
        </MudPaper>
        <MudPaper Elevation="1" Class="cg-central__tarjeta">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Roles y permisos</MudText>
            <MudText Typo="Typo.body2" Class="cg-central__subtitulo">Qué puede hacer cada rol en el Central Manager.</MudText>
            <MudButton Href="seguridad/roles" Variant="Variant.Text" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.ArrowForward">Administrar</MudButton>
        </MudPaper>
    </AuthorizeView>
</div>
