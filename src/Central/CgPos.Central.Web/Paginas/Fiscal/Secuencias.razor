@page "/fiscal/secuencias"
@attribute [Authorize(Policy = CatalogoPermisosCentral.AdministrarFiscal)]
@using CgPos.Dominio.Fiscal
@using CgPos.Dominio.Ventas
@inject ClienteCentral Cliente
@inject IDialogService Dialogos
@inject ISnackbar Avisos

<PageTitle>Rangos de e-CF · CG-POS Central</PageTitle>

<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">Rangos de e-CF</MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">
            Secuencias de la DGII por caja. No se solapan, solo se amplían o prorrogan y bajan en la próxima sincronización.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="() => AbrirDialogoAsync(null)">
        Asignar rango
    </MudButton>
</div>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar los rangos. Verifique la comunicación con el Central.</MudAlert>
}

@* Filtros: al elegir una sucursal, la lista de cajas se reduce a las suyas. *@
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudGrid Spacing="2" Justify="Justify.FlexStart">
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="int?" Value="_sucursalId" ValueChanged="CambiarSucursalAsync" Label="Sucursal" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">Todas</MudSelectItem>
                @foreach (var sucursal in Sucursales)
                {
                    <MudSelectItem T="int?" Value="@sucursal.Id">@sucursal.Codigo · @sucursal.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="int?" @bind-Value="_cajaId" @bind-Value:after="Filtrar" Label="Caja" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">Todas</MudSelectItem>
                @foreach (var caja in CajasDeLaSucursal)
                {
                    <MudSelectItem T="int?" Value="@caja.Id">@caja.Codigo · @caja.Nombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="TipoComprobante?" @bind-Value="_tipo" @bind-Value:after="Filtrar" Label="Comprobante" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true">
                <MudSelectItem T="TipoComprobante?" Value="@((TipoComprobante?)null)">Todos</MudSelectItem>
                @foreach (var tipo in Tipos)
                {
                    <MudSelectItem T="TipoComprobante?" Value="@tipo">@(((int)tipo).ToString("00")) · @ReglasComprobante.Nombre(tipo)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="12" md="3" Class="d-flex align-center">
            <MudCheckBox T="bool" @bind-Value="_soloActivos" @bind-Value:after="Filtrar" Label="Solo activos" Color="Color.Primary" Dense="true" />
            <MudSpacer />
            <MudText Typo="Typo.body2" Class="cg-central__detalle">@_filtradas.Count de @_secuencias.Count</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1">
    <MudTable T="DatosSecuenciaEcfCentral" Items="_filtradas" Hover="true" Loading="_cargando" Class="cg-central__tabla" Breakpoint="Breakpoint.Sm" Elevation="0" RowsPerPage="10">
        <HeaderContent>
            <MudTh>Caja</MudTh>
            <MudTh>Comprobante</MudTh>
            <MudTh>Rango</MudTh>
            <MudTh>Próximo</MudTh>
            <MudTh>Usado</MudTh>
            <MudTh>Vence</MudTh>
            <MudTh>Asignado</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh Style="width: 96px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Caja"><strong>@context.CajaCodigo</strong><div class="cg-central__detalle">Sucursal @context.SucursalCodigo</div></MudTd>
            <MudTd DataLabel="Comprobante">
                @context.Serie@(((int)context.TipoComprobante).ToString("00")) · @ReglasComprobante.Nombre(context.TipoComprobante)
            </MudTd>
            <MudTd DataLabel="Rango">
                @context.Desde.ToString("N0") – @context.Hasta.ToString("N0")
                <div class="cg-central__detalle">@((context.Hasta - context.Desde + 1).ToString("N0")) números</div>
            </MudTd>
            @* El número completo, tal como saldrá en la próxima factura de esa caja. *@
            <MudTd DataLabel="Próximo">
                <strong>@SecuenciaEcf.FormatearEncf(context.TipoComprobante, context.Proximo, context.Serie)</strong>
                <div class="cg-central__detalle">@context.Proximo.ToString("N0")</div>
            </MudTd>
            <MudTd DataLabel="Usado">
                @if (context.UltimoRecibido is { } ultimo)
                {
                    <div>Hasta @ultimo.ToString("N0")</div>
                    <div class="cg-central__detalle">Quedan @((context.Hasta - ultimo).ToString("N0"))</div>
                }
                else
                {
                    <span class="cg-central__detalle">Sin e-CF recibidos</span>
                }
            </MudTd>
            <MudTd DataLabel="Vence">
                @context.VenceEn.ToString("dd/MM/yyyy")
                @if (context.VenceEn < Hoy)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Vencido</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Asignado">
                @context.AsignadoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                <div class="cg-central__detalle">@context.AsignadoPor</div>
            </MudTd>
            <MudTd DataLabel="Estado">
                @if (context.Activa)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Activo</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Inactivo</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => AbrirDialogoAsync(context)" />
                @if (!context.Activa || context.VenceEn < Hoy)
                {
                    <MudTooltip Text="Anular en la DGII los números que no se usaron">
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" OnClick="() => AnularAsync(context)" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@(_secuencias.Count == 0 ? "No hay rangos asignados." : "Ningún rango coincide con los filtros.")</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" RowsPerPageString="Filas por página:" />
        </PagerContent>
    </MudTable>
</MudPaper>

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Anulaciones de e-NCF</MudText>
<MudText Typo="Typo.body2" Class="cg-central__subtitulo mb-2">
    Números que la DGII da por no utilizados. Solo se anulan en rangos desactivados o vencidos, que la caja ya no usa.
</MudText>
<MudPaper Elevation="1">
    <MudTable T="DatosAnulacionEcf" Items="_anulaciones" Hover="true" Loading="_cargando" Class="cg-central__tabla" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Caja</MudTh>
            <MudTh>Comprobante</MudTh>
            <MudTh>Tramo</MudTh>
            <MudTh>Motivo</MudTh>
            <MudTh>Resultado</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fecha">@context.SolicitadaEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<div class="cg-central__detalle">@context.UsuarioNombre</div></MudTd>
            <MudTd DataLabel="Caja"><strong>@context.CajaCodigo</strong><div class="cg-central__detalle">Sucursal @context.SucursalCodigo</div></MudTd>
            <MudTd DataLabel="Comprobante">@(((int)context.TipoComprobante).ToString("00")) · @ReglasComprobante.Nombre(context.TipoComprobante)</MudTd>
            <MudTd DataLabel="Tramo" Class="cg-numero">@context.Desde.ToString("N0") – @context.Hasta.ToString("N0")<div class="cg-central__detalle">@context.Cantidad.ToString("N0") números</div></MudTd>
            <MudTd DataLabel="Motivo">@context.Motivo</MudTd>
            <MudTd DataLabel="Resultado">
                <MudChip T="string" Size="Size.Small" Color="@ColorEstado(context.Estado)">@context.Estado</MudChip>
                @if (context.Estado != EstadoAnulacionEcf.Aceptada && context.RespuestaDgii is { } respuesta)
                {
                    <div class="cg-central__detalle">@respuesta</div>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No se han anulado e-NCF.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private IReadOnlyList<DatosSecuenciaEcfCentral> _secuencias = [];
    private IReadOnlyList<DatosCaja> _cajas = [];
    private IReadOnlyList<DatosAnulacionEcf> _anulaciones = [];
    private List<DatosSecuenciaEcfCentral> _filtradas = [];
    private int? _sucursalId;
    private int? _cajaId;
    private TipoComprobante? _tipo;
    private bool _soloActivos;
    private bool _cargando = true;
    private bool _error;

    /// <summary>Las sucursales que tienen caja: salen del maestro de cajas, sin pedir otra lista.</summary>
    private IEnumerable<(int Id, string Codigo, string Nombre)> Sucursales => _cajas
        .GroupBy(c => c.SucursalId)
        .Select(g => (Id: g.Key, g.First().SucursalCodigo, Nombre: g.First().SucursalNombre))
        .OrderBy(s => s.SucursalCodigo)
        .Select(s => (s.Id, s.SucursalCodigo, s.Nombre));

    /// <summary>Solo las cajas de la sucursal elegida; todas mientras no se elija ninguna.</summary>
    private IEnumerable<DatosCaja> CajasDeLaSucursal => _cajas
        .Where(c => _sucursalId is not { } sucursal || c.SucursalId == sucursal)
        .OrderBy(c => c.SucursalCodigo).ThenBy(c => c.Codigo);

    /// <summary>Los tipos de comprobante que de verdad tienen rangos asignados.</summary>
    private IEnumerable<TipoComprobante> Tipos => _secuencias.Select(s => s.TipoComprobante).Distinct().OrderBy(t => (int)t);

    /// <summary>Al cambiar de sucursal se limpia la caja: la que estuviera elegida puede no ser de esta.</summary>
    private Task CambiarSucursalAsync(int? sucursalId)
    {
        _sucursalId = sucursalId;
        if (_cajaId is { } caja && _cajas.FirstOrDefault(c => c.Id == caja) is { } elegida && elegida.SucursalId != sucursalId)
            _cajaId = null;

        Filtrar();
        return Task.CompletedTask;
    }

    private void Filtrar()
    {
        var cajasVisibles = _sucursalId is { } sucursal
            ? _cajas.Where(c => c.SucursalId == sucursal).Select(c => c.Id).ToHashSet()
            : null;

        _filtradas = _secuencias
            .Where(s => cajasVisibles is null || cajasVisibles.Contains(s.CajaId))
            .Where(s => _cajaId is not { } caja || s.CajaId == caja)
            .Where(s => _tipo is not { } tipo || s.TipoComprobante == tipo)
            .Where(s => !_soloActivos || s.Activa)
            .ToList();
    }

    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Now);

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        var secuencias = await Cliente.ListarSecuenciasAsync();
        _cajas = await Cliente.ListarCajasAsync() ?? [];
        _anulaciones = await Cliente.ListarAnulacionesEcfAsync() ?? [];
        _error = secuencias is null;
        _secuencias = secuencias ?? [];
        Filtrar();
        _cargando = false;
    }

    private static Color ColorEstado(EstadoAnulacionEcf estado) => estado switch
    {
        EstadoAnulacionEcf.Aceptada => Color.Success,
        EstadoAnulacionEcf.Rechazada => Color.Error,
        _ => Color.Warning,
    };

    private async Task AnularAsync(DatosSecuenciaEcfCentral secuencia)
    {
        var parametros = new DialogParameters<DialogoAnulacionEcf> { { d => d.Secuencia, secuencia } };
        var referencia = await Dialogos.ShowAsync<DialogoAnulacionEcf>("Anular e-NCF no utilizados", parametros);
        if (await referencia.Result is { Canceled: false })
            Avisos.Add("La DGII aceptó la anulación.", Severity.Success);

        // Un intento rechazado o fallido también queda registrado: se recarga siempre.
        await CargarAsync();
    }

    private async Task AbrirDialogoAsync(DatosSecuenciaEcfCentral? secuencia)
    {
        var parametros = new DialogParameters<DialogoSecuencia> { { d => d.Secuencia, secuencia }, { d => d.Cajas, _cajas } };
        var titulo = secuencia is null ? "Asignar rango de e-CF" : $"Rango E{(int)secuencia.TipoComprobante} de la caja {secuencia.CajaCodigo}";
        var referencia = await Dialogos.ShowAsync<DialogoSecuencia>(titulo, parametros);
        if (await referencia.Result is not { Canceled: false })
            return;

        Avisos.Add("Rango guardado. Baja a la caja en su próxima sincronización.", Severity.Success);
        await CargarAsync();
    }
}
