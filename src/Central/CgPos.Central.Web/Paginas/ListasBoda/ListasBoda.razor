@page "/listas-boda"
@attribute [Authorize(Policy = CatalogoPermisosCentral.AdministrarListasBoda)]
@using CgPos.Contratos.Catalogo
@using CgPos.Dominio.ListasBoda
@inject ClienteCentral Cliente
@inject ISnackbar Avisos

<PageTitle>Listas de boda · CG-POS Central</PageTitle>

@* Encabezado de la pantalla: qué son las listas y el botón para crear una. *@
<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">Listas de boda</MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">
            Listas de regalos con los datos del cliente, del evento y los artículos pedidos. Las cajas las consultan por su número al vender
            (F6) y la compra queda registrada aquí.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => Editar(null)">Nueva lista</MudButton>
</div>

@if (_configuracion is { } configuracion)
{
    <MudAlert Severity="@(configuracion.DescuentaCompras ? Severity.Info : Severity.Normal)" Dense="true" Class="mb-4">
        @(configuracion.DescuentaCompras
            ? "Lo que se compra se descuenta de las cantidades pedidas (Central.ListasBoda.DescontarCompras)."
            : "Las compras quedan en el historial pero no bajan las cantidades pedidas (Central.ListasBoda.DescontarCompras).")
    </MudAlert>
}

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar las listas. Verifique la comunicación con el Central.</MudAlert>
}

<MudPaper Elevation="1">
    <MudTable T="DatosListaBoda" Items="_listas" Hover="true" Class="cg-central__tabla" Breakpoint="Breakpoint.Sm" Elevation="0" Loading="_cargando"
              RowsPerPage="25" OnRowClick="@(evento => Editar(evento.Item))" RowStyle="cursor: pointer">
        <ToolBarContent>
            @* Filtros de la tabla: texto libre y estado de la lista. *@
            <div class="d-flex gap-3 flex-wrap align-center" style="width: 100%">
                <MudTextField T="string" Value="_buscar" ValueChanged="@(v => FiltrarAsync(() => _buscar = v))" DebounceInterval="400"
                              Placeholder="Número, evento, cliente o documento" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" Style="min-width: 280px" />
                <MudSelect T="EstadoListaBoda?" Value="_estado" ValueChanged="@(v => FiltrarAsync(() => _estado = v))" Label="Estado" Dense="true"
                           Clearable="true" Style="max-width: 200px">
                    <MudSelectItem T="EstadoListaBoda?" Value="@EstadoListaBoda.Abierta">Abiertas</MudSelectItem>
                    <MudSelectItem T="EstadoListaBoda?" Value="@EstadoListaBoda.Cerrada">Cerradas</MudSelectItem>
                </MudSelect>
            </div>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Lista</MudTh>
            <MudTh>Cliente</MudTh>
            <MudTh>Evento</MudTh>
            <MudTh Style="text-align: right">Artículos</MudTh>
            <MudTh Style="text-align: right">Comprado</MudTh>
            <MudTh>Estado</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Lista"><strong>@context.Numero</strong><div class="cg-central__detalle">@context.Evento</div></MudTd>
            <MudTd DataLabel="Cliente">@context.ClienteNombre<div class="cg-central__detalle">@context.ClienteDocumento</div></MudTd>
            <MudTd DataLabel="Evento">
                @context.FechaEvento.ToString("dd/MM/yyyy")
                <div class="cg-central__detalle">@(context.SucursalNombre ?? "Todas las sucursales")</div>
            </MudTd>
            <MudTd DataLabel="Artículos" Style="text-align: right">
                @context.Articulos.Count
                <div class="cg-central__detalle">Pendientes @context.Articulos.Count(a => a.Pendiente > 0)</div>
            </MudTd>
            <MudTd DataLabel="Comprado" Style="text-align: right">
                @context.TotalComprado.ToString("N2")
                <div class="cg-central__detalle">@context.Compras.Count facturas</div>
            </MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Size="Size.Small" Color="@(context.Estado == EstadoListaBoda.Abierta ? Color.Success : Color.Default)"
                         Variant="Variant.Outlined">@(context.Estado == EstadoListaBoda.Abierta ? "Abierta" : "Cerrada")</MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>No hay listas que coincidan con el filtro.</NoRecordsContent>
    </MudTable>
</MudPaper>

@if (_editando is { } lista)
{
    @* Formulario de la lista: datos del cliente, del evento y los artículos pedidos. *@
    <MudDialog @bind-Visible="_abierto" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">@(_listaId is null ? "Nueva lista" : $"Lista {lista.Numero}")</MudText>
        </TitleContent>
        <DialogContent>
            @* Datos de los festejados y del evento. *@
            <div class="d-flex gap-3 flex-wrap">
                <MudTextField @bind-Value="_evento" Label="Evento (ej. Boda de Ana y Luis)" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Style="min-width: 320px" />
                <MudDatePicker @bind-Date="_fechaEvento" Label="Fecha del evento" Variant="Variant.Outlined" Margin="Margin.Dense" Class="cg-central__filtro-fecha" />
                <MudTextField @bind-Value="_lugar" Label="Lugar (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 260px" />
            </div>

            @* Datos de contacto del cliente que crea la lista. *@
            <div class="d-flex gap-3 flex-wrap mt-3">
                <MudTextField @bind-Value="_clienteDocumento" Label="Cédula o RNC" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 220px" />
                <MudTextField @bind-Value="_clienteNombre" Label="Nombre del cliente" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 280px" />
                <MudTextField @bind-Value="_telefono" Label="Teléfono" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 200px" />
                <MudTextField @bind-Value="_correo" Label="Correo" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 240px" />
            </div>

            <MudTextField @bind-Value="_observacion" Label="Observación (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />

            @* Artículos pedidos: se eligen del maestro buscando por su código interno o su descripción; lo comprado se muestra al editar. *@
            <div class="mt-4">
                <MudText Typo="Typo.subtitle1">Artículos pedidos</MudText>
                <MudTable T="ArticuloEnEdicion" Items="_articulos" Dense="true" Hover="false" Elevation="0" Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh Style="width: 200px">Código</MudTh>
                        <MudTh>Descripción</MudTh>
                        <MudTh Style="width: 130px">Cantidad</MudTh>
                        <MudTh Style="width: 120px">Comprado</MudTh>
                        <MudTh Style="width: 60px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudAutocomplete T="ArticuloCarga" Value="@BuscadoDe(context)" ValueChanged="@(articulo => Elegir(context, articulo))"
                                             SearchFunc="BuscarArticulosAsync" ToStringFunc="@(a => a?.Codigo ?? string.Empty)" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" ResetValueOnEmptyText="false" CoerceText="true" Placeholder="Código o descripción"
                                             MinCharacters="2" MaxItems="20" />
                        </MudTd>
                        <MudTd>@context.Descripcion</MudTd>
                        <MudTd><MudNumericField @bind-Value="context.Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.001m" /></MudTd>
                        <MudTd>@context.Comprado.ToString("0.###")</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => _articulos.Remove(context)" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="() => _articulos.Add(new ArticuloEnEdicion())">
                    Agregar artículo
                </MudButton>
            </div>

            @if (lista.Compras is { Count: > 0 } compras)
            {
                @* Facturas que las cajas cobraron contra esta lista. *@
                <div class="mt-4">
                    <MudText Typo="Typo.subtitle1">Compras registradas</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var compra in compras)
                            {
                                <tr>
                                    <td>@compra.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@compra.VentaNumero</td>
                                    <td>Caja @compra.CajaCodigo</td>
                                    <td style="text-align: right">@compra.Monto.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
        </DialogContent>
        <DialogActions>
            @if (_listaId is { } id)
            {
                <MudButton OnClick="() => CambiarEstadoAsync(id, lista.Estado == EstadoListaBoda.Abierta)">
                    @(lista.Estado == EstadoListaBoda.Abierta ? "Cerrar lista" : "Reabrir lista")
                </MudButton>
            }
            <MudButton OnClick="Cerrar">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_guardando" OnClick="GuardarAsync">Guardar</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private IReadOnlyList<DatosListaBoda> _listas = [];
    private DatosConfiguracionListasBoda? _configuracion;
    private string? _buscar;
    private EstadoListaBoda? _estado;
    private bool _cargando;
    private bool _error;
    private bool _guardando;

    private DatosListaBoda? _editando;
    private int? _listaId;
    private string _evento = string.Empty;
    private DateTime? _fechaEvento = DateTime.Today;
    private string? _lugar;
    private string _clienteDocumento = string.Empty;
    private string _clienteNombre = string.Empty;
    private string? _telefono;
    private string? _correo;
    private string? _observacion;
    private readonly List<ArticuloEnEdicion> _articulos = [];
    private bool _abierto;

    protected override async Task OnInitializedAsync()
    {
        _configuracion = await Cliente.ObtenerConfiguracionListasBodaAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        var listas = await Cliente.ListarListasBodaAsync(_buscar, _estado);
        _cargando = false;
        _error = listas is null;
        _listas = listas ?? [];
    }

    private async Task FiltrarAsync(Action cambiar)
    {
        cambiar();
        await CargarAsync();
    }

    /// <summary>Abre el formulario con una lista existente o en blanco para crear una nueva.</summary>
    private void Editar(DatosListaBoda? lista)
    {
        _abierto = true;
        _editando = lista ?? new DatosListaBoda(0, string.Empty, string.Empty, DateOnly.FromDateTime(DateTime.Today), null, string.Empty, string.Empty,
            null, null, null, null, null, EstadoListaBoda.Abierta, 0m, DateTimeOffset.Now, [], []);
        _listaId = lista?.Id;
        _evento = _editando.Evento;
        _fechaEvento = _editando.FechaEvento.ToDateTime(TimeOnly.MinValue);
        _lugar = _editando.Lugar;
        _clienteDocumento = _editando.ClienteDocumento;
        _clienteNombre = _editando.ClienteNombre;
        _telefono = _editando.ClienteTelefono;
        _correo = _editando.ClienteCorreo;
        _observacion = _editando.Observacion;
        _articulos.Clear();
        foreach (var articulo in _editando.Articulos)
            _articulos.Add(new ArticuloEnEdicion { Codigo = articulo.ArticuloCodigo, Descripcion = articulo.Descripcion, Cantidad = articulo.Cantidad, Comprado = articulo.Comprado });
        if (_articulos.Count == 0)
            _articulos.Add(new ArticuloEnEdicion());
    }

    /// <summary>El diálogo se oculta con su interruptor; quitarlo del árbol mientras está abierto deja el fondo pegado.</summary>
    /// <summary>Solo se oculta: vaciar el contenido quita el diálogo del árbol y su fondo se queda pegado.</summary>
    private void Cerrar() => _abierto = false;

    private async Task GuardarAsync()
    {
        var articulos = _articulos
            .Where(a => !string.IsNullOrWhiteSpace(a.Codigo) && a.Cantidad > 0)
            .Select(a => new SolicitudArticuloListaBoda(a.Codigo.Trim(), string.IsNullOrWhiteSpace(a.Descripcion) ? a.Codigo.Trim() : a.Descripcion.Trim(), a.Cantidad))
            .ToList();

        var solicitud = new SolicitudListaBoda(null, _evento, DateOnly.FromDateTime(_fechaEvento ?? DateTime.Today), _lugar, _clienteDocumento, _clienteNombre,
            _telefono, _correo, null, _observacion, articulos);

        _guardando = true;
        var respuesta = _listaId is { } id
            ? await Cliente.ActualizarListaBodaAsync(id, solicitud)
            : await Cliente.CrearListaBodaAsync(solicitud);
        _guardando = false;

        if (!respuesta.Exitosa)
        {
            Avisos.Add(respuesta.Mensaje ?? "No se pudo guardar la lista.", Severity.Error);
            return;
        }

        Avisos.Add(_listaId is null ? "Lista creada." : "Lista actualizada.", Severity.Success);
        Cerrar();
        await CargarAsync();
    }

    private async Task CambiarEstadoAsync(int listaBodaId, bool cerrar)
    {
        var respuesta = await Cliente.CambiarEstadoListaBodaAsync(listaBodaId, cerrar);
        if (!respuesta.Exitosa)
        {
            Avisos.Add(respuesta.Mensaje ?? "No se pudo cambiar el estado.", Severity.Error);
            return;
        }

        Cerrar();
        await CargarAsync();
    }

    /// <summary>Fila del formulario de artículos, mientras se edita.</summary>
    /// <summary>Artículos del maestro que coinciden con lo que se escribe: se busca por código interno o por descripción.</summary>
    private async Task<IEnumerable<ArticuloCarga>> BuscarArticulosAsync(string texto, CancellationToken cancelacion) =>
        (await Cliente.BuscarArticulosAsync("manager/listas-boda", texto, 0, 20, cancelacion))?.Elementos.Select(e => e.Dato) ?? [];

    /// <summary>Lo ya elegido, para que el buscador muestre el código del artículo de esa línea.</summary>
    private static ArticuloCarga? BuscadoDe(ArticuloEnEdicion linea) =>
        linea.Codigo.Length == 0 ? null : new ArticuloCarga(linea.Codigo, linea.Descripcion, 0, 0, string.Empty, 0m);

    /// <summary>Al elegir el artículo, la línea toma su código y su descripción del maestro: no se digitan a mano.</summary>
    private static void Elegir(ArticuloEnEdicion linea, ArticuloCarga? articulo)
    {
        linea.Codigo = articulo?.Codigo ?? string.Empty;
        linea.Descripcion = articulo?.Descripcion ?? string.Empty;
    }

    private sealed class ArticuloEnEdicion
    {
        public string Codigo { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public decimal Cantidad { get; set; } = 1m;
        public decimal Comprado { get; init; }
    }
}
