@page "/listas-boda/nueva"
@page "/listas-boda/{ListaBodaId:int}"
@attribute [Authorize(Policy = CatalogoPermisosCentral.AdministrarListasBoda)]
@using CgPos.Contratos.Catalogo
@using CgPos.Dominio.ListasBoda
@inject ClienteCentral Cliente
@inject IDialogService Dialogos
@inject ISnackbar Avisos
@inject NavigationManager Navegacion

<PageTitle>@(ListaBodaId is null ? "Nueva lista" : "Lista de boda") · CG-POS Central</PageTitle>

@* Encabezado: de qué lista se trata y cómo volver al listado sin guardar. *@
<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">
            @(ListaBodaId is null ? "Nueva lista" : $"Lista {_lista?.Numero}")
        </MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">
            Los artículos que se pidan aquí son los que la caja va a cobrar cuando el cliente dé el número de la lista (F6).
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Volver">Volver al listado</MudButton>
</div>

@if (_noExiste)
{
    <MudAlert Severity="Severity.Error">No se encontró la lista.</MudAlert>
}
else if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_lista is { } lista)
{
    @* Formulario de la lista: datos del cliente, del evento y los artículos pedidos. *@
    <MudPaper Elevation="1" Class="pa-4">
        @* Datos de los festejados y del evento. *@
        <div class="d-flex gap-3 flex-wrap">
            <MudTextField @bind-Value="_evento" Label="Evento (ej. Boda de Ana y Luis)" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Style="min-width: 320px" />
            <MudDatePicker @bind-Date="_fechaEvento" Label="Fecha del evento" Variant="Variant.Outlined" Margin="Margin.Dense" Class="cg-central__filtro-fecha" />
            <MudTextField @bind-Value="_lugar" Label="Lugar (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 260px" />
        </div>

        @* Datos de contacto del cliente que crea la lista. *@
        <div class="d-flex gap-3 flex-wrap mt-3">
            <MudTextField @bind-Value="_clienteDocumento" Label="Cédula o RNC" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 220px" />
            <MudTextField @bind-Value="_clienteNombre" Label="Nombre del cliente" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 280px" />
            <CampoTelefono @bind-Value="_telefono" Margin="Margin.Dense" Style="max-width: 200px" />
            <MudTextField @bind-Value="_correo" Label="Correo" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 240px" />
        </div>

        <MudTextField @bind-Value="_observacion" Label="Observación (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />

        @* Captura: se digita el código, Enter lo busca y pasa a la cantidad, y otro Enter lo agrega a la lista. *@
        <div class="mt-4">
            <MudText Typo="Typo.subtitle1">Artículos pedidos</MudText>

            <div class="d-flex gap-2 flex-wrap align-end">
                <MudTextField @ref="_campoCodigo" @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Style="width: 200px" OnKeyDown="AlTeclearCodigo"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="BuscarEnElMaestroAsync"
                              AdornmentAriaLabel="Buscar artículo" />
                <MudTextField Value="_descripcion" Label="Descripción" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"
                              Class="flex-grow-1" Style="min-width: 260px" />
                @* El precio es solo para verlo: la lista guarda lo pedido, y la caja cobra el precio que esté vigente ese día. *@
                <MudNumericField Value="_precio" T="decimal" Label="Precio del día" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2"
                                 Style="width: 140px" ReadOnly="true" HideSpinButtons="true" />
                @* La cantidad sale vacía: se escribe el número y ya. Vacío vale 1. *@
                <MudNumericField @ref="_campoCantidad" Immediate="true" @bind-Value="_cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0.001m" Format="0.###" Style="width: 130px" OnKeyDown="AlTeclearCantidad" Placeholder="1" HideSpinButtons="true" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarAsync">Agregar</MudButton>
            </div>

            @* Lo agregado, con lo último arriba para ver que entró lo que se acaba de digitar. *@
            <MudTable T="ArticuloEnEdicion" Items="_articulos" Dense="true" Hover="false" Elevation="0" Breakpoint="Breakpoint.None" Class="mt-2 cg-central__lineas">
                <HeaderContent>
                    <MudTh Style="width: 200px">Código</MudTh>
                    <MudTh>Descripción</MudTh>
                    <MudTh Style="width: 130px">Cantidad</MudTh>
                    <MudTh Style="width: 140px; text-align: right">Precio</MudTh>
                    <MudTh Style="width: 120px">Comprado</MudTh>
                    <MudTh Style="width: 60px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Codigo</MudTd>
                    <MudTd>@context.Descripcion</MudTd>
                    <MudTd><MudNumericField @bind-Value="context.Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.001m" HideSpinButtons="true" /></MudTd>
                    @* Los artículos de una lista guardada no traen precio: la lista pide artículos, no precios. *@
                    <MudTd Style="text-align: right">@(context.Precio > 0 ? context.Precio.ToString("N2") : "—")</MudTd>
                    <MudTd>@context.Comprado.ToString("0.###")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => _articulos.Remove(context)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2">Todavía no hay artículos: digite el código arriba y presione Enter.</MudText>
                </NoRecordsContent>
            </MudTable>
        </div>

        @if (lista.Compras is { Count: > 0 } compras)
        {
            @* Facturas que las cajas cobraron contra esta lista. *@
            <div class="mt-4">
                <MudText Typo="Typo.subtitle1">Compras registradas</MudText>
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        @foreach (var compra in compras)
                        {
                            <tr>
                                <td>@compra.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@compra.VentaNumero</td>
                                <td>Caja @compra.CajaCodigo</td>
                                <td style="text-align: right">@compra.Monto.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </MudPaper>

    @* Las acciones van abajo, donde termina el formulario. *@
    <div class="d-flex justify-end gap-2 mt-4">
        @if (ListaBodaId is { } id)
        {
            <MudButton OnClick="() => CambiarEstadoAsync(id, lista.Estado == EstadoListaBoda.Abierta)">
                @(lista.Estado == EstadoListaBoda.Abierta ? "Cerrar lista" : "Reabrir lista")
            </MudButton>
        }
        <MudButton OnClick="Volver">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_guardando" OnClick="GuardarAsync">Guardar</MudButton>
    </div>
}

@code {
    /// <summary>Viene de la ruta: sin él la pantalla arranca en blanco para una lista nueva.</summary>
    [Parameter]
    public int? ListaBodaId { get; set; }

    private DatosListaBoda? _lista;
    private bool _cargando = true;
    private bool _noExiste;
    private bool _guardando;

    private string _evento = string.Empty;
    private DateTime? _fechaEvento = DateTime.Today;
    private string? _lugar;
    private string _clienteDocumento = string.Empty;
    private string _clienteNombre = string.Empty;
    private string? _telefono;
    private string? _correo;
    private string? _observacion;
    // Los artículos se guardan con el último arriba, que es como se ven: al guardar se invierte para respetar el orden en que se digitaron.
    private readonly List<ArticuloEnEdicion> _articulos = [];

    // La fila de captura, que es donde se digita antes de agregar.
    private string? _codigo;
    private string _descripcion = string.Empty;
    private decimal _precio;
    private decimal? _cantidad;
    private MudTextField<string?>? _campoCodigo;
    private MudNumericField<decimal?>? _campoCantidad;

    /// <summary>Se ejecuta también al pasar de una lista a otra sin salir de la pantalla.</summary>
    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _noExiste = false;

        var lista = ListaBodaId is { } id ? await Cliente.ObtenerListaBodaAsync(id) : Vacia();
        _cargando = false;

        if (lista is null)
        {
            _noExiste = true;
            _lista = null;
            return;
        }

        _lista = lista;
        _evento = lista.Evento;
        _fechaEvento = lista.FechaEvento.ToDateTime(TimeOnly.MinValue);
        _lugar = lista.Lugar;
        _clienteDocumento = lista.ClienteDocumento;
        _clienteNombre = lista.ClienteNombre;
        _telefono = lista.ClienteTelefono;
        _correo = lista.ClienteCorreo;
        _observacion = lista.Observacion;

        _articulos.Clear();
        foreach (var articulo in lista.Articulos)
            _articulos.Insert(0, new ArticuloEnEdicion { Codigo = articulo.ArticuloCodigo, Descripcion = articulo.Descripcion, Cantidad = articulo.Cantidad, Comprado = articulo.Comprado });
    }

    /// <summary>La lista en blanco con la que arranca el formulario cuando todavía no existe.</summary>
    private static DatosListaBoda Vacia() => new(0, string.Empty, string.Empty, DateOnly.FromDateTime(DateTime.Today), null, string.Empty, string.Empty,
        null, null, null, null, null, EstadoListaBoda.Abierta, 0m, DateTimeOffset.Now, [], []);

    private void Volver() => Navegacion.NavigateTo("listas-boda");

    // ---------- La captura ----------

    /// <summary>Enter en el código: busca el artículo y pasa a la cantidad. Sin código, abre la búsqueda.</summary>
    private async Task AlTeclearCodigo(KeyboardEventArgs tecla)
    {
        if (tecla.Key is not ("Enter" or "NumpadEnter"))
            return;

        if (string.IsNullOrWhiteSpace(_codigo))
        {
            await BuscarEnElMaestroAsync();
            return;
        }

        var articulo = await BuscarPorCodigoAsync(_codigo.Trim());
        if (articulo is null)
        {
            // No se encontró tal cual: se abre la búsqueda con lo digitado, en vez de dejar al usuario sin salida.
            await BuscarEnElMaestroAsync(_codigo.Trim());
            return;
        }

        Tomar(articulo);
        await EnfocarAsync(_campoCantidad);
    }

    /// <summary>Enter en la cantidad: el artículo entra a la lista y todo vuelve al código, vacío.</summary>
    private async Task AlTeclearCantidad(KeyboardEventArgs tecla)
    {
        if (tecla.Key is "Enter" or "NumpadEnter")
            await AgregarAsync();
    }

    /// <summary>El artículo cuyo código se digitó: exacto por código, o el único que coincida.</summary>
    private async Task<ArticuloCarga?> BuscarPorCodigoAsync(string codigo)
    {
        var pagina = await Cliente.BuscarArticulosAsync("manager/listas-boda", codigo, 0, 20);
        var articulos = pagina?.Elementos.Select(e => e.Dato).ToList() ?? [];

        return articulos.FirstOrDefault(a => string.Equals(a.Codigo, codigo, StringComparison.OrdinalIgnoreCase))
               ?? articulos.FirstOrDefault(a => a.CodigosBarras?.Any(b => string.Equals(b, codigo, StringComparison.OrdinalIgnoreCase)) == true)
               ?? (articulos.Count == 1 ? articulos[0] : null);
    }

    /// <summary>La búsqueda por descripción: abre el listado del maestro y vuelve con el artículo elegido.</summary>
    private async Task BuscarEnElMaestroAsync() => await BuscarEnElMaestroAsync(null);

    private async Task BuscarEnElMaestroAsync(string? textoInicial)
    {
        var parametros = new DialogParameters<DialogoBuscarArticulo>
        {
            { d => d.Modulo, "manager/listas-boda" },
            { d => d.TextoInicial, textoInicial },
        };
        var referencia = await Dialogos.ShowAsync<DialogoBuscarArticulo>("Buscar artículo",
            parametros, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        if (await referencia.Result is not { Canceled: false, Data: ArticuloCarga articulo })
            return;

        Tomar(articulo);
        await EnfocarAsync(_campoCantidad);
    }

    /// <summary>El artículo elegido llena la fila de captura con su código y su descripción del maestro.</summary>
    private void Tomar(ArticuloCarga articulo)
    {
        _codigo = articulo.Codigo;
        _descripcion = articulo.Descripcion;
        _precio = articulo.PrecioDetalle;
    }

    /// <summary>Pasa lo digitado a la lista y deja la fila lista para el siguiente artículo.</summary>
    private async Task AgregarAsync()
    {
        if (string.IsNullOrWhiteSpace(_codigo) || _descripcion.Length == 0)
        {
            Avisos.Add("Elija primero el artículo: digite su código y presione Enter, o búsquelo con la lupa.", Severity.Warning);
            await EnfocarAsync(_campoCodigo);
            return;
        }

        // Dejar la cantidad vacía es lo más común: una unidad.
        var cantidad = _cantidad ?? 1m;
        if (cantidad <= 0)
        {
            Avisos.Add("La cantidad tiene que ser mayor que cero.", Severity.Warning);
            await EnfocarAsync(_campoCantidad);
            return;
        }

        _articulos.Insert(0, new ArticuloEnEdicion { Codigo = _codigo.Trim(), Descripcion = _descripcion, Cantidad = cantidad, Precio = _precio });

        _codigo = null;
        _descripcion = string.Empty;
        _precio = 0m;
        _cantidad = null;
        await EnfocarAsync(_campoCodigo);
    }

    /// <summary>El foco salta solo de un campo al siguiente: la idea es no tocar el mouse mientras se digita.</summary>
    private static async Task EnfocarAsync(MudTextField<string?>? campo)
    {
        if (campo is { } destino)
            await destino.FocusAsync();
    }

    private static async Task EnfocarAsync(MudNumericField<decimal?>? campo)
    {
        if (campo is { } destino)
            await destino.FocusAsync();
    }

    private async Task GuardarAsync()
    {
        // Los artículos se guardan en el orden en que se digitaron, aunque en pantalla el último esté arriba.
        var articulos = Enumerable.Reverse(_articulos)
            .Where(a => !string.IsNullOrWhiteSpace(a.Codigo) && a.Cantidad > 0)
            .Select(a => new SolicitudArticuloListaBoda(a.Codigo.Trim(), string.IsNullOrWhiteSpace(a.Descripcion) ? a.Codigo.Trim() : a.Descripcion.Trim(), a.Cantidad))
            .ToList();

        var solicitud = new SolicitudListaBoda(null, _evento, DateOnly.FromDateTime(_fechaEvento ?? DateTime.Today), _lugar, _clienteDocumento, _clienteNombre,
            _telefono, _correo, null, _observacion, articulos);

        _guardando = true;
        var respuesta = ListaBodaId is { } id
            ? await Cliente.ActualizarListaBodaAsync(id, solicitud)
            : await Cliente.CrearListaBodaAsync(solicitud);
        _guardando = false;

        if (!respuesta.Exitosa)
        {
            Avisos.Add(respuesta.Mensaje ?? "No se pudo guardar la lista.", Severity.Error);
            return;
        }

        Avisos.Add(ListaBodaId is null ? "Lista creada." : "Lista actualizada.", Severity.Success);
        Volver();
    }

    private async Task CambiarEstadoAsync(int listaBodaId, bool cerrar)
    {
        var respuesta = await Cliente.CambiarEstadoListaBodaAsync(listaBodaId, cerrar);
        if (!respuesta.Exitosa)
        {
            Avisos.Add(respuesta.Mensaje ?? "No se pudo cambiar el estado.", Severity.Error);
            return;
        }

        Volver();
    }

    /// <summary>Fila del formulario de artículos, mientras se edita.</summary>
    private sealed class ArticuloEnEdicion
    {
        public string Codigo { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public decimal Cantidad { get; set; } = 1m;

        /// <summary>Solo para verlo mientras se arma la lista: lo que se cobra es el precio del día de la compra.</summary>
        public decimal Precio { get; init; }

        public decimal Comprado { get; init; }
    }
}
