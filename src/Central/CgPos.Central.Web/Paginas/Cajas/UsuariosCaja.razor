@page "/cajas/usuarios"
@attribute [Authorize(Policy = CatalogoPermisosCentral.AdministrarUsuariosCaja)]
@inject ClienteCentral Cliente
@inject IDialogService Dialogos
@inject ISnackbar Avisos

<PageTitle>Usuarios de caja · CG-POS Central</PageTitle>

<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">Usuarios de caja</MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">
            Cajeros, supervisores y gerentes: su rol, las cajas que operan, su clave de acceso. Bajan a las cajas en su próxima sincronización.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="() => AbrirDialogoAsync(null)">
        Nuevo usuario de caja
    </MudButton>
</div>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar los usuarios de caja. Verifique la comunicación con el Central.</MudAlert>
}

<MudPaper Elevation="1">
    <MudTable T="DatosUsuarioCaja" Items="_filtrados" Hover="true" Loading="_cargando" Class="cg-central__tabla" Breakpoint="Breakpoint.Sm" Elevation="0">
        <ToolBarContent>
            <MudTextField T="string" @bind-Value="_filtro" @bind-Value:after="Filtrar" Placeholder="Buscar por código, nombre o rol" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="200" Clearable="true" Style="width: 420px" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Código</MudTh>
            <MudTh>Nombre</MudTh>
            <MudTh>Rol</MudTh>
            <MudTh>Cajas</MudTh>
            <MudTh>Acceso</MudTh>
            <MudTh>Último ingreso</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh Style="width: 56px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Código"><strong>@context.Codigo</strong></MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Rol">@context.RolNombre</MudTd>
            <MudTd DataLabel="Cajas">@NombresCajas(context.Cajas)</MudTd>
            <MudTd DataLabel="Acceso">
                <div class="cg-central__chips">
                    @if (context.TieneClave)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Key">Clave asignada</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Sin clave</MudChip>
                    }
                </div>
            </MudTd>
            @* Lo avisa la caja al entrar el usuario, así que aquí se ve el de todas las terminales juntas. *@
            <MudTd DataLabel="Último ingreso">@UltimoIngreso(context)</MudTd>
            <MudTd DataLabel="Estado">
                @if (context.Activo)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Activo</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Inactivo</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => AbrirDialogoAsync(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay usuarios de caja que coincidan.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private IReadOnlyList<DatosUsuarioCaja> _usuarios = [];
    private IReadOnlyList<DatosRolCaja> _roles = [];
    private IReadOnlyList<DatosCaja> _cajas = [];
    private string? _filtro;
    private bool _cargando = true;
    private bool _error;

    private readonly BuscadorEnMemoria<DatosUsuarioCaja> _buscador = new();
    private List<DatosUsuarioCaja> _filtrados = [];

    private void Indexar()
    {
        _buscador.Indexar(_usuarios, u => $"{u.Codigo} {u.Nombre} {u.RolNombre}");
        Filtrar();
    }

    private void Filtrar() => _filtrados = _buscador.Filtrar(_filtro);

    private string UltimoIngreso(DatosUsuarioCaja usuario)
    {
        if (usuario.UltimoIngresoEn is not { } fecha)
            return "Nunca";

        var caja = _cajas.FirstOrDefault(c => c.Id == usuario.UltimoIngresoCajaId);
        var donde = caja is null ? string.Empty : $" · caja {caja.SucursalCodigo}-{caja.Codigo}";
        return $"{fecha.ToLocalTime():dd/MM/yyyy h:mm tt}{donde}";
    }

    private string NombresCajas(IReadOnlyList<int> cajas) =>
        cajas.Count == 0 ? "Ninguna" : string.Join(", ", cajas.Select(id => _cajas.FirstOrDefault(c => c.Id == id) is { } caja ? $"{caja.SucursalCodigo}-{caja.Codigo}" : "?"));

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        var usuarios = await Cliente.ListarUsuariosCajaAsync();
        var roles = await Cliente.ListarRolesCajaAsync();
        var cajas = await Cliente.ListarCajasAsync();
        _error = usuarios is null || roles is null;
        _usuarios = usuarios ?? [];
        Indexar();
        _roles = roles ?? [];
        _cajas = cajas ?? [];
        _cargando = false;
    }

    private async Task AbrirDialogoAsync(DatosUsuarioCaja? usuario)
    {
        var parametros = new DialogParameters<DialogoUsuarioCaja> { { d => d.Usuario, usuario }, { d => d.Roles, _roles }, { d => d.Cajas, _cajas } };
        var referencia = await Dialogos.ShowAsync<DialogoUsuarioCaja>(usuario is null ? "Nuevo usuario de caja" : $"Editar usuario {usuario.Codigo}", parametros);
        if (await referencia.Result is not { Canceled: false })
            return;

        Avisos.Add(usuario is null ? "Usuario de caja creado." : "Usuario de caja actualizado.", Severity.Success);
        await CargarAsync();
    }
}
