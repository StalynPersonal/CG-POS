@page "/organizacion/parametros"
@attribute [Authorize(Policy = CatalogoPermisosCentral.AdministrarOrganizacion)]
@using CgPos.Dominio.Organizacion
@inject ClienteCentral Cliente
@inject IDialogService Dialogos
@inject ISnackbar Avisos

<PageTitle>Parámetros · CG-POS Central</PageTitle>

<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">Parámetros</MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">
            Todas las reglas de negocio del sistema, con su valor general. Una sucursal o una caja pueden tener su propio valor: el de la caja prevalece
            sobre el de su sucursal, y este sobre el general.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="() => AbrirDialogoAsync(null)">
        Valor por sucursal o caja
    </MudButton>
</div>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar los parámetros. Verifique la comunicación con el Central.</MudAlert>
}
else if (!_cargando && ObligatoriosSinConfigurar.ToList() is { Count: > 0 } faltantes)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Faltan parámetros obligatorios generales: @string.Join("; ", faltantes.Select(d => d.Descripcion)). Las operaciones que los usan se rechazan hasta configurarlos.
    </MudAlert>
}

<MudPaper Elevation="1">
    <MudTable T="DatosParametro" Items="Filtrados" GroupBy="_porModulo" Hover="true" Loading="_cargando" Class="cg-central__tabla" Breakpoint="Breakpoint.Sm" Elevation="0">
        <ToolBarContent>
            <MudTextField T="string" @bind-Value="_filtro" Placeholder="Buscar por descripción, módulo, ámbito o valor" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Parámetro</MudTh>
            <MudTh>Ámbito</MudTh>
            <MudTh>Valor</MudTh>
            <MudTh Style="width: 56px"></MudTh>
        </HeaderContent>
        <GroupHeaderTemplate>
            <MudTh colspan="4"><strong>@context.Key</strong></MudTh>
        </GroupHeaderTemplate>
        <RowTemplate>
            <MudTd DataLabel="Parámetro">@Descripcion(context)</MudTd>
            <MudTd DataLabel="Ámbito">@context.Ambito</MudTd>
            <MudTd DataLabel="Valor">
                @if (string.IsNullOrEmpty(context.Valor))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Sin configurar</MudChip>
                }
                else
                {
                    <span class="cg-central__valor">@context.Valor</span>
                }
            </MudTd>
            <MudTd>
                <MudTooltip Text="@(EsSinConfigurar(context) ? "Configurar" : "Cambiar valor")">
                    <MudIconButton Icon="@(EsSinConfigurar(context) ? Icons.Material.Filled.AddCircleOutline : Icons.Material.Filled.Edit)" Size="Size.Small"
                                   OnClick="() => AbrirDialogoAsync(context)" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay parámetros que coincidan.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private IReadOnlyList<DatosParametro> _parametros = [];
    private IReadOnlyList<DefinicionParametro> _catalogo = [];
    private IReadOnlyList<DatosSucursal> _sucursales = [];
    private IReadOnlyList<DatosCaja> _cajas = [];
    private string? _filtro;
    private bool _cargando = true;
    private bool _error;

    private DefinicionParametro? Definicion(string clave) => _catalogo.FirstOrDefault(d => d.Clave == clave);

    private string Descripcion(DatosParametro parametro) => Definicion(parametro.Clave)?.Descripcion ?? parametro.Descripcion ?? parametro.Clave;

    private string Modulo(DatosParametro parametro) => Definicion(parametro.Clave)?.Modulo ?? "Otros";

    // Agrupados por módulo; la clave técnica no se muestra, pero la búsqueda la encuentra (es la que citan los mensajes de error).
    private TableGroupDefinition<DatosParametro> _porModulo = null!;

    protected override void OnInitialized() => _porModulo = new() { Selector = p => Modulo(p) };

    private IEnumerable<DefinicionParametro> ObligatoriosSinConfigurar =>
        _catalogo.Where(d => d.Obligatorio && !_parametros.Any(p => p.Clave == d.Clave && p.SucursalId is null && p.CajaId is null && p.Valor.Length > 0));

    /// <summary>
    /// Lo configurado más una fila general "Sin configurar" por cada parámetro del catálogo que no tiene valor general: así se ve todo lo que se
    /// puede configurar, no solo lo que ya tiene valor.
    /// </summary>
    private IEnumerable<DatosParametro> Filas => _parametros.Concat(_catalogo
        .Where(d => !_parametros.Any(p => p.Clave == d.Clave && p.SucursalId is null && p.CajaId is null))
        .Select(d => new DatosParametro(0, d.Clave, string.Empty, d.Descripcion, null, null, "General")));

    private static bool EsSinConfigurar(DatosParametro parametro) => parametro.Id == 0;

    private IEnumerable<DatosParametro> Filtrados => (string.IsNullOrWhiteSpace(_filtro)
            ? Filas
            : Filas.Where(p => Contiene(p.Clave) || Contiene(p.Ambito) || Contiene(p.Valor) || Contiene(Descripcion(p)) || Contiene(Modulo(p))))
        .OrderBy(Modulo).ThenBy(Descripcion).ThenBy(p => p.Ambito);

    private bool Contiene(string? texto) => texto?.Contains(_filtro!.Trim(), StringComparison.CurrentCultureIgnoreCase) == true;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        var parametros = await Cliente.ListarParametrosAsync();
        var catalogo = await Cliente.ListarCatalogoParametrosAsync();
        var sucursales = await Cliente.ListarSucursalesAsync();
        var cajas = await Cliente.ListarCajasAsync();
        _error = parametros is null || catalogo is null || sucursales is null || cajas is null;
        _parametros = parametros ?? [];
        _catalogo = catalogo ?? [];
        _sucursales = sucursales ?? [];
        _cajas = cajas ?? [];
        _cargando = false;
    }

    private async Task AbrirDialogoAsync(DatosParametro? parametro)
    {
        var parametros = new DialogParameters<DialogoParametro>
        {
            { d => d.Parametro, parametro is null || EsSinConfigurar(parametro) ? null : parametro },
            { d => d.ClaveGeneral, parametro is not null && EsSinConfigurar(parametro) ? parametro.Clave : null },
            { d => d.Catalogo, _catalogo },
            { d => d.Sucursales, _sucursales },
            { d => d.Cajas, _cajas },
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var titulo = parametro is null ? "Valor por sucursal o caja" : EsSinConfigurar(parametro) ? "Configurar parámetro" : "Cambiar valor";
        var referencia = await Dialogos.ShowAsync<DialogoParametro>(titulo, parametros, opciones);
        if (await referencia.Result is not { Canceled: false })
            return;

        var delCentral = parametro is not null && Definicion(parametro.Clave)?.Alcance == AlcanceParametro.Central;
        Avisos.Add(delCentral ? "Parámetro guardado." : "Parámetro guardado. Baja a las cajas en su próxima sincronización.", Severity.Success);
        await CargarAsync();
    }
}
