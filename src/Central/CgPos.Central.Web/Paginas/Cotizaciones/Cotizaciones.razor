@page "/cotizaciones"
@attribute [Authorize(Policy = CatalogoPermisosCentral.AdministrarCotizaciones)]
@using CgPos.Dominio.Cotizaciones
@inject ClienteCentral Cliente
@inject NavigationManager Navegacion

<PageTitle>Cotizaciones · CG-POS Central</PageTitle>

@* Encabezado: qué es una cotización y el botón para hacer una nueva. *@
<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">Cotizaciones</MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">
            Presupuestos para clientes, con los precios del día congelados. Se imprimen o se envían, valen los días configurados y
            cualquier caja las convierte en factura buscándolas por su número.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="cotizaciones/nueva">Nueva cotización</MudButton>
</div>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se pudieron cargar las cotizaciones. Verifique la comunicación con el Central.</MudAlert>
}

<MudPaper Elevation="1">
    <MudTable T="DatosCotizacion" Items="_cotizaciones" Hover="true" Class="cg-central__tabla" Breakpoint="Breakpoint.Sm" Elevation="0" Loading="_cargando"
              RowsPerPage="10" OnRowClick="@(evento => Abrir(evento.Item))" RowStyle="cursor: pointer">
        <ToolBarContent>
            @* Filtros: texto libre (número, cliente o factura) y estado. *@
            <div class="d-flex gap-2 flex-wrap align-center">
                <MudTextField T="string" Value="_buscar" ValueChanged="@(v => FiltrarAsync(() => _buscar = v))" DebounceInterval="400"
                              Placeholder="Número, cliente, documento o factura" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" Style="width: 280px" />
                <MudSelect T="EstadoCotizacion?" Value="_estado" ValueChanged="@(v => FiltrarAsync(() => _estado = v))" Label="Estado" Dense="true"
                           Clearable="true" Style="max-width: 200px">
                    <MudSelectItem T="EstadoCotizacion?" Value="@EstadoCotizacion.Abierta">Abiertas</MudSelectItem>
                    <MudSelectItem T="EstadoCotizacion?" Value="@EstadoCotizacion.Facturada">Facturadas</MudSelectItem>
                    <MudSelectItem T="EstadoCotizacion?" Value="@EstadoCotizacion.Anulada">Anuladas</MudSelectItem>
                </MudSelect>
            </div>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Cotización</MudTh>
            <MudTh>Cliente</MudTh>
            <MudTh>Vence</MudTh>
            <MudTh Style="text-align: right">Líneas</MudTh>
            <MudTh Style="text-align: right">Total</MudTh>
            <MudTh>Estado</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Cotización">
                <strong>@context.Numero</strong>
                <div class="cg-central__detalle">@context.CreadaEn.ToLocalTime().ToString("dd/MM/yyyy") · @context.CreadaPor</div>
            </MudTd>
            <MudTd DataLabel="Cliente">
                @context.ClienteNombre
                <div class="cg-central__detalle">@context.ClienteDocumento</div>
            </MudTd>
            <MudTd DataLabel="Vence">@context.VenceEn.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="Líneas" Style="text-align: right">@context.Lineas.Count</MudTd>
            <MudTd DataLabel="Total" Style="text-align: right">@context.Total.ToString("N2")</MudTd>
            <MudTd DataLabel="Estado">
                @if (context.Estado == EstadoCotizacion.Facturada)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Facturada</MudChip>
                    <div class="cg-central__detalle">@context.VentaNumero</div>
                }
                else if (context.Estado == EstadoCotizacion.Anulada)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Anulada</MudChip>
                }
                else if (context.Vencida)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Vencida</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Vigente</MudChip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay cotizaciones que coincidan.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private IReadOnlyList<DatosCotizacion> _cotizaciones = [];
    private string? _buscar;
    private EstadoCotizacion? _estado;
    private bool _cargando;
    private bool _error;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        var cotizaciones = await Cliente.ListarCotizacionesAsync(_buscar, _estado);
        _cargando = false;
        _error = cotizaciones is null;
        _cotizaciones = cotizaciones ?? [];
    }

    private async Task FiltrarAsync(Action cambiar)
    {
        cambiar();
        await CargarAsync();
    }

    /// <summary>El listado solo busca: la cotización se abre en su propia página.</summary>
    private void Abrir(DatosCotizacion? cotizacion)
    {
        if (cotizacion is { } elegida)
            Navegacion.NavigateTo($"cotizaciones/{elegida.Id}");
    }
}
