@page "/cotizaciones/nueva"
@page "/cotizaciones/{CotizacionId:int}"
@attribute [Authorize(Policy = CatalogoPermisosCentral.AdministrarCotizaciones)]
@using CgPos.Contratos.Catalogo
@using CgPos.Dominio.Cotizaciones
@using CgPos.Dominio.Fiscal
@inject ClienteCentral Cliente
@inject IDialogService Dialogos
@inject ISnackbar Avisos
@inject IJSRuntime Js
@inject NavigationManager Navegacion

<PageTitle>@(CotizacionId is null ? "Nueva cotización" : "Cotización") · CG-POS Central</PageTitle>

@* Encabezado: de qué cotización se trata y cómo volver al listado sin guardar. *@
<div class="cg-central__encabezado">
    <div>
        <MudText Typo="Typo.h4" Class="cg-central__titulo">
            @(CotizacionId is null ? "Nueva cotización" : $"Cotización {_cotizacion?.Numero}")
        </MudText>
        <MudText Typo="Typo.body2" Class="cg-central__subtitulo">
            Los precios que se guarden aquí son los que va a cobrar la caja mientras la cotización esté vigente.
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Volver">Volver al listado</MudButton>
</div>

@if (_noExiste)
{
    <MudAlert Severity="Severity.Error">No se encontró la cotización.</MudAlert>
}
else if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_cotizacion is { } cotizacion)
{
    @* Formulario: los datos del cliente arriba y las líneas con su precio abajo. *@
    <MudPaper Elevation="1" Class="pa-4">
        @if (!_editable)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                @(cotizacion.Estado == EstadoCotizacion.Facturada
                    ? $"Ya se facturó con {cotizacion.VentaNumero}: queda solo para consulta."
                    : $"Anulada: {cotizacion.MotivoAnulacion}")
            </MudAlert>
        }

        @* Datos del cliente y vigencia. *@
        <div class="d-flex gap-3 flex-wrap">
            <MudTextField @bind-Value="_clienteNombre" Label="Nombre del cliente" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Style="min-width: 280px" Disabled="!_editable" />
            @* La lupa (o Enter) busca el documento en el maestro de clientes y completa sus datos. *@
            <MudTextField @bind-Value="_clienteDocumento" Label="Cédula o RNC (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Style="max-width: 220px" Disabled="!_editable" OnKeyDown="AlTeclearDocumento"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="BuscarClienteAsync"
                          AdornmentAriaLabel="Buscar cliente" />
            <MudTextField @bind-Value="_telefono" Label="Teléfono" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 200px"
                          Disabled="!_editable" />
            <MudTextField @bind-Value="_correo" Label="Correo" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 240px"
                          Disabled="!_editable" />
            <MudDatePicker @bind-Date="_venceEn" Label="Vale hasta" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Class="cg-central__filtro-fecha" Disabled="!_editable" />
        </div>

        @* La observación y, a su derecha, el total: así se ve lo que suma sin bajar hasta el final de las líneas. *@
        <div class="d-flex gap-3 align-center mt-3">
            <MudTextField @bind-Value="_observacion" Label="Observación (opcional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="flex-grow-1" Disabled="!_editable" />
            <MudText Typo="Typo.h6" Style="white-space: nowrap">Total @TotalEnEdicion.ToString("N2")</MudText>
        </div>

        @* Captura: se digita el código, Enter lo busca y va a cantidad, de ahí a descuento y Enter lo agrega a la lista. *@
        <div class="mt-4">
            <MudText Typo="Typo.subtitle1">Artículos cotizados</MudText>

            @if (_editable)
            {
                @* Cada campo va en un contenedor con su ancho (el estilo puesto al campo cae en una caja interna y deja huecos): la
                   descripción ocupa todo lo que sobra junto al código, y cantidad, precio y descuento quedan juntos. *@
                <div class="d-flex gap-2 flex-wrap align-end">
                    <div style="width: 200px">
                        <MudTextField @ref="_campoCodigo" @bind-Value="_codigo" Label="Código" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" OnKeyDown="AlTeclearCodigo"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="BuscarEnElMaestroAsync"
                                      AdornmentAriaLabel="Buscar artículo" />
                    </div>
                    <div class="flex-grow-1" style="min-width: 240px">
                        <MudTextField Value="_descripcion" Label="Descripción" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                    </div>
                    @* Cantidad y descuento salen vacíos: se escribe el número y ya. Vacío vale 1 y 0. *@
                    <div style="width: 110px">
                        <MudNumericField @ref="_campoCantidad" Immediate="true" @bind-Value="_cantidad" Label="Cantidad" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Min="0.001m" Format="0.###" OnKeyDown="AlTeclearCantidad" Placeholder="1" HideSpinButtons="true" />
                    </div>
                    @* El precio es el del maestro y no se cambia aquí: lo que se cotiza es el precio del día. *@
                    <div style="width: 130px">
                        <MudNumericField Value="_precio" T="decimal" Label="Precio" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2"
                                         ReadOnly="true" HideSpinButtons="true" />
                    </div>
                    <div style="width: 120px">
                        <MudNumericField @ref="_campoDescuento" Immediate="true" @bind-Value="_descuento" Label="Descuento" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Min="0m" Format="N2" OnKeyDown="AlTeclearDescuento" Placeholder="0.00" HideSpinButtons="true" />
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarAsync">Agregar</MudButton>
                </div>
            }

            @* Lo agregado, con lo último arriba para ver que entró lo que se acaba de digitar. *@
            <MudTable T="LineaEnEdicion" Items="_lineas" Dense="true" Hover="false" Elevation="0" Breakpoint="Breakpoint.None" Class="mt-2 cg-central__lineas">
                <HeaderContent>
                    <MudTh Style="width: 190px">Código</MudTh>
                    <MudTh>Descripción</MudTh>
                    <MudTh Style="width: 120px">Cantidad</MudTh>
                    <MudTh Style="width: 140px; text-align: right">Precio</MudTh>
                    <MudTh Style="width: 130px">Descuento</MudTh>
                    <MudTh Style="width: 120px; text-align: right">Importe</MudTh>
                    <MudTh Style="width: 56px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    @* Filas bajas: cantidad y descuento se corrigen en la misma fila con un campo de una línea en vez del recuadro. *@
                    <MudTd Style="padding-block: 2px">@context.Codigo</MudTd>
                    <MudTd Style="padding-block: 2px">@context.Descripcion</MudTd>
                    <MudTd Style="padding-block: 2px">
                        <MudNumericField @bind-Value="context.Cantidad" Variant="Variant.Text" Margin="Margin.None" Min="0.001m" Format="0.###"
                                         Disabled="!_editable" HideSpinButtons="true" />
                    </MudTd>
                    <MudTd Style="padding-block: 2px; text-align: right">@context.PrecioUnitario.ToString("N2")</MudTd>
                    <MudTd Style="padding-block: 2px">
                        <MudNumericField @bind-Value="context.Descuento" Variant="Variant.Text" Margin="Margin.None" Min="0m" Format="N2"
                                         Disabled="!_editable" HideSpinButtons="true" />
                    </MudTd>
                    <MudTd Style="padding-block: 2px; text-align: right">@context.Importe.ToString("N2")</MudTd>
                    <MudTd Style="padding-block: 2px">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Disabled="!_editable" OnClick="() => _lineas.Remove(context)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2">Todavía no hay artículos: digite el código arriba y presione Enter.</MudText>
                </NoRecordsContent>
            </MudTable>
        </div>
    </MudPaper>

    @* Las acciones van abajo, donde termina el formulario. *@
    <div class="d-flex justify-end gap-2 mt-4">
        @if (CotizacionId is { } id && _editable)
        {
            <MudButton Color="Color.Error" OnClick="() => AnularAsync(id)">Anular</MudButton>
        }
        @if (CotizacionId is { } paraImprimir)
        {
            <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="() => ImprimirAsync(paraImprimir)">Imprimir</MudButton>
        }
        <MudButton OnClick="Volver">Cerrar</MudButton>
        @if (_editable)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_guardando" OnClick="GuardarAsync">Guardar</MudButton>
        }
    </div>
}

@code {
    /// <summary>Viene de la ruta: sin él la pantalla arranca en blanco para una cotización nueva.</summary>
    [Parameter]
    public int? CotizacionId { get; set; }

    private DatosCotizacion? _cotizacion;
    private bool _cargando = true;
    private bool _noExiste;
    private bool _guardando;
    private bool _editable = true;

    private string _clienteNombre = string.Empty;
    private string? _clienteDocumento;
    private string? _telefono;
    private string? _correo;
    private string? _observacion;
    private DateTime? _venceEn;

    // Las líneas se guardan con la última arriba, que es como se ven: al guardar se invierte para respetar el orden en que se digitaron.
    private readonly List<LineaEnEdicion> _lineas = [];

    // La fila de captura, que es donde se digita antes de agregar.
    private string? _codigo;
    private string _descripcion = string.Empty;
    private decimal? _cantidad;
    private decimal _precio;
    private decimal? _descuento;
    private MudTextField<string?>? _campoCodigo;
    private MudNumericField<decimal?>? _campoCantidad;
    private MudNumericField<decimal?>? _campoDescuento;

    /// <summary>Lo que suma la cotización mientras se arma, con el mismo criterio que la caja.</summary>
    private decimal TotalEnEdicion => _lineas.Sum(l => l.Importe);

    /// <summary>Se ejecuta también al pasar de una cotización a otra sin salir de la pantalla.</summary>
    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _noExiste = false;

        var cotizacion = CotizacionId is { } id ? await Cliente.ObtenerCotizacionAsync(id) : Vacia();
        _cargando = false;

        if (cotizacion is null)
        {
            _noExiste = true;
            _cotizacion = null;
            return;
        }

        _cotizacion = cotizacion;
        _editable = CotizacionId is null || cotizacion.Estado == EstadoCotizacion.Abierta;
        _clienteNombre = cotizacion.ClienteNombre;
        _clienteDocumento = cotizacion.ClienteDocumento;
        _telefono = cotizacion.ClienteTelefono;
        _correo = cotizacion.ClienteCorreo;
        _observacion = cotizacion.Observacion;

        // Una cotización nueva propone hoy más los días de vigencia configurados en el Central; se puede cambiar antes de guardar.
        _venceEn = CotizacionId is null
            ? (await Cliente.VencimientoCotizacionAsync())?.ToDateTime(TimeOnly.MinValue)
            : cotizacion.VenceEn.ToDateTime(TimeOnly.MinValue);

        _lineas.Clear();
        foreach (var linea in cotizacion.Lineas)
        {
            _lineas.Insert(0, new LineaEnEdicion
            {
                Codigo = linea.ArticuloCodigo,
                Descripcion = linea.Descripcion,
                Cantidad = linea.Cantidad,
                PrecioUnitario = linea.PrecioUnitario,
                Descuento = linea.Descuento,
            });
        }
    }

    /// <summary>La cotización en blanco con la que arranca el formulario cuando todavía no existe.</summary>
    private static DatosCotizacion Vacia() => new(0, string.Empty, string.Empty, null, null, null, null, null,
        DateOnly.FromDateTime(DateTime.Today), false, EstadoCotizacion.Abierta, null, null, null, string.Empty, DateTimeOffset.Now, 0m, 0m, 0m, 0m, []);

    private void Volver() => Navegacion.NavigateTo("cotizaciones");

    // ---------- El cliente ----------

    /// <summary>Enter en el documento: lo busca en el maestro de clientes, igual que la lupa.</summary>
    private async Task AlTeclearDocumento(KeyboardEventArgs tecla)
    {
        if (tecla.Key is "Enter" or "NumpadEnter")
            await BuscarClienteAsync();
    }

    /// <summary>Busca el cliente con ese documento y completa nombre, teléfono y correo con los del maestro.</summary>
    private async Task BuscarClienteAsync()
    {
        if (!_editable)
            return;

        var documento = DocumentoIdentidad.Normalizar(_clienteDocumento);
        if (documento.Length == 0)
        {
            Avisos.Add("Digite la cédula o el RNC del cliente para buscarlo.", Severity.Warning);
            return;
        }

        var pagina = await Cliente.BuscarClientesCotizacionAsync(documento);
        if (pagina is null)
        {
            Avisos.Add("No se pudo consultar el maestro de clientes. Verifique la comunicación con el Central.", Severity.Error);
            return;
        }

        // La búsqueda también encuentra por código o nombre: aquí solo vale el cliente cuyo documento es exactamente ese.
        var cliente = pagina.Elementos.Select(e => e.Dato).FirstOrDefault(c => DocumentoIdentidad.Normalizar(c.Documento) == documento);
        if (cliente is null)
        {
            Avisos.Add("No hay un cliente registrado con ese documento: complete sus datos a mano.", Severity.Info);
            return;
        }

        _clienteDocumento = cliente.Documento;
        _clienteNombre = cliente.Nombre;
        _telefono = cliente.Telefono;
        _correo = cliente.Correo;
    }

    // ---------- La captura ----------

    /// <summary>Enter en el código: busca el artículo y pasa a la cantidad. Sin código, abre la búsqueda.</summary>
    private async Task AlTeclearCodigo(KeyboardEventArgs tecla)
    {
        if (tecla.Key is not ("Enter" or "NumpadEnter"))
            return;

        if (string.IsNullOrWhiteSpace(_codigo))
        {
            await BuscarEnElMaestroAsync();
            return;
        }

        var articulo = await BuscarPorCodigoAsync(_codigo.Trim());
        if (articulo is null)
        {
            // No se encontró tal cual: se abre la búsqueda con lo digitado, en vez de dejar al usuario sin salida.
            await BuscarEnElMaestroAsync(_codigo.Trim());
            return;
        }

        Tomar(articulo);
        await EnfocarAsync(_campoCantidad);
    }

    /// <summary>Enter en la cantidad: pasa al descuento, que es el último dato antes de agregar.</summary>
    private async Task AlTeclearCantidad(KeyboardEventArgs tecla)
    {
        if (tecla.Key is "Enter" or "NumpadEnter")
            await EnfocarAsync(_campoDescuento);
    }

    /// <summary>Enter en el descuento: la línea entra a la lista y todo vuelve al código, vacío.</summary>
    private async Task AlTeclearDescuento(KeyboardEventArgs tecla)
    {
        if (tecla.Key is "Enter" or "NumpadEnter")
            await AgregarAsync();
    }

    /// <summary>El artículo cuyo código se digitó: exacto por código, o el único que coincida.</summary>
    private async Task<ArticuloCarga?> BuscarPorCodigoAsync(string codigo)
    {
        var pagina = await Cliente.BuscarArticulosAsync("manager/cotizaciones", codigo, 0, 20);
        var articulos = pagina?.Elementos.Select(e => e.Dato).ToList() ?? [];

        return articulos.FirstOrDefault(a => string.Equals(a.Codigo, codigo, StringComparison.OrdinalIgnoreCase))
               ?? articulos.FirstOrDefault(a => a.CodigosBarras?.Any(b => string.Equals(b, codigo, StringComparison.OrdinalIgnoreCase)) == true)
               ?? (articulos.Count == 1 ? articulos[0] : null);
    }

    /// <summary>La búsqueda por descripción: abre el listado del maestro y vuelve con el artículo elegido.</summary>
    private async Task BuscarEnElMaestroAsync() => await BuscarEnElMaestroAsync(null);

    private async Task BuscarEnElMaestroAsync(string? textoInicial)
    {
        if (!_editable)
            return;

        var parametros = new DialogParameters<DialogoBuscarArticulo>
        {
            { d => d.Modulo, "manager/cotizaciones" },
            { d => d.TextoInicial, textoInicial },
        };
        var referencia = await Dialogos.ShowAsync<DialogoBuscarArticulo>("Buscar artículo",
            parametros, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        if (await referencia.Result is not { Canceled: false, Data: ArticuloCarga articulo })
            return;

        Tomar(articulo);
        await EnfocarAsync(_campoCantidad);
    }

    /// <summary>El artículo elegido llena la fila de captura con su código, su descripción y el precio del día.</summary>
    private void Tomar(ArticuloCarga articulo)
    {
        _codigo = articulo.Codigo;
        _descripcion = articulo.Descripcion;
        _precio = articulo.PrecioDetalle;
    }

    /// <summary>Pasa lo digitado a la lista y deja la fila lista para el siguiente artículo.</summary>
    private async Task AgregarAsync()
    {
        if (string.IsNullOrWhiteSpace(_codigo) || _descripcion.Length == 0)
        {
            Avisos.Add("Elija primero el artículo: digite su código y presione Enter, o búsquelo con la lupa.", Severity.Warning);
            await EnfocarAsync(_campoCodigo);
            return;
        }

        // Dejar la cantidad vacía es lo más común: una unidad.
        var cantidad = _cantidad ?? 1m;
        if (cantidad <= 0)
        {
            Avisos.Add("La cantidad tiene que ser mayor que cero.", Severity.Warning);
            await EnfocarAsync(_campoCantidad);
            return;
        }

        _lineas.Insert(0, new LineaEnEdicion
        {
            Codigo = _codigo.Trim(),
            Descripcion = _descripcion,
            Cantidad = cantidad,
            PrecioUnitario = _precio,
            Descuento = _descuento ?? 0m,
        });

        _codigo = null;
        _descripcion = string.Empty;
        _cantidad = null;
        _precio = 0m;
        _descuento = null;
        await EnfocarAsync(_campoCodigo);
    }

    /// <summary>El foco salta solo de un campo al siguiente: la idea es no tocar el mouse mientras se digita.</summary>
    private static async Task EnfocarAsync(MudTextField<string?>? campo)
    {
        if (campo is { } destino)
            await destino.FocusAsync();
    }

    private static async Task EnfocarAsync(MudNumericField<decimal?>? campo)
    {
        if (campo is { } destino)
            await destino.FocusAsync();
    }

    // ---------- Guardar y las demás acciones ----------

    private async Task GuardarAsync()
    {
        // Las líneas se guardan en el orden en que se digitaron, aunque en pantalla la última esté arriba.
        var lineas = Enumerable.Reverse(_lineas)
            .Where(l => !string.IsNullOrWhiteSpace(l.Codigo) && l.Cantidad > 0)
            .Select(l => new SolicitudLineaCotizacion(l.Codigo.Trim(), l.Cantidad, l.PrecioUnitario, l.Descuento))
            .ToList();

        var solicitud = new SolicitudCotizacion(_clienteNombre, _clienteDocumento, _telefono, _correo, null,
            _venceEn is { } vence ? DateOnly.FromDateTime(vence) : null, _observacion, lineas);

        _guardando = true;
        var respuesta = CotizacionId is { } id
            ? await Cliente.ActualizarCotizacionAsync(id, solicitud)
            : await Cliente.CrearCotizacionAsync(solicitud);
        _guardando = false;

        if (!respuesta.Exitosa)
        {
            Avisos.Add(respuesta.Mensaje ?? "No se pudo guardar la cotización.", Severity.Error);
            return;
        }

        Avisos.Add(CotizacionId is null ? "Cotización creada." : "Cotización actualizada.", Severity.Success);
        Volver();
    }

    private async Task AnularAsync(int cotizacionId)
    {
        var parametros = new DialogParameters<DialogoMotivo>
        {
            { d => d.Mensaje, "La cotización deja de poder facturarse. No se borra: queda para consulta con su motivo." },
            { d => d.Etiqueta, "Motivo de la anulación" },
            { d => d.TextoConfirmar, "Anular" },
        };
        var referencia = await Dialogos.ShowAsync<DialogoMotivo>("Anular la cotización", parametros);
        if (await referencia.Result is not { Canceled: false, Data: string motivo })
            return;

        var respuesta = await Cliente.AnularCotizacionAsync(cotizacionId, motivo);
        if (!respuesta.Exitosa)
        {
            Avisos.Add(respuesta.Mensaje ?? "No se pudo anular la cotización.", Severity.Error);
            return;
        }

        Avisos.Add("Cotización anulada.", Severity.Success);
        Volver();
    }

    /// <summary>Descarga el PDF en carta para entregárselo o enviárselo al cliente.</summary>
    private async Task ImprimirAsync(int cotizacionId)
    {
        var archivo = await Cliente.DescargarCotizacionAsync(cotizacionId);
        if (archivo is not { } generado)
        {
            Avisos.Add("No se pudo generar el documento.", Severity.Error);
            return;
        }

        await Js.InvokeVoidAsync("cgCentral.descargarArchivo", generado.Nombre, generado.TipoContenido, Convert.ToBase64String(generado.Contenido));
    }

    /// <summary>Fila del formulario mientras se arma la cotización.</summary>
    private sealed class LineaEnEdicion
    {
        public string Codigo { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public decimal Cantidad { get; set; } = 1m;
        public decimal PrecioUnitario { get; set; }
        public decimal Descuento { get; set; }

        public decimal Importe => Math.Max(0m, decimal.Round(Cantidad * PrecioUnitario, 2, MidpointRounding.AwayFromZero) - Descuento);
    }
}
