{
  "Caja": {
    "ValidarIpDelEquipo": 0
  },
  // Los periféricos están en appsettings.json, que se lee en desarrollo y en producción: son del equipo, no del
  // entorno. Si en desarrollo quiere trabajar sin terminal ni impresora, descomente esto y vuelva a arrancar.
  //"Perifericos": {
  //  "Terminal": { "Tipo": "Simulado" },
  //  "Impresora": { "Tipo": "Archivo", "Carpeta": "C:\\CGPOS\\impresiones" }
  //},
  "Ecf": {
    "CarpetaXml": "logs/ecf",
    "CarpetaXsd": "../../../datos/xsd",
    "Certificado": {
      // Solo en desarrollo: si el archivo no existe se crea uno autofirmado y se carga con este PIN. La DGII no lo
      // acepta. En producción no se pone PinDesarrollo: el PIN lo digita un usuario y vive solo en memoria.
      "Ruta": "C:\\CGPOS\\Agente\\logs/certificado-desarrollo.p12",
      "PinDesarrollo": "1234"
    }
  },
  "Pantallas": {
    "CarpetaPublicidad": "../../../datos/publicidad"
  },
  "Serilog": {
    "WriteTo": {
      "1": { 
        "Args": {
          "path": "C:\\CGPOS\\Agente\\logs/agente-.log"
        }
      }
    }
  }
}
