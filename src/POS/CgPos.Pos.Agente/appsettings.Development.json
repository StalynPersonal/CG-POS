{
  "Caja": {
    "ValidarIpDelEquipo": 0
  },
  // Periféricos de esta caja. Cada uno se elige con su "Tipo"; si se escribe uno que no existe, el Agente avisa en el
  // log al arrancar y se queda con el simulado.
  "Perifericos": {
    // Balanza:Tipo → Simulada (devuelve el peso de aquí abajo) · Serie (balanza conectada; pide Puerto y Modelo)
    "BalanzaSimulada": {
      "Peso": "2.345",
      "Unidad": "LB"
    },
    // Terminal:Tipo → Simulado (aprueba solo, con estos datos) · Conectado (terminal real; Modelo CardNet usa su
    // protocolo ECR, cualquier otro el perfil genérico)
    "TerminalSimulado": {
      "RetardoMs": 1200,
      "Marca": "VISA",
      "UltimosDigitos": "4242",
      "Bin": "455123"
    },
    "Impresora": {
      // Tipo → Archivo (deja el ticket en "Carpeta", sin impresora) · Red (térmica de red: pide "Host" y "Puerto",
      //        9100 si no se indica) · Windows (impresora instalada por USB o compartida: pide "Nombre")
      "Tipo": "Archivo",
      "Carpeta": "logs/impresiones"
    }
  },
  "Ecf": {
    "CarpetaXml": "logs/ecf",
    "CarpetaXsd": "../../../datos/xsd",
    "Certificado": {
      // Solo en desarrollo: si el archivo no existe se crea uno autofirmado y se carga con este PIN. La DGII no lo
      // acepta. En producción no se pone PinDesarrollo: el PIN lo digita un usuario y vive solo en memoria.
      "Ruta": "logs/certificado-desarrollo.p12",
      "PinDesarrollo": "1234"
    }
  },
  "Pantallas": {
    "CarpetaPublicidad": "../../../datos/publicidad"
  },
  "Serilog": {
    "WriteTo": {
      "1": { 
        "Args": {
          "path": "logs/agente-.log"
        }
      }
    }
  }
}
