{
  "Caja": {
    "ValidarIpDelEquipo": 0
  },
  // Periféricos de esta caja. Cada uno se elige con su "Tipo"; si se escribe uno que no existe, el Agente avisa en el
  // log al arrancar y se queda con el simulado.
  "Perifericos": {
    // La balanza conectada se configura en su propia sección "Balanza", al lado de esta:
    //   "Balanza": { "Tipo": "Serie", "Puerto": "COM3", "Modelo": "Torrey" }
    // Tipo → Simulada (devuelve el peso de aquí abajo, sin balanza) · Serie (balanza por puerto serie)
    "BalanzaSimulada": {
      "Peso": "2.345",
      "Unidad": "LB"
    },
    // Terminal de pago. Manda "Tipo": Simulado usa los datos de "TerminalSimulado"; Conectado habla con el equipo real.
    // Para volver al simulador basta con cambiar esta línea a "Simulado"; lo demás se puede quedar donde está.
    // Los datos son los que traía el POS anterior en C:\CGPOS\Setup.ini, sección [CardnetRD_EPaySettings].
    // El terminal está conectado directo por RJ45 y solo habla dentro de su subred: este equipo tiene que tener una
    // dirección 10.12.3.x en la tarjeta Ethernet (se probó con 10.12.3.141).
    "Terminal": {
      "Tipo": "Conectado",
      "Modelo": "CardNet",
      "Host": "10.12.3.140",
      "Puerto": 7060,
      "IdMultiMerchant": "",
      "ConsultaTarjeta": "true"
    },
    // Con Tipo Simulado, el terminal aprueba solo y devuelve estos datos. Por serie sería:
    //   "Terminal": { "Tipo": "Conectado", "Modelo": "Generico", "Puerto": "COM4", "Baudios": 115200 }
    "TerminalSimulado": {
      "RetardoMs": 1200,
      "Marca": "VISA",
      "UltimosDigitos": "4242",
      "Bin": "455123"
    },
    // Las claves de la impresora van todas aquí dentro, al lado de "Tipo". Según el tipo que elija:
    //   "Tipo": "Archivo",  "Carpeta": "logs/impresiones"          (sin impresora: deja el ticket en archivos)
    //   "Tipo": "Red",      "Host": "192.168.1.50", "Puerto": 9100 (térmica de red; 9100 si no se indica el puerto)
    //   "Tipo": "Windows",  "Nombre": "EPSON TM-T20"               (impresora instalada, por USB o compartida)
    "Impresora": {
      "Tipo": "Archivo",
      "Carpeta": "C:\\CGPOS\\impresiones"
    }
  },
  "Ecf": {
    "CarpetaXml": "logs/ecf",
    "CarpetaXsd": "../../../datos/xsd",
    "Certificado": {
      // Solo en desarrollo: si el archivo no existe se crea uno autofirmado y se carga con este PIN. La DGII no lo
      // acepta. En producción no se pone PinDesarrollo: el PIN lo digita un usuario y vive solo en memoria.
      "Ruta": "C:\\CGPOS\\Agente\\logs/certificado-desarrollo.p12",
      "PinDesarrollo": "1234"
    }
  },
  "Pantallas": {
    "CarpetaPublicidad": "../../../datos/publicidad"
  },
  "Serilog": {
    "WriteTo": {
      "1": { 
        "Args": {
          "path": "C:\\CGPOS\\Agente\\logs/agente-.log"
        }
      }
    }
  }
}
