{
  "ConnectionStrings": {
    "BaseDatosPos": "Server=.\\SQLEXPRESS;Database=CgPosCaja;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "BaseDatos": {
    "NivelCompatibilidad": 150
  },
  "Caja": {
    "Id": ""
  },
  "Ecf": {
    "Ambiente": ""
  },
  "Central": {
    "Modo": "",
    "Url": "",
    "Secreto": "",
    "CarpetaSimulada": "C:\\CGPOS\\CentralSimulado"
  },
  "Sincronizacion": {
    "IntervaloSegundos": 30,
    "TamanoLote": 50,
    "EsperaInicialSegundos": 30,
    "EsperaMaximaSegundos": 3600,
    "TiempoEsperaSegundos": 30
  },
  "Mantenimiento": {
    "IntervaloMinutos": 60
  },
  "Respaldo": {
    "Carpeta": "",
    "Hora": 22
  },
  "Reloj": {
    "ServidorNtp": "time.windows.com"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5180"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\CGPOS\\Logs\\agente-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 20971520,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
