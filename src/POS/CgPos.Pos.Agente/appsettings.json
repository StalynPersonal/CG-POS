{
  "ConnectionStrings": {
    "BaseDatosPos": "Server=.;Database=CgPosCaja;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "BaseDatos": {
    "NivelCompatibilidad": 150
  },
  "Caja": {
    // 1 exige que el equipo tenga la dirección IP registrada para esa caja; 0 no la comprueba (solo para pruebas).
    "ValidarIpDelEquipo": 1
  },
  "Central": {
    // Modo → vacío (habla con el Central de verdad, por la dirección que se configuró en la caja) ·
    //        Simulado (no hay Central: los mensajes se dejan en "CarpetaSimulada", para probar sin servidor)
    "Modo": "",
    "CarpetaSimulada": "C:\\CGPOS\\CentralSimulado"
  },
  "Respaldo": {
    "Carpeta": ""
  },
  // Periféricos de esta caja. Van aquí y no en el archivo de desarrollo porque son del equipo, no del entorno: la caja
  // instalada como servicio no lee appsettings.Development.json, y con esta sección fuera se quedaba con el terminal y
  // la impresora simulados sin que nadie se enterara. Cada uno se elige con su "Tipo"; si se escribe uno que no existe,
  // el Agente lo avisa en el log al arrancar y en /salud, y se queda con el simulado.
  "Perifericos": {
    // Terminal de pago. Manda "Tipo":
    //   Conectado → la caja le habla al equipo; "Modelo" dice cuál: CardNet o Generico (mensajes de texto,
    //               que se ajustan con plantillas en esta misma sección).
    //   Simulado  → aprueba solo, con los datos de "TerminalSimulado". Para probar sin equipo.
    //   Ninguno   → esta caja no tiene terminal: se cobra con una forma de pago que pide el número de aprobación.
    // El terminal se conecta directo por RJ45 y solo habla dentro de su subred: este equipo tiene que tener una
    // dirección de esa misma red en su tarjeta Ethernet, y el terminal tiene que tenerla autorizada.
    // Para comprobarlo sin abrir la caja: scripts\caja\probar-terminal-cardnet.ps1
    "Terminal": {
      "Tipo": "Conectado",
      "Modelo": "CardNet",
      "Host": "10.12.3.140",
      "Puerto": 7060,
      "IdMultiMerchant": "",
      "ConsultaTarjeta": "true"
    },
    // Con Tipo Simulado, el terminal aprueba solo y devuelve estos datos. Por serie sería:
    //   "Terminal": { "Tipo": "Conectado", "Modelo": "Generico", "Puerto": "COM4", "Baudios": 115200 }
    "TerminalSimulado": {
      "RetardoMs": 1200,
      "Marca": "VISA",
      "UltimosDigitos": "4242",
      "Bin": "455123"
    },
    // La balanza conectada se configura en su propia sección "Balanza", al lado de esta:
    //   "Balanza": { "Tipo": "Serie", "Puerto": "COM3", "Modelo": "Torrey" }
    // Tipo → Simulada (devuelve el peso de aquí abajo, sin balanza) · Serie (balanza por puerto serie)
    "BalanzaSimulada": {
      "Peso": "2.345",
      "Unidad": "LB"
    },
    // Las claves de la impresora van todas aquí dentro, al lado de "Tipo". Según el tipo que elija:
    //   "Tipo": "Archivo",  "Carpeta": "C:\\CGPOS\\impresiones"      (sin impresora: deja el ticket en archivos)
    //   "Tipo": "Red",      "Host": "192.168.1.50", "Puerto": 9100 (térmica de red; 9100 si no se indica el puerto)
    //   "Tipo": "Windows",  "Nombre": "EPSON TM-T20"               (impresora instalada, por USB o compartida)
    "Impresora": {
      "Tipo": "Archivo",
      "Carpeta": "C:\\CGPOS\\impresiones"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5180"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\CGPOS\\Agente\\Logs\\agente-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 20971520,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
