@page "/"
@implements IDisposable
@inject AtajosTecladoService Atajos
@inject IDialogService Dialogos
@inject ISnackbar Avisos

@* Vitrina temporal del kit visual (Fase C0 · Paso 2). Se reemplaza por la pantalla de venta en la Fase C3. *@

<PageTitle>CG-POS · Vitrina del kit visual</PageTitle>

<div style="display: flex; flex-direction: column; height: 100vh">

    <MudAppBar Elevation="0" Fixed="false">
        <MudText Typo="Typo.h5" Style="font-weight: 700">CG-POS</MudText>
        <MudText Typo="Typo.subtitle1" Class="ml-3" Style="opacity: .85">Vitrina del kit visual · Fase C0</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Icon="@Icons.Material.Filled.WifiOff">Sin conexión (demo)</MudChip>
    </MudAppBar>

    <div style="flex: 1; overflow: auto; padding: 16px; display: grid; grid-template-columns: 2fr 1fr; gap: 16px">

        <div style="display: flex; flex-direction: column; gap: 16px">
            <MudPaper Elevation="0" Class="pa-4" Style="background: var(--cg-surface); display: flex; justify-content: space-between; align-items: end">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Última tecla</MudText>
                    <MudText Typo="Typo.h4">@(_ultimaTecla ?? "—")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary">
                        Cultura: @System.Globalization.CultureInfo.CurrentCulture.Name · @DateTime.Today.ToString("d") · @(850m.ToString("C"))
                    </MudText>
                </div>
                <div style="text-align: right">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Total (RD$)</MudText>
                    <div class="cg-total-grande">@_lineas.Where(l => !l.Anulada).Sum(l => l.Subtotal).ToString("N2")</div>
                </div>
            </MudPaper>

            <GrillaTactil TItem="LineaDemo" Items="_lineas" @bind-Seleccionado="_seleccionada" EsAnulada="l => l.Anulada" Altura="320px">
                <Encabezado>
                    <MudTh>Ln</MudTh>
                    <MudTh>Código</MudTh>
                    <MudTh>Descripción</MudTh>
                    <MudTh Class="cg-numero">Cant.</MudTh>
                    <MudTh Class="cg-numero">Precio</MudTh>
                    <MudTh Class="cg-numero">Subtotal</MudTh>
                </Encabezado>
                <Fila>
                    <MudTd>@context.Linea</MudTd>
                    <MudTd>@context.Codigo</MudTd>
                    <MudTd>@context.Descripcion</MudTd>
                    <MudTd Class="cg-numero">@context.Cantidad.ToString("N2")</MudTd>
                    <MudTd Class="cg-numero">@context.Precio.ToString("N2")</MudTd>
                    <MudTd Class="cg-numero">@context.Subtotal.ToString("N2")</MudTd>
                </Fila>
            </GrillaTactil>

            <div style="display: flex; gap: 12px">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" OnClick="ProbarDialogo">Probar diálogo</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" OnClick='() => Avisos.Add("Aviso de prueba", Severity.Success)'>Probar aviso</MudButton>
            </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 8px">
            <MudTextField T="string" @bind-Value="_entrada" Label="Entrada" Variant="Variant.Outlined" ReadOnly="true" />
            <TecladoTactil @bind-Valor="_entrada" AlConfirmar="AlConfirmarTeclado" />
        </div>
    </div>

    <BarraTeclasFuncion>
        <PaginaPrincipal>
            <TeclaFuncion Atajo="F2" Texto="Buscar" Icono="@Icons.Material.Filled.Search" OnClick='() => Registrar("F2")' />
            <TeclaFuncion Atajo="F3" Texto="Límite" Icono="@Icons.Material.Filled.Speed" OnClick='() => Registrar("F3")' />
            <TeclaFuncion Atajo="F4" Texto="Cantidad" Icono="@Icons.Material.Filled.Numbers" OnClick='() => Registrar("F4")' />
            <TeclaFuncion Atajo="F5" Texto="Balanza" Icono="@Icons.Material.Filled.Scale" OnClick='() => Registrar("F5")' />
            <TeclaFuncion Atajo="F6" Texto="Reintegro" Icono="@Icons.Material.Filled.Autorenew" OnClick='() => Registrar("F6")' />
            <TeclaFuncion Atajo="F7" Texto="Espera" Icono="@Icons.Material.Filled.PanTool" OnClick='() => Registrar("F7")' />
            <TeclaFuncion Atajo="F8" Texto="Totalizar" Icono="@Icons.Material.Filled.Calculate" EsAccionPrincipal="true" OnClick='() => Registrar("F8")' />
            <TeclaFuncion Atajo="F9" Texto="Suspender" Icono="@Icons.Material.Filled.DesktopAccessDisabled" Deshabilitada="true" />
            <TeclaFuncion Atajo="F10" Texto="Devolver" Icono="@Icons.Material.Filled.Undo" Deshabilitada="true" />
            <TeclaFuncion Atajo="F11" Texto="Precios" Icono="@Icons.Material.Filled.LocalOffer" OnClick='() => Registrar("F11")' />
            <TeclaFuncion Atajo="F12" Texto="Clientes" Icono="@Icons.Material.Filled.Person" OnClick='() => Registrar("F12")' />
        </PaginaPrincipal>
        <PaginaSecundaria>
            <TeclaFuncion Texto="Desc. línea" Icono="@Icons.Material.Filled.Percent" />
            <TeclaFuncion Texto="Desc. factura" Icono="@Icons.Material.Filled.Discount" />
            <TeclaFuncion Texto="Comentario" Icono="@Icons.Material.Filled.Comment" />
            <TeclaFuncion Texto="Pendiente" Icono="@Icons.Material.Filled.LocalShipping" />
            <TeclaFuncion Texto="Gaveta" Icono="@Icons.Material.Filled.PointOfSale" />
            <TeclaFuncion Texto="Limpiar" Icono="@Icons.Material.Filled.ClearAll" />
        </PaginaSecundaria>
    </BarraTeclasFuncion>
</div>

@code {
    private sealed record LineaDemo(int Linea, string Codigo, string Descripcion, decimal Cantidad, decimal Precio, bool Anulada = false)
    {
        public decimal Subtotal => Anulada ? -Cantidad * Precio : Cantidad * Precio;
    }

    private readonly List<LineaDemo> _lineas =
    [
        new(1, "7891114119695", "Cincel de Punta SDS MAX 5/8\"x11\" Tramon", 1, 720.34m),
        new(2, "7501031311309", "Cemento gris 42.5 kg", 3, 485.00m),
        new(3, "7501031311309", "Cemento gris 42.5 kg", 1, 485.00m, Anulada: true),
    ];

    private LineaDemo? _seleccionada;
    private string _entrada = string.Empty;
    private string? _ultimaTecla;

    protected override void OnInitialized() => Atajos.TeclaPresionada += AlPresionarTecla;

    private Task AlPresionarTecla(string tecla)
    {
        Registrar(tecla);
        return InvokeAsync(StateHasChanged);
    }

    private void Registrar(string tecla) => _ultimaTecla = tecla;

    private void AlConfirmarTeclado(string valor) => Avisos.Add($"Confirmado: {valor}", Severity.Info);

    private async Task ProbarDialogo()
    {
        var confirmado = await Dialogos.ConfirmarAsync("Limpiar pantalla", "¿Desea eliminar todas las líneas de la factura?", "Limpiar", esPeligrosa: true);
        Avisos.Add(confirmado ? "Confirmó" : "Canceló", confirmado ? Severity.Warning : Severity.Normal);
    }

    public void Dispose() => Atajos.TeclaPresionada -= AlPresionarTecla;
}
