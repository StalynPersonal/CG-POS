@* Facturas en espera del cajero en su turno (F7): poner la actual en espera o retomar una (RF-22, RF-197). *@
@inject ClienteAgente Cliente

@* Sin barra de desplazamiento: si la pantalla es baja, las teclas se achican para que la lista, la referencia y el teclado quepan. *@
<MudDialog Class="cg-dialogo-ajustado">
    <DialogContent>
        @if (_cargando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
        }
        else
        {
            <GrillaTactil TElemento="DatosVentaEnEspera" Elementos="_enEspera" Seleccionado="_seleccionada" SeleccionadoChanged="venta => _seleccionada = venta"
                          Altura="@(TieneArticulos ? "clamp(120px, calc(100vh - 640px), 300px)" : "clamp(160px, calc(100vh - 380px), 420px)")"
                          TextoSinRegistros="No hay facturas en espera en su turno">
                <Encabezado>
                    <MudTh>Referencia</MudTh>
                    <MudTh>Cliente</MudTh>
                    <MudTh Class="cg-numero">Líneas</MudTh>
                    <MudTh Class="cg-numero">Total</MudTh>
                    <MudTh>Desde</MudTh>
                </Encabezado>
                <Fila Context="venta">
                    <MudTd>@venta.Referencia</MudTd>
                    <MudTd>@(venta.ClienteNombre ?? "Cliente contado")</MudTd>
                    <MudTd Class="cg-numero">@venta.CantidadLineas</MudTd>
                    <MudTd Class="cg-numero">@venta.Total.ToString("N2")</MudTd>
                    <MudTd>@venta.PuestaEnEsperaEn.ToLocalTime().ToString("h:mm tt")</MudTd>
                </Fila>
            </GrillaTactil>

            @* La venta en pantalla se guarda con un nombre del cajero: todavía no tiene número de factura. Se escribe con el
               teclado físico o con el de la pantalla, que es el que hay en la caja táctil. *@
            @if (TieneArticulos)
            {
                <div class="cg-dialogo-teclado mt-3">
                    <MudTextField @bind-Value="_referencia" Label="Referencia de la venta actual (nombre del cliente o unos dígitos)"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="40" Immediate="true" AutoFocus="true" Class="cg-campo-activo"
                                  HelperText="Con ella la encuentra al volver. Se pide también al retomar otra, para guardar esta." />
                    <TecladoTactil Valor="@(_referencia ?? string.Empty)" ValorChanged="valor => _referencia = valor" AlConfirmar="_ => PonerEnEsperaAsync()"
                                   Modo="ModoTeclado.Alfanumerico" PermitirDecimal="false" LongitudMaxima="40" TextoConfirmar="Poner en espera" />
                </div>
            }
        }

        @if (_mensaje is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@_mensaje</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" Variant="Variant.Outlined" Style="min-height: var(--cg-toque-minimo); min-width: 140px" OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
        <MudButton Size="Size.Large" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_procesando || !TieneArticulos || string.IsNullOrWhiteSpace(_referencia))"
                   StartIcon="@Icons.Material.Filled.PanTool" Style="min-height: var(--cg-toque-minimo)" OnClick="PonerEnEsperaAsync">Poner la actual en espera</MudButton>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(_procesando || _seleccionada is null)"
                   StartIcon="@Icons.Material.Filled.PlayArrow" Style="min-height: var(--cg-toque-minimo); min-width: 140px" OnClick="RetomarAsync">Retomar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired] public DatosVenta Venta { get; set; } = default!;

    private IReadOnlyList<DatosVentaEnEspera> _enEspera = [];
    private DatosVentaEnEspera? _seleccionada;
    private string? _mensaje;
    private string? _referencia;
    private bool _cargando = true;
    private bool _procesando;

    private bool TieneArticulos => Venta.Lineas.Any(linea => !linea.Anulada);

    protected override async Task OnInitializedAsync()
    {
        _enEspera = await Cliente.ListarEnEsperaAsync();
        _seleccionada = _enEspera.Count > 0 ? _enEspera[0] : null;
        _cargando = false;
    }

    private Task PonerEnEsperaAsync() => EjecutarAsync(() => Cliente.PonerEnEsperaAsync(Venta.Id, _referencia ?? string.Empty));

    private Task RetomarAsync() => _seleccionada is { } venta ? EjecutarAsync(() => Cliente.RetomarVentaAsync(venta.Id, _referencia)) : Task.CompletedTask;

    private async Task EjecutarAsync(Func<Task<RespuestaVenta>> operacion)
    {
        _procesando = true;
        var respuesta = await operacion();
        _procesando = false;

        if (respuesta is { Exitosa: true, Venta: { } venta })
        {
            Dialogo.Close(DialogResult.Ok(venta));
            return;
        }

        _mensaje = respuesta.Mensaje;
    }
}
