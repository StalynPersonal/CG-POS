@* Caja suspendida (RF-23): la pantalla queda bloqueada hasta que el mismo cajero digite su clave. La venta en curso se conserva. *@
@implements IDisposable
@inject ClienteAgente Cliente

<div class="cg-turno">
    <MudPaper Elevation="2" Class="cg-turno__tarjeta">
        @* El tiempo parado, en grande: es el dato que importa mientras la caja está sola. *@
        <div class="cg-suspension">
            <div class="cg-suspension__conteo">@Transcurrido</div>
            <div class="cg-suspension__linea">
                <MudText Typo="Typo.h5" Style="font-weight: 600">@Encabezado</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Caja suspendida desde las @Desde.ToString("h:mm tt")</MudText>
                @if (!string.IsNullOrWhiteSpace(_suspension?.Nota))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_suspension!.Nota</MudText>
                }
            </div>
        </div>

        @if (_mensaje is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4 mt-4">@_mensaje</MudAlert>
        }

        @* Para regresar, el mismo cajero digita su clave: así el tiempo parado queda a su nombre y nadie más retoma su venta. *@
        <div class="cg-turno__formulario mt-4">
            <div class="cg-turno__fondo">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">Clave de @NombreUsuario para regresar</MudText>
                <MudTextField T="string" Value="_clave" ValueChanged="valor => _clave = valor" InputType="InputType.Text" Variant="Variant.Outlined"
                              Immediate="true" AutoFocus="true" OnKeyDown="AlTeclearAsync" Style="-webkit-text-security: disc" Class="cg-campo-clave cg-campo-activo" />
                <div class="cg-turno__acciones">
                    <MudButton Variant="Variant.Outlined" Size="Size.Large" OnClick="AlSalir" Disabled="_procesando" Class="cg-turno__boton"
                               StartIcon="@Icons.Material.Filled.SwitchAccount">Cambiar de usuario</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" OnClick="ReanudarAsync" Disabled="_procesando" Class="cg-turno__boton"
                               StartIcon="@Icons.Material.Filled.LockOpen">Regresar</MudButton>
                </div>
                @if (_procesando)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
                }
            </div>
            <TecladoTactil @bind-Valor="_clave" AlConfirmar="_ => ReanudarAsync()" Modo="ModoTeclado.Alfanumerico" PermitirDecimal="false" PermitirCambioModo="true" LongitudMaxima="64" TextoConfirmar="Regresar" />
        </div>
    </MudPaper>
</div>

@code {
    [Parameter, EditorRequired] public string CodigoUsuario { get; set; } = string.Empty;
    [Parameter] public string? NombreUsuario { get; set; }
    [Parameter] public EventCallback AlReanudar { get; set; }
    [Parameter] public EventCallback AlSalir { get; set; }

    private readonly CancellationTokenSource _cancelacion = new();
    private readonly DateTimeOffset _abierto = DateTimeOffset.Now;
    private DatosSuspension? _suspension;
    private TimeSpan _transcurrido;
    private string _clave = string.Empty;
    private string? _mensaje;
    private bool _procesando;
    private bool _terminado;

    /// <summary>Quién dejó la caja y por qué. La caja no se nombra: ya se sabe en cuál se está parado.</summary>
    private string Encabezado => _suspension is { } suspension
        ? $"{suspension.UsuarioNombre} · {suspension.MotivoNombre}"
        : NombreUsuario ?? string.Empty;

    private DateTimeOffset Desde => _suspension?.SuspendidaEn.ToLocalTime() ?? _abierto;

    private string Transcurrido => _transcurrido.TotalHours >= 1
        ? $"{(int)_transcurrido.TotalHours}:{_transcurrido.Minutes:00}:{_transcurrido.Seconds:00}"
        : $"{_transcurrido.Minutes:00}:{_transcurrido.Seconds:00}";

    protected override async Task OnInitializedAsync()
    {
        _suspension = await Cliente.ObtenerSuspensionAsync(_cancelacion.Token);
        _ = ContarAsync();
    }

    /// <summary>
    /// El conteo corre contra la hora en que se suspendió, no contra un contador propio: si la pantalla se recarga, sigue
    /// cuadrando. Va suelto, sin nadie que lo espere, así que no puede dejar escapar ninguna excepción: la pantalla la
    /// mostraría como «ocurrió un error inesperado» y taparía la caja entera por un reloj.
    /// </summary>
    private async Task ContarAsync()
    {
        try
        {
            using var temporizador = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (!_terminado && await temporizador.WaitForNextTickAsync(_cancelacion.Token))
            {
                _transcurrido = DateTimeOffset.Now - Desde;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception excepcion) when (excepcion is OperationCanceledException or ObjectDisposedException)
        {
            // La pantalla se cerró mientras el reloj esperaba su turno: no hay nada que contar ni que avisar.
        }
    }

    private Task AlTeclearAsync(KeyboardEventArgs evento) => evento.Key == "Enter" ? ReanudarAsync() : Task.CompletedTask;

    private async Task ReanudarAsync()
    {
        if (_procesando || string.IsNullOrEmpty(_clave))
            return;

        _procesando = true;
        var respuesta = await Cliente.IngresarAsync(CodigoUsuario, _clave);
        _procesando = false;
        _clave = string.Empty;

        if (respuesta.Exitoso)
        {
            // Cerrar el rato parado es lo último: si falla, el cajero no se queda fuera de su caja.
            await Cliente.ReanudarCajaAsync();
            await AlReanudar.InvokeAsync();
            return;
        }

        _mensaje = respuesta.Mensaje ?? "Clave incorrecta.";
    }

    public void Dispose()
    {
        // Primero se marca terminado y después se cancela: así el ciclo sale por su propia condición aunque la cancelación
        // llegue justo entre dos vueltas.
        _terminado = true;
        _cancelacion.Cancel();
        _cancelacion.Dispose();
    }
}
