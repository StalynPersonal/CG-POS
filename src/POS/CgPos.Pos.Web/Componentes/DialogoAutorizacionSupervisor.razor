@* Autorización de supervisor para una operación que el usuario no tiene permitida. Se abre con ServicioAutorizacionPantalla. *@
@inject ClienteAgente Cliente

@* Sin barra de desplazamiento: si la pantalla es baja, las teclas se achican para que los campos y el teclado se vean juntos. *@
<MudDialog Class="cg-dialogo-ajustado">
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
            Esta operación requiere autorización de un supervisor: <strong>@DescripcionOperacion</strong>
        </MudAlert>

        @* El motivo también se escribe con el teclado en pantalla: al tocarlo queda como campo activo. *@
        <div @onclick="() => _campo = CampoActivo.Motivo" @onfocusin="() => _campo = CampoActivo.Motivo">
            <MudTextField T="string" @bind-Value="_motivo" Label="Motivo" Variant="Variant.Outlined" MaxLength="500" Immediate="true"
                          Class="@($"mb-2 {ClaseCampo(CampoActivo.Motivo)}")" />
        </div>

        <div class="cg-autorizacion__pin">
            <div class="cg-autorizacion__campos">
                <div @onclick="() => _campo = CampoActivo.Codigo" @onfocusin="() => _campo = CampoActivo.Codigo">
                    <MudTextField T="string" @bind-Value="_codigo" Label="Usuario del supervisor" Variant="Variant.Outlined"
                                  Immediate="true" Class="@ClaseCampo(CampoActivo.Codigo)" />
                </div>
                <div @onclick="() => _campo = CampoActivo.Clave" @onfocusin="() => _campo = CampoActivo.Clave">
                    <MudTextField T="string" @bind-Value="_clave" Label="Clave" InputType="InputType.Text" Variant="Variant.Outlined"
                                  Immediate="true" Class="@($"cg-campo-clave {ClaseCampo(CampoActivo.Clave)}")" OnKeyDown="AlTeclearClaveAsync" />
                </div>
            </div>
            <TecladoTactil Valor="@ValorCampoActivo" ValorChanged="AlCambiarTeclado" AlConfirmar="AlConfirmarTecladoAsync"
                           Modo="ModoTeclado.Alfanumerico" PermitirDecimal="false" PermitirCambioModo="true"
                           LongitudMaxima="@(_campo switch { CampoActivo.Motivo => 500, CampoActivo.Clave => 64, _ => 20 })"
                           TextoConfirmar="@(_campo == CampoActivo.Clave ? "Autorizar" : "Siguiente")" />
        </div>

        @if (_procesando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="mt-3" />
        }
        @if (_mensaje is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_mensaje</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" Variant="Variant.Outlined" Style="min-height: var(--cg-toque-minimo); min-width: 140px" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Secondary" Disabled="_procesando"
                   Style="min-height: var(--cg-toque-minimo); min-width: 140px" OnClick="AutorizarAsync">Autorizar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private enum CampoActivo
    {
        Motivo,
        Codigo,
        Clave,
    }

    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired] public string Permiso { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string DescripcionOperacion { get; set; } = string.Empty;
    [Parameter] public string? TipoEntidad { get; set; }
    [Parameter] public string? EntidadId { get; set; }

    /// <summary>Pedir clave de un nivel superior aunque el usuario tenga el permiso (ej. descuento que excede su tope).</summary>
    [Parameter] public bool ForzarSupervisor { get; set; }

    private string? _motivo;
    private string? _codigo;
    private string? _clave;
    private string? _mensaje;
    private CampoActivo _campo = CampoActivo.Motivo;
    private bool _procesando;

    private string ValorCampoActivo => _campo switch
    {
        CampoActivo.Motivo => _motivo,
        CampoActivo.Codigo => _codigo,
        _ => _clave,
    } ?? string.Empty;

    private string? ClaseCampo(CampoActivo campo) => _campo == campo ? "cg-campo-activo" : null;

    private void AlCambiarTeclado(string valor)
    {
        switch (_campo)
        {
            case CampoActivo.Motivo:
                _motivo = valor;
                break;
            case CampoActivo.Codigo:
                _codigo = valor;
                break;
            default:
                _clave = valor;
                break;
        }
    }

    /// <summary>El Enter del teclado va de campo en campo (motivo, usuario, clave) y en la clave autoriza.</summary>
    private Task AlConfirmarTecladoAsync(string _)
    {
        switch (_campo)
        {
            case CampoActivo.Motivo:
                _campo = CampoActivo.Codigo;
                return Task.CompletedTask;
            case CampoActivo.Codigo:
                _campo = CampoActivo.Clave;
                return Task.CompletedTask;
            default:
                return AutorizarAsync();
        }
    }

    private Task AlTeclearClaveAsync(KeyboardEventArgs evento) =>
        evento.Key == "Enter" ? AutorizarAsync() : Task.CompletedTask;

    private async Task AutorizarAsync()
    {
        if (_procesando)
            return;

        if (string.IsNullOrWhiteSpace(_motivo))
        {
            _mensaje = "Debe indicar el motivo.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_codigo) || string.IsNullOrEmpty(_clave))
        {
            _mensaje = "Indique el usuario y la clave del supervisor.";
            return;
        }

        var solicitud = new SolicitudAutorizacion(Permiso, _motivo, _codigo.Trim(), _clave, TipoEntidad, EntidadId, ForzarSupervisor);

        _procesando = true;
        _mensaje = null;
        var respuesta = await Cliente.SolicitarAutorizacionAsync(solicitud);
        _procesando = false;

        if (respuesta.Concedida)
        {
            Dialogo.Close(DialogResult.Ok(respuesta));
            return;
        }

        _mensaje = respuesta.Mensaje ?? "Autorización denegada.";
        _clave = string.Empty;
    }

    private void Cancelar() => Dialogo.Cancel();
}
