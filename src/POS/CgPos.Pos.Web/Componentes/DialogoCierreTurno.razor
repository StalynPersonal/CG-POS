@* Cierre de turno (M13): la cajera no declara ni cuenta. Cierra el lote de tarjetas, cierra el turno con autorización del
   supervisor y entrega el dinero con el cuadre impreso; el supervisor lo cuadra después en el Central (RF-9, RN-23).
   El pre-cierre imprime lo esperado con clave de supervisor (RF-8). *@
@using CgPos.Dominio.Pagos
@using CgPos.Dominio.Turnos
@inject ClienteAgente Cliente
@inject ServicioAutorizacionPantalla Autorizaciones

<MudDialog>
    <DialogContent>
        @if (_mensaje is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_mensaje</MudAlert>
        }
        @if (_aviso is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@_aviso</MudAlert>
        }

        @if (_cierre is { } cierre)
        {
            @* Turno cerrado: lo que sigue es entregar. La cajera no ve montos. *@
            <div class="cg-cierre__resultado">
                <div class="cg-cierre__titulo">Turno @cierre.TurnoNumero cerrado · @cierre.UsuarioNombre</div>
                <MudText Typo="Typo.body1" Class="mt-2">
                    Cuente su efectivo y entréguelo al supervisor junto con el comprobante del lote de tarjetas y el cuadre
                    que acaba de imprimirse.
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    El supervisor lo cuadra en el Central. Si el cuadre no salió, use Reimprimir.
                </MudText>
            </div>
        }
        else if (_resumen is null)
        {
            @if (_mensaje is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
            }
        }
        else
        {
            @if (_bloqueos.Count > 0)
            {
                @* Lo que impide cerrar: facturas en espera, ventas en curso o sin e-CF (RF-265, RN-22). *@
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    <strong>No se puede cerrar todavía:</strong>
                    <ul class="cg-cierre__bloqueos">
                        @foreach (var bloqueo in _bloqueos)
                        {
                            <li>@bloqueo</li>
                        }
                    </ul>
                </MudAlert>
            }

            @* Los pasos del cierre, en orden, para que la cajera sepa qué sigue. *@
            <div class="cg-cierre__resultado">
                <div class="cg-cierre__titulo">Turno @_resumen.Turno.Numero · @_resumen.Turno.UsuarioActualNombre</div>
                <ol class="cg-cierre__bloqueos">
                    <li>Cierre el lote del terminal de tarjetas.</li>
                    <li>Cierre el turno: pide la clave del supervisor e imprime el cuadre, que es para él.</li>
                    <li>Cuente su efectivo y entrégueselo con el comprobante del lote.</li>
                </ol>
                @if (_resumen.TotalRetiros > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Retiros del turno: @_resumen.TotalRetiros.ToString("C") (@_resumen.Movimientos.Count(m => m.Tipo == TipoMovimientoCaja.Retiro))
                    </MudText>
                }
                @if (_resumen.MuestraEsperado)
                {
                    @* Solo con permiso de pre-cierre: la cajera no ve los montos. *@
                    <div class="cg-tabla-desplazable mt-2">
                        <table class="cg-cierre__tabla">
                            <thead>
                                <tr><th>Forma de pago</th><th>Trx</th><th>Esperado</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var forma in _resumen.FormasPago)
                                {
                                    <tr>
                                        <td>@forma.Nombre@MonedaTexto(forma.Moneda)</td>
                                        <td>@(forma.Transacciones ?? 0)</td>
                                        <td>@((forma.Esperado ?? 0m).ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (_cierre is null)
        {
            <MudButton Size="Size.Large" Variant="Variant.Outlined" Disabled="_procesando" Style="min-height: var(--cg-toque-minimo); min-width: 140px"
                       OnClick="() => Dialogo.Cancel()">Cancelar</MudButton>
            <MudButton Size="Size.Large" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_procesando || _resumen is null)" StartIcon="@Icons.Material.Filled.ReceiptLong"
                       Style="min-height: var(--cg-toque-minimo)" OnClick="PreCierreAsync">Pre-cierre</MudButton>
            <MudButton Size="Size.Large" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_procesando || _resumen is null)" StartIcon="@Icons.Material.Filled.CreditCard"
                       Style="min-height: var(--cg-toque-minimo)" OnClick="ConciliarTarjetasAsync">Cerrar lote</MudButton>
            <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(_procesando || _resumen is null)" StartIcon="@Icons.Material.Filled.LockClock"
                       Style="min-height: var(--cg-toque-minimo); min-width: 200px; font-size: 1.1rem" OnClick="CerrarAsync">Cerrar turno</MudButton>
        }
        else
        {
            <MudButton Size="Size.Large" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" Disabled="_procesando"
                       Style="min-height: var(--cg-toque-minimo)" OnClick="ReimprimirAsync">Reimprimir</MudButton>
            <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Secondary" Style="min-height: var(--cg-toque-minimo); min-width: 200px"
                       OnClick="() => Dialogo.Close(DialogResult.Ok(_respuestaCierre))">Terminar</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    private DatosResumenTurno? _resumen;
    private DatosCierre? _cierre;
    private RespuestaCaja? _respuestaCierre;
    private IReadOnlyList<string> _bloqueos = [];
    private string? _mensaje;
    private string? _aviso;
    private bool _procesando;

    protected override async Task OnInitializedAsync()
    {
        var respuesta = await Cliente.ObtenerResumenTurnoAsync();
        if (!respuesta.Exitosa || respuesta.Resumen is null)
        {
            _mensaje = respuesta.Mensaje ?? "No se pudo obtener el turno.";
            return;
        }

        _resumen = respuesta.Resumen;
        _bloqueos = _resumen.Bloqueos;
    }

    /// <summary>Imprime lo esperado con clave de supervisor, antes de cerrar (RF-8).</summary>
    private async Task PreCierreAsync()
    {
        _procesando = true;
        _mensaje = null;
        _aviso = null;
        var respuesta = await Autorizaciones.EjecutarCajaAsync(autorizacion => Cliente.PreCierreAsync(autorizacion),
            $"Pre-cierre del turno {_resumen!.Turno.Numero}");
        _procesando = false;
        if (respuesta is null)
            return;

        if (respuesta.Resumen is { } resumen)
        {
            _resumen = resumen;
            _bloqueos = resumen.Bloqueos;
        }

        _aviso = respuesta.Exitosa ? respuesta.Mensaje : null;
        _mensaje = respuesta.Exitosa ? null : respuesta.Mensaje;
    }

    /// <summary>Cierra el lote del terminal y muestra si las tarjetas del turno cuadran con lo que reportó (RF-215).</summary>
    private async Task ConciliarTarjetasAsync()
    {
        _procesando = true;
        _mensaje = null;
        _aviso = null;
        var conciliacion = await Cliente.ConciliarTarjetasAsync();
        _procesando = false;

        if (conciliacion is null)
        {
            _mensaje = "No se pudo cerrar el lote del terminal.";
            return;
        }

        var lote = conciliacion.NumeroLote is { Length: > 0 } numero ? $"Lote {numero}. " : string.Empty;
        var caja = $"En caja {conciliacion.TransaccionesCaja} tarjeta(s) por {conciliacion.MontoCaja:C}.";

        if (!conciliacion.LoteCerrado)
            _mensaje = $"{conciliacion.Mensaje} {caja}";
        else if (!conciliacion.DetalleDelTerminal)
            _aviso = $"{lote}{caja} {conciliacion.Mensaje}";
        else if (conciliacion.Cuadra)
            _aviso = $"{lote}{caja} El terminal reporta lo mismo: cuadra.";
        else
            _mensaje = $"{lote}{caja} El terminal reporta {conciliacion.TransaccionesTerminal} por {conciliacion.MontoTerminal:C}: "
                + $"diferencia de {conciliacion.Diferencia:C}."
                + (conciliacion.SoloEnCaja.Count > 0 ? $" Solo en la caja: {string.Join(", ", conciliacion.SoloEnCaja)}." : string.Empty)
                + (conciliacion.SoloEnTerminal.Count > 0 ? $" Solo en el terminal: {string.Join(", ", conciliacion.SoloEnTerminal)}." : string.Empty);
    }

    private async Task CerrarAsync()
    {
        _procesando = true;
        _mensaje = null;
        _aviso = null;

        var respuesta = await Autorizaciones.EjecutarCajaAsync(autorizacion => Cliente.CerrarTurnoAsync(autorizacion), $"Cerrar el turno {_resumen!.Turno.Numero}");
        _procesando = false;
        if (respuesta is null)
            return;

        if (respuesta.Resultado == CodigoResultadoCaja.CierreBloqueado)
        {
            // La lista de bloqueos ya explica por qué no se cierra.
            _bloqueos = respuesta.Bloqueos ?? [];
            return;
        }

        if (!respuesta.Exitosa)
        {
            _mensaje = respuesta.Mensaje;
            return;
        }

        _respuestaCierre = respuesta;
        _cierre = respuesta.Cierre;
        _aviso = respuesta.Mensaje;
    }

    private async Task ReimprimirAsync()
    {
        _procesando = true;
        var respuesta = await Cliente.ReimprimirCierreAsync(_cierre!.Id);
        _procesando = false;
        _aviso = respuesta.Exitosa ? respuesta.Mensaje : null;
        _mensaje = respuesta.Exitosa ? null : respuesta.Mensaje;
    }

    /// <summary>Marca las formas de pago en moneda extranjera; la moneda local no se indica.</summary>
    private string MonedaTexto(string moneda) => moneda == (_cierre?.Moneda ?? _resumen?.MonedaLocal) ? string.Empty : $" ({moneda})";
}
