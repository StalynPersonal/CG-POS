@* Catálogo visual en mosaicos para artículos sin código a mano (vegetales, panadería…). Devuelve el código elegido. *@
@inject ClienteAgente Cliente

<MudDialog>
    <DialogContent>
        <div class="cg-catalogo">
            <div class="cg-catalogo__familias">
                <button type="button" class="cg-catalogo__familia @(_familia is null ? "cg-catalogo__familia--activa" : null)" @onclick="() => _familia = null">Todos</button>
                @foreach (var familia in _familias)
                {
                    <button type="button" class="cg-catalogo__familia @(familia == _familia ? "cg-catalogo__familia--activa" : null)" @onclick="() => _familia = familia">@familia</button>
                }
            </div>

            @if (_cargando)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
            }
            else if (!Visibles.Any())
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="pa-6">No hay artículos en el catálogo.</MudText>
            }
            else
            {
                <div class="cg-catalogo__mosaicos">
                    @foreach (var articulo in Visibles)
                    {
                        <button type="button" class="cg-catalogo__mosaico" @onclick="() => Dialogo.Close(DialogResult.Ok(articulo.Codigo))">
                            <div class="cg-catalogo__imagen">
                                @if (EsImagenWeb(articulo.RutaImagen))
                                {
                                    <img src="@articulo.RutaImagen" alt="" />
                                }
                                else
                                {
                                    <span>@Iniciales(articulo.Descripcion)</span>
                                }
                            </div>
                            <div class="cg-catalogo__descripcion">@articulo.Descripcion</div>
                            <div class="cg-catalogo__precio">@(articulo.PrecioDetalle?.ToString("N2") ?? "Sin precio") <small>/ @articulo.UnidadMedidaCodigo</small></div>
                        </button>
                    }
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" Variant="Variant.Outlined" Style="min-height: var(--cg-toque-minimo); min-width: 140px" OnClick="() => Dialogo.Cancel()">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    private IReadOnlyList<DatosArticuloResumen> _articulos = [];
    private IReadOnlyList<string> _familias = [];
    private string? _familia;
    private bool _cargando = true;

    private IEnumerable<DatosArticuloResumen> Visibles => _familia is null ? _articulos : _articulos.Where(a => a.FamiliaNombre == _familia);

    protected override async Task OnInitializedAsync()
    {
        _articulos = await Cliente.ListarCatalogoAsync();
        _familias = _articulos.Select(a => a.FamiliaNombre).Distinct().Order(StringComparer.CurrentCulture).ToList();
        _cargando = false;
    }

    /// <summary>Solo se muestran imágenes servidas por web; las rutas locales de SAP no son accesibles desde la pantalla.</summary>
    private static bool EsImagenWeb(string? ruta) =>
        ruta is not null && (ruta.StartsWith('/') || ruta.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || ruta.StartsWith("https://", StringComparison.OrdinalIgnoreCase));

    private static string Iniciales(string descripcion) =>
        string.Concat(descripcion.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(palabra => char.ToUpperInvariant(palabra[0])));
}
