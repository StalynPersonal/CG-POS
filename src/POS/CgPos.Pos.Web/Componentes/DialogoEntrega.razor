@* Entrega posterior de mercancía (M12): cada línea, completa o en parte, se marca para retiro en una sucursal o envío a dirección (RF-246 a RF-250).
   Marcar pendientes requiere clave de supervisor (RF-53); los serializados no piden serial hasta el despacho (RN-16). *@
@using System.Globalization
@inject ClienteAgente Cliente
@inject ServicioAutorizacionPantalla Autorizaciones

<MudDialog>
    <DialogContent>
        <div class="cg-cliente">
            @if (_venta.DestinosEntrega is { Count: > 0 } destinos)
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">Destinos de la transacción @_venta.NumeroTransaccion</MudText>
                @foreach (var destino in destinos)
                {
                    <div class="cg-cliente__actual">
                        <div>
                            <MudText Typo="Typo.h6" Style="font-weight: 700">
                                @(destino.Metodo == MetodoEntrega.Envio ? $"Envío a {destino.Direccion}" : $"Retiro en {destino.SucursalRetiroNombre}")
                            </MudText>
                            <MudText Typo="Typo.body2">
                                @string.Join(" · ", destino.Lineas.Select(l => $"{Descripcion(l.NumeroLinea)} × {l.Cantidad:0.###}"))
                                @if (destino.FechaComprometida is { } fecha)
                                {
                                    <span> · para el @fecha.ToString("dd/MM/yyyy")</span>
                                }
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Large" Disabled="_procesando" OnClick="() => QuitarAsync(destino.Numero)"
                                   StartIcon="@Icons.Material.Filled.Delete" Style="min-height: var(--cg-toque-minimo)">Quitar</MudButton>
                    </div>
                }
            }

            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Nuevo destino</MudText>
            <div class="cg-cliente__comprobantes">
                <button type="button" class="cg-cliente__comprobante @(_metodo == MetodoEntrega.RetiroSucursal ? "cg-cliente__comprobante--activo" : null)"
                        @onclick="() => _metodo = MetodoEntrega.RetiroSucursal">
                    <MudIcon Icon="@Icons.Material.Filled.Store" /><span>Retiro en sucursal</span>
                </button>
                <button type="button" class="cg-cliente__comprobante @(_metodo == MetodoEntrega.Envio ? "cg-cliente__comprobante--activo" : null)"
                        @onclick="() => _metodo = MetodoEntrega.Envio">
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" /><span>Envío a dirección</span>
                </button>
            </div>

            @if (_metodo == MetodoEntrega.RetiroSucursal)
            {
                @* La sucursal de esta caja viene elegida; se puede cambiar si el cliente retira en otra tienda. *@
                <div class="cg-descuento__motivos">
                    @foreach (var sucursal in _sucursales)
                    {
                        <button type="button" class="cg-catalogo__departamento @(sucursal.Id == _sucursalRetiroId ? "cg-catalogo__departamento--activa" : null)"
                                @onclick="() => _sucursalRetiroId = sucursal.Id">@sucursal.Nombre</button>
                    }
                </div>
                @if (_sucursales.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No hay sucursales activas. Se definen en el Central.</MudAlert>
                }
            }
            else
            {
                <div class="cg-cliente__campos">
                    <MudTextField T="string" @bind-Value="_direccion" Label="Dirección" Variant="Variant.Outlined" Immediate="true" />
                    <MudTextField T="string" @bind-Value="_sector" Label="Sector" Variant="Variant.Outlined" Immediate="true" />
                    <MudTextField T="string" @bind-Value="_ciudad" Label="Ciudad o provincia" Variant="Variant.Outlined" Immediate="true" />
                </div>
                <div class="cg-cliente__campos">
                    <MudTextField T="string" @bind-Value="_referencia" Label="Referencia" Variant="Variant.Outlined" Immediate="true" />
                    <MudTextField T="string" @bind-Value="_telefono" Label="Teléfono de contacto" Variant="Variant.Outlined" Immediate="true" />
                    <MudTextField T="string" @bind-Value="_transportista" Label="Transportista" Variant="Variant.Outlined" Immediate="true" />
                    <MudTextField T="string" @bind-Value="_costo" Label="@($"Costo de envío ({MonedaPantalla.Simbolo})")" Variant="Variant.Outlined" Immediate="true" />
                </div>
            }

            <div class="cg-cliente__campos">
                <MudDatePicker @bind-Date="_fecha" Label="Fecha comprometida" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" MinDate="DateTime.Today" />
                <MudTextField T="string" @bind-Value="_comentario" Label="Comentario" Variant="Variant.Outlined" Immediate="true" />
            </div>

            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Artículos y cantidades (lo que no se marque se despacha en caja)</MudText>
            <div class="cg-descuento__lineas">
                @foreach (var linea in LineasMarcables)
                {
                    <div class="cg-descuento__linea">
                        <span class="cg-descuento__linea-texto">
                            @linea.NumeroLinea · @linea.Descripcion
                            <small>Disponible @Disponible(linea).ToString("0.###") @linea.UnidadMedidaCodigo@(linea.SerialPendiente ? " · serial al entregar" : null)</small>
                        </span>
                        <MudNumericField T="decimal" Value="@Cantidad(linea.NumeroLinea)" ValueChanged="valor => _cantidades[linea.NumeroLinea] = valor" Min="0m" Max="@Disponible(linea)"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 140px" />
                    </div>
                }
            </div>

            @if (_procesando)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
            }
            @if (_mensaje is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@_mensaje</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" Variant="Variant.Outlined" Style="min-height: var(--cg-toque-minimo); min-width: 140px"
                   OnClick="() => Dialogo.Close(DialogResult.Ok(_venta))">Listo</MudButton>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Secondary" Disabled="_procesando" StartIcon="@Icons.Material.Filled.Inventory"
                   Style="min-height: var(--cg-toque-minimo); min-width: 200px" OnClick="MarcarAsync">Marcar pendiente</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired] public DatosVenta Venta { get; set; } = default!;

    /// <summary>Línea seleccionada en la venta: se propone completa.</summary>
    [Parameter] public int? NumeroLinea { get; set; }

    private readonly Dictionary<int, decimal> _cantidades = [];
    private DatosVenta _venta = default!;
    private IReadOnlyList<DatosSucursalRetiro> _sucursales = [];
    private MetodoEntrega _metodo = MetodoEntrega.RetiroSucursal;
    private int? _sucursalRetiroId;
    private string? _direccion;
    private string? _sector;
    private string? _ciudad;
    private string? _referencia;
    private string? _telefono;
    private string? _transportista;
    private string? _costo;
    private DateTime? _fecha;
    private string? _comentario;
    private string? _mensaje;
    private bool _procesando;

    protected override async Task OnInitializedAsync()
    {
        _venta = Venta;
        _sucursales = await Cliente.ListarSucursalesRetiroAsync();
        _sucursalRetiroId = _sucursales.FirstOrDefault(s => s.EsDeLaCaja)?.Id ?? _sucursales.FirstOrDefault()?.Id;
        if (NumeroLinea is { } numero && LineasMarcables.FirstOrDefault(l => l.NumeroLinea == numero) is { } linea)
            _cantidades[numero] = Disponible(linea);
    }

    private IEnumerable<DatosLineaVenta> LineasMarcables =>
        _venta.Lineas.Where(l => !l.Anulada && Disponible(l) > 0);

    private static decimal Disponible(DatosLineaVenta linea) => linea.Cantidad - linea.CantidadEnEntrega;

    private decimal Cantidad(int numeroLinea) => _cantidades.GetValueOrDefault(numeroLinea);

    private string Descripcion(int numeroLinea) => _venta.Lineas.FirstOrDefault(l => l.NumeroLinea == numeroLinea)?.Descripcion ?? $"Línea {numeroLinea}";

    private async Task MarcarAsync()
    {
        var lineas = _cantidades.Where(c => c.Value > 0).Select(c => new CantidadEntrega(c.Key, c.Value)).ToList();
        if (lineas.Count == 0)
        {
            _mensaje = "Indique la cantidad de al menos un artículo.";
            return;
        }

        decimal? costo = null;
        if (!string.IsNullOrWhiteSpace(_costo))
        {
            if (!decimal.TryParse(_costo, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var valor))
            {
                _mensaje = "El costo del envío no es un monto válido.";
                return;
            }

            costo = valor;
        }

        var envio = _metodo == MetodoEntrega.Envio
            ? new DatosEnvio(_direccion ?? string.Empty, _sector, _ciudad, _referencia, _telefono ?? string.Empty, _transportista, costo)
            : null;
        var solicitud = new SolicitudMarcarEntrega(_metodo, _metodo == MetodoEntrega.RetiroSucursal ? _sucursalRetiroId : null, envio,
            _fecha is { } fecha ? DateOnly.FromDateTime(fecha) : null, _comentario, lineas);

        await EjecutarAsync(() => Autorizaciones.EjecutarVentaAsync(
            autorizacion => Cliente.MarcarEntregaAsync(_venta.Id, solicitud with { AutorizacionId = autorizacion }),
            _metodo == MetodoEntrega.Envio ? "Marcar mercancía para envío" : "Marcar mercancía para retiro",
            _venta.NumeroTransaccion));
    }

    private Task QuitarAsync(int numero) => EjecutarAsync(async () => await Cliente.QuitarEntregaAsync(_venta.Id, numero));

    private async Task EjecutarAsync(Func<Task<RespuestaVenta?>> operacion)
    {
        if (_procesando)
            return;

        _procesando = true;
        var respuesta = await operacion();
        _procesando = false;
        if (respuesta is null)
            return;

        if (respuesta.Venta is { } venta)
            _venta = venta;

        _mensaje = respuesta.Exitosa ? null : respuesta.Mensaje;
        if (respuesta.Exitosa)
            _cantidades.Clear();
    }
}
