@* Cliente, comprobante y programa de fidelidad de la venta (F12): RNC o cédula contra los clientes, que bajan del Central (RF-13, RF-127);
   la cédula del miembro como ID/PIN, con inscripción sin interrumpir la venta (RF-126, RF-236, RF-237). *@
@inject ClienteAgente Cliente
@inject ServicioAutorizacionPantalla Autorizaciones

<MudDialog>
    <DialogContent>
        <div class="cg-cliente">
            @* Todo lo que se llena, en una sola columna; el teclado va al lado y no empuja nada hacia abajo. *@
            <div class="cg-cliente__formulario">
                <div class="cg-cliente__actual">
                    <div>
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary">Cliente de la transacción @_venta.NumeroTransaccion</MudText>
                        @if (_venta.Cliente is { } cliente)
                        {
                            <MudText Typo="Typo.h6" Style="font-weight: 700">@cliente.Nombre</MudText>
                            <MudText Typo="Typo.body2">
                                @NombreDocumento(cliente.TipoDocumento) @cliente.Documento · @(cliente.ClienteId is null ? "no registrado" : "cliente registrado")
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6" Style="font-weight: 700; color: #6d7a74">CLIENTE CONTADO</MudText>
                        }
                    </div>
                    @if (_venta.Cliente is not null)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Large" Disabled="_procesando" OnClick="QuitarAsync"
                                   StartIcon="@Icons.Material.Filled.PersonRemove" Style="min-height: var(--cg-toque-minimo)">Quitar cliente</MudButton>
                    }
                </div>

                <MudText Typo="Typo.subtitle2" Color="Color.Primary">Comprobante fiscal</MudText>
                <div class="cg-cliente__comprobantes">
                    @foreach (var tipo in ReglasComprobante.DeVenta)
                    {
                        <button type="button" class="cg-cliente__comprobante @(tipo == _venta.TipoComprobante ? "cg-cliente__comprobante--activo" : null)"
                                disabled="@_procesando" @onclick="() => CambiarComprobanteAsync(tipo)">
                            <span class="cg-cliente__codigo-ecf">E@((int)tipo)</span>
                            <span>@ReglasComprobante.Nombre(tipo)</span>
                        </button>
                    }
                </div>

                @* Gubernamental (E45): con la certificación de exención que presente la entidad, la factura va sin ITBIS. *@
                @if (_venta.TipoComprobante == TipoComprobante.Gubernamental)
                {
                    <div class="cg-cliente__exencion">
                        @* Se escribe también con el teclado en pantalla: al tocarlo queda como campo activo. *@
                        <div @onclick="() => _campo = Campo.Certificacion" @onfocusin="() => _campo = Campo.Certificacion">
                            <MudTextField T="string" @bind-Value="_certificacion" Label="Certificación de exención de ITBIS (opcional)" Variant="Variant.Outlined"
                                          MaxLength="50" Immediate="true" Disabled="_procesando" Class="@ClaseCampo(Campo.Certificacion)"
                                          HelperText="Número del documento que presentó la entidad. Con él, la factura se emite exenta." />
                        </div>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_procesando" OnClick="GuardarCertificacionAsync"
                                   Style="min-height: var(--cg-toque-minimo)">
                            @(_venta.ExentaDeImpuesto ? "Actualizar" : "Aplicar exención")
                        </MudButton>
                        @if (_venta.ExentaDeImpuesto)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="_procesando" OnClick="QuitarCertificacionAsync">Quitar</MudButton>
                        }
                    </div>
                }

                <div class="cg-cliente__campos">
                    <div @onclick="() => _campo = Campo.Documento" @onfocusin="() => _campo = Campo.Documento">
                        <MudTextField T="string" @bind-Value="_documento" Label="RNC o cédula" Variant="Variant.Outlined" Immediate="true"
                                      AutoFocus="true" OnKeyDown="AlTeclearAsync" Class="@ClaseCampo(Campo.Documento)" />
                    </div>
                    @if (_pedirNombre)
                    {
                        <div @onclick="() => _campo = Campo.Nombre" @onfocusin="() => _campo = Campo.Nombre">
                            <MudTextField T="string" @bind-Value="_nombre" Label="Nombre del cliente" Variant="Variant.Outlined" Immediate="true"
                                          OnKeyDown="AlTeclearAsync" Class="@ClaseCampo(Campo.Nombre)" />
                        </div>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" Disabled="_procesando" OnClick="AsignarAsync"
                               StartIcon="@Icons.Material.Filled.PersonSearch" Style="min-height: var(--cg-toque-minimo)">Asignar</MudButton>
                </div>

                <MudText Typo="Typo.subtitle2" Color="Color.Primary">Programa de fidelidad</MudText>
                @if (_venta.Fidelidad is { } fidelidad)
                {
                    <div class="cg-cliente__actual">
                        <div>
                            <MudText Typo="Typo.h6" Style="font-weight: 700">★ @fidelidad.Nombre@(fidelidad.Nivel is null ? null : $" · {fidelidad.Nivel}")</MudText>
                            <MudText Typo="Typo.body2">
                                Cédula @fidelidad.Cedula
                                @if (_miembro is { } miembro)
                                {
                                    <span> · @miembro.SaldoDisponible.ToString("N0") puntos disponibles</span>
                                    @if (miembro.ProximoVencimiento is { } vence && miembro.PuntosPorVencer > 0)
                                    {
                                        <span> · @miembro.PuntosPorVencer.ToString("N0") vencen el @vence.ToString("dd/MM/yyyy")</span>
                                    }
                                }
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Large" Disabled="_procesando" OnClick="QuitarFidelidadAsync"
                                   StartIcon="@Icons.Material.Filled.StarBorder" Style="min-height: var(--cg-toque-minimo)">Quitar miembro</MudButton>
                    </div>
                }
                else
                {
                    <div class="cg-cliente__campos">
                        <div @onclick="() => _campo = Campo.Cedula" @onfocusin="() => _campo = Campo.Cedula">
                            <MudTextField T="string" @bind-Value="_cedula" Label="Cédula o tarjeta de fidelidad" Variant="Variant.Outlined" Immediate="true"
                                          OnKeyDown="AlTeclearFidelidadAsync" Class="@ClaseCampo(Campo.Cedula)" />
                        </div>
                        @if (_inscribir)
                        {
                            <div @onclick="() => _campo = Campo.NombreMiembro" @onfocusin="() => _campo = Campo.NombreMiembro">
                                <MudTextField T="string" @bind-Value="_nombreMiembro" Label="Nombre (vacío = el del cliente registrado)" Variant="Variant.Outlined" Immediate="true"
                                              Class="@ClaseCampo(Campo.NombreMiembro)" />
                            </div>
                            <div @onclick="() => _campo = Campo.Telefono" @onfocusin="() => _campo = Campo.Telefono">
                                <MudTextField T="string" @bind-Value="_telefono" Label="Teléfono" Variant="Variant.Outlined" Immediate="true" Class="@ClaseCampo(Campo.Telefono)" />
                            </div>
                            <div @onclick="() => _campo = Campo.Correo" @onfocusin="() => _campo = Campo.Correo">
                                <MudTextField T="string" @bind-Value="_correo" Label="Correo" Variant="Variant.Outlined" Immediate="true" Class="@ClaseCampo(Campo.Correo)" />
                            </div>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" Disabled="_procesando" OnClick="AsignarFidelidadAsync"
                                   StartIcon="@Icons.Material.Filled.Stars" Style="min-height: var(--cg-toque-minimo)">@(_inscribir ? "Inscribir y asignar" : "Asignar")</MudButton>
                    </div>
                }

                @if (_procesando)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Secondary" />
                }
                @if (_mensaje is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">@_mensaje</MudAlert>
                }

            </div>

            @* El teclado, a la mano y siempre a la vista: escribe en el campo que esté activo. *@
            <aside class="cg-cliente__teclado">
                <TecladoTactil Valor="@ValorCampoActivo" ValorChanged="AlCambiarTeclado" AlConfirmar="_ => ConfirmarAsync()"
                               Modo="@(CampoNumerico ? ModoTeclado.Numerico : ModoTeclado.Alfanumerico)" PermitirDecimal="false"
                               PermitirCambioModo="@(!CampoNumerico)" LongitudMaxima="@LongitudCampo" TextoConfirmar="Asignar" />
            </aside>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" Style="min-height: var(--cg-toque-minimo); min-width: 160px"
                   OnClick="() => Dialogo.Close(DialogResult.Ok(_venta))">Listo</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private enum Campo
    {
        Certificacion,
        Documento,
        Nombre,
        Cedula,
        NombreMiembro,
        Telefono,
        Correo,
    }

    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired] public DatosVenta Venta { get; set; } = default!;

    private readonly Dictionary<Campo, string?> _valores = [];
    private DatosVenta _venta = default!;
    private DatosMiembroFidelidad? _miembro;
    private string? _mensaje;
    private bool _pedirNombre;
    private bool _inscribir;
    private bool _procesando;
    private Campo _campo = Campo.Documento;
    private string? _certificacion { get => _valores.GetValueOrDefault(Campo.Certificacion); set => _valores[Campo.Certificacion] = value; }

    private string? _documento { get => _valores.GetValueOrDefault(Campo.Documento); set => _valores[Campo.Documento] = value; }
    private string? _nombre { get => _valores.GetValueOrDefault(Campo.Nombre); set => _valores[Campo.Nombre] = value; }
    private string? _cedula { get => _valores.GetValueOrDefault(Campo.Cedula); set => _valores[Campo.Cedula] = value; }
    private string? _nombreMiembro { get => _valores.GetValueOrDefault(Campo.NombreMiembro); set => _valores[Campo.NombreMiembro] = value; }
    private string? _telefono { get => _valores.GetValueOrDefault(Campo.Telefono); set => _valores[Campo.Telefono] = value; }
    private string? _correo { get => _valores.GetValueOrDefault(Campo.Correo); set => _valores[Campo.Correo] = value; }

    protected override async Task OnInitializedAsync()
    {
        _venta = Venta;
        _certificacion = _venta.CertificacionExencion;
        await CargarMiembroAsync();
    }

    private string ValorCampoActivo => _valores.GetValueOrDefault(_campo) ?? string.Empty;

    private bool CampoNumerico => _campo is Campo.Documento or Campo.Cedula or Campo.Telefono;

    private int LongitudCampo => _campo switch
    {
        Campo.Documento or Campo.Cedula => 13,
        Campo.Telefono => 20,
        Campo.Certificacion => 50,
        _ => 150,
    };

    private bool CampoDeFidelidad => _campo is Campo.Cedula or Campo.NombreMiembro or Campo.Telefono or Campo.Correo;

    private string? ClaseCampo(Campo campo) => _campo == campo ? "cg-campo-activo" : null;

    private static string NombreDocumento(TipoDocumentoIdentidad? tipo) => tipo switch
    {
        TipoDocumentoIdentidad.Rnc => "RNC",
        TipoDocumentoIdentidad.Cedula => "Cédula",
        TipoDocumentoIdentidad.Pasaporte => "Pasaporte",
        _ => "Documento",
    };

    private void AlCambiarTeclado(string valor) => _valores[_campo] = valor;

    private Task ConfirmarAsync() => _campo == Campo.Certificacion
        ? GuardarCertificacionAsync()
        : CampoDeFidelidad ? AsignarFidelidadAsync() : AsignarAsync();

    private Task AlTeclearAsync(KeyboardEventArgs evento) => evento.Key == "Enter" ? AsignarAsync() : Task.CompletedTask;

    private Task AlTeclearFidelidadAsync(KeyboardEventArgs evento) => evento.Key == "Enter" ? AsignarFidelidadAsync() : Task.CompletedTask;

    private async Task AsignarAsync()
    {
        if (string.IsNullOrWhiteSpace(_documento))
        {
            _mensaje = "Digite el RNC o la cédula del cliente.";
            _campo = Campo.Documento;
            return;
        }

        await EjecutarAsync(async () => await Cliente.AsignarClienteAsync(_venta.Id, _documento.Trim(), _pedirNombre ? _nombre : null));
    }

    private Task QuitarAsync() => EjecutarAsync(async () => await Cliente.QuitarClienteAsync(_venta.Id));

    /// <summary>Asigna el miembro por su cédula; si no está inscrito se piden sus datos y se inscribe en el mismo paso.</summary>
    private async Task AsignarFidelidadAsync()
    {
        if (string.IsNullOrWhiteSpace(_cedula))
        {
            _mensaje = "Digite o escanee la cédula del miembro.";
            _campo = Campo.Cedula;
            return;
        }

        if (_inscribir)
        {
            _procesando = true;
            var inscripcion = await Cliente.InscribirFidelidadAsync(new SolicitudInscripcionFidelidad(_cedula.Trim(), Vacio(_nombreMiembro), Vacio(_telefono), Vacio(_correo)));
            _procesando = false;
            if (inscripcion is { Exitosa: false, Resultado: not CodigoResultadoFidelidad.YaInscrito })
            {
                _mensaje = inscripcion.Mensaje;
                if (inscripcion.Resultado == CodigoResultadoFidelidad.NombreRequerido)
                    _campo = Campo.NombreMiembro;
                return;
            }
        }

        await EjecutarAsync(async () => await Cliente.AsignarFidelidadAsync(_venta.Id, _cedula.Trim()));
    }

    private Task QuitarFidelidadAsync() => EjecutarAsync(async () => await Cliente.QuitarFidelidadAsync(_venta.Id));

    private Task CambiarComprobanteAsync(TipoComprobante tipo)
    {
        if (tipo == _venta.TipoComprobante)
            return Task.CompletedTask;

        return EjecutarAsync(() => Autorizaciones.EjecutarVentaAsync(
            autorizacion => Cliente.CambiarComprobanteAsync(_venta.Id, tipo, autorizacion),
            $"Cambiar el comprobante a {ReglasComprobante.Nombre(tipo)}",
            _venta.NumeroTransaccion));
    }

    private Task GuardarCertificacionAsync() =>
        EjecutarAsync(() => Cliente.RegistrarCertificacionExencionAsync(_venta.Id, _certificacion)!);

    private Task QuitarCertificacionAsync()
    {
        _certificacion = null;
        return EjecutarAsync(() => Cliente.RegistrarCertificacionExencionAsync(_venta.Id, null)!);
    }

    private async Task CargarMiembroAsync() =>
        _miembro = _venta.Fidelidad is { } fidelidad ? (await Cliente.ConsultarFidelidadAsync(fidelidad.Cedula)).Miembro : null;

    private async Task EjecutarAsync(Func<Task<RespuestaVenta?>> operacion)
    {
        if (_procesando)
            return;

        _procesando = true;
        var respuesta = await operacion();
        _procesando = false;

        if (respuesta is null)
            return;

        if (respuesta.Venta is { } venta)
            _venta = venta;

        if (respuesta.Resultado == CodigoResultadoVenta.NombreRequerido)
        {
            _pedirNombre = true;
            _campo = Campo.Nombre;
        }
        else if (respuesta.Resultado == CodigoResultadoVenta.NoInscritoFidelidad)
        {
            _inscribir = true;
            _campo = Campo.NombreMiembro;
        }
        else if (respuesta.Exitosa)
        {
            _valores.Clear();
            _pedirNombre = false;
            _inscribir = false;
            _campo = Campo.Documento;
            await CargarMiembroAsync();
        }

        _mensaje = respuesta.Exitosa ? null : respuesta.Mensaje;
    }

    private static string? Vacio(string? texto) => string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();
}
