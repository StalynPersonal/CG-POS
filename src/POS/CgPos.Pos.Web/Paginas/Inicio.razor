@page "/"
@attribute [Authorize]
@implements IDisposable
@inject ServicioAtajosTeclado Atajos
@inject IDialogService Dialogos
@inject ISnackbar Avisos
@inject AlmacenSesion Almacen
@inject ClienteAgente Cliente
@inject ServicioAutorizacionPantalla Autorizaciones
@inject NavigationManager Navegacion

@* Vitrina temporal del kit visual con sesión (Fase C1). Se reemplaza por la pantalla de venta en la Fase C3. *@

<PageTitle>CG-POS · Vitrina</PageTitle>

<div style="display: flex; flex-direction: column; height: 100vh">

    <MudAppBar Elevation="0" Fixed="false">
        <MudText Typo="Typo.h5" Style="font-weight: 700">CG-POS</MudText>
        <MudText Typo="Typo.subtitle1" Class="ml-3" Style="opacity: .85">Vitrina · Fase C1</MudText>
        <MudSpacer />
        @if (Almacen.Sesion is { } sesion)
        {
            <div style="text-align: right; margin-right: 16px; line-height: 1.2">
                <div style="font-weight: 700">@sesion.Nombre</div>
                <div style="opacity: .85; font-size: .85rem">@sesion.RolNombre · Caja @sesion.CajaCodigo</div>
            </div>
        }
        <MudButton Variant="Variant.Outlined" Style="color: #fff; border-color: rgba(255,255,255,.6)"
                   StartIcon="@Icons.Material.Filled.Logout" OnClick="CerrarSesionAsync">Salir</MudButton>
    </MudAppBar>

    <div style="flex: 1; overflow: auto; padding: 16px; display: grid; grid-template-columns: 2fr 1fr; gap: 16px">

        <div style="display: flex; flex-direction: column; gap: 16px">
            <MudPaper Elevation="0" Class="pa-4" Style="background: var(--cg-superficie); display: flex; justify-content: space-between; align-items: end">
                <div>
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Última tecla</MudText>
                    <MudText Typo="Typo.h4">@(_ultimaTecla ?? "—")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary">
                        Cultura: @System.Globalization.CultureInfo.CurrentCulture.Name · @DateTime.Today.ToString("d") · @(850m.ToString("C"))
                    </MudText>
                </div>
                <div style="text-align: right">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Total (RD$)</MudText>
                    <div class="cg-total-grande">@_lineas.Where(linea => !linea.Anulada).Sum(linea => linea.Subtotal).ToString("N2")</div>
                </div>
            </MudPaper>

            <GrillaTactil TElemento="LineaDemo" Elementos="_lineas" @bind-Seleccionado="_seleccionada" EsAnulada="linea => linea.Anulada" Altura="320px">
                <Encabezado>
                    <MudTh>Ln</MudTh>
                    <MudTh>Código</MudTh>
                    <MudTh>Descripción</MudTh>
                    <MudTh Class="cg-numero">Cant.</MudTh>
                    <MudTh Class="cg-numero">Precio</MudTh>
                    <MudTh Class="cg-numero">Subtotal</MudTh>
                </Encabezado>
                <Fila Context="linea">
                    <MudTd>@linea.Linea</MudTd>
                    <MudTd>@linea.Codigo</MudTd>
                    <MudTd>@linea.Descripcion</MudTd>
                    <MudTd Class="cg-numero">@linea.Cantidad.ToString("N2")</MudTd>
                    <MudTd Class="cg-numero">@linea.Precio.ToString("N2")</MudTd>
                    <MudTd Class="cg-numero">@linea.Subtotal.ToString("N2")</MudTd>
                </Fila>
            </GrillaTactil>

            <div style="display: flex; gap: 12px; flex-wrap: wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" OnClick="ProbarDialogoAsync">Probar diálogo</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" OnClick="ProbarAutorizacionAsync">Probar autorización (eliminar línea)</MudButton>
            </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 8px">
            <MudTextField T="string" @bind-Value="_entrada" Label="Entrada" Variant="Variant.Outlined" ReadOnly="true" />
            <TecladoTactil @bind-Valor="_entrada" AlConfirmar="AlConfirmarTeclado" />
        </div>
    </div>

    <BarraTeclasFuncion>
        <PaginaPrincipal>
            <TeclaFuncion Atajo="F2" Texto="Buscar" Icono="@Icons.Material.Filled.Search" AlPresionar='() => Registrar("F2")' />
            <TeclaFuncion Atajo="F3" Texto="Límite" Icono="@Icons.Material.Filled.Speed" AlPresionar='() => Registrar("F3")' />
            <TeclaFuncion Atajo="F4" Texto="Cantidad" Icono="@Icons.Material.Filled.Numbers" AlPresionar='() => Registrar("F4")' />
            <TeclaFuncion Atajo="F5" Texto="Balanza" Icono="@Icons.Material.Filled.Scale" AlPresionar='() => Registrar("F5")' />
            <TeclaFuncion Atajo="F6" Texto="Reintegro" Icono="@Icons.Material.Filled.Autorenew" AlPresionar='() => Registrar("F6")' />
            <TeclaFuncion Atajo="F7" Texto="Espera" Icono="@Icons.Material.Filled.PanTool" AlPresionar='() => Registrar("F7")' />
            <TeclaFuncion Atajo="F8" Texto="Totalizar" Icono="@Icons.Material.Filled.Calculate" EsAccionPrincipal="true" AlPresionar='() => Registrar("F8")' />
            <TeclaFuncion Atajo="F9" Texto="Suspender" Icono="@Icons.Material.Filled.DesktopAccessDisabled" Deshabilitada="true" />
            <TeclaFuncion Atajo="F10" Texto="Devolver" Icono="@Icons.Material.Filled.Undo" Deshabilitada="true" />
            <TeclaFuncion Atajo="F11" Texto="Precios" Icono="@Icons.Material.Filled.LocalOffer" AlPresionar='() => Registrar("F11")' />
            <TeclaFuncion Atajo="F12" Texto="Clientes" Icono="@Icons.Material.Filled.Person" AlPresionar='() => Registrar("F12")' />
        </PaginaPrincipal>
        <PaginaSecundaria>
            <TeclaFuncion Texto="Desc. línea" Icono="@Icons.Material.Filled.Percent" />
            <TeclaFuncion Texto="Desc. factura" Icono="@Icons.Material.Filled.Discount" />
            <TeclaFuncion Texto="Comentario" Icono="@Icons.Material.Filled.Comment" />
            <TeclaFuncion Texto="Pendiente" Icono="@Icons.Material.Filled.LocalShipping" />
            <TeclaFuncion Texto="Gaveta" Icono="@Icons.Material.Filled.PointOfSale" />
            <TeclaFuncion Texto="Limpiar" Icono="@Icons.Material.Filled.ClearAll" />
        </PaginaSecundaria>
    </BarraTeclasFuncion>
</div>

@code {
    private sealed record LineaDemo(int Linea, string Codigo, string Descripcion, decimal Cantidad, decimal Precio, bool Anulada = false)
    {
        public decimal Subtotal => Anulada ? -Cantidad * Precio : Cantidad * Precio;
    }

    private readonly List<LineaDemo> _lineas =
    [
        new(1, "7891114119695", "Cincel de Punta SDS MAX 5/8\"x11\" Tramon", 1, 720.34m),
        new(2, "7501031311309", "Cemento gris 42.5 kg", 3, 485.00m),
        new(3, "7501031311309", "Cemento gris 42.5 kg", 1, 485.00m, Anulada: true),
    ];

    private LineaDemo? _seleccionada;
    private string _entrada = string.Empty;
    private string? _ultimaTecla;

    protected override void OnInitialized() => Atajos.TeclaPresionada += AlPresionarTecla;

    private Task AlPresionarTecla(string tecla)
    {
        Registrar(tecla);
        return InvokeAsync(StateHasChanged);
    }

    private void Registrar(string tecla) => _ultimaTecla = tecla;

    private void AlConfirmarTeclado(string valor) => Avisos.Add($"Confirmado: {valor}", Severity.Info);

    private async Task ProbarDialogoAsync()
    {
        var confirmado = await Dialogos.ConfirmarAsync("Limpiar pantalla", "¿Desea eliminar todas las líneas de la factura?", "Limpiar", esPeligrosa: true);
        Avisos.Add(confirmado ? "Confirmó" : "Canceló", confirmado ? Severity.Warning : Severity.Normal);
    }

    private async Task ProbarAutorizacionAsync()
    {
        var respuesta = await Autorizaciones.SolicitarAsync(CatalogoPermisos.EliminarLinea, "Eliminar línea de la factura");
        if (respuesta is null)
        {
            Avisos.Add("Operación cancelada.", Severity.Normal);
            return;
        }

        Avisos.Add(
            respuesta.RequirioSupervisor ? $"Autorizado por {respuesta.SupervisorNombre}." : "Autorizado con permiso propio.",
            Severity.Success);
    }

    private async Task CerrarSesionAsync()
    {
        await Cliente.CerrarSesionAsync();
        Navegacion.NavigateTo("ingreso", replace: true);
    }

    public void Dispose() => Atajos.TeclaPresionada -= AlPresionarTecla;
}
