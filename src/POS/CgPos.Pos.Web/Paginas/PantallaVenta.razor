@page "/"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Reflection
@inject ClienteAgente Cliente
@inject AlmacenSesion Almacen
@inject ServicioAtajosTeclado Atajos
@inject ServicioAutorizacionPantalla Autorizaciones
@inject IDialogService Dialogos
@inject NavigationManager Navegacion

@* Pantalla del cajero (M05): layout de la referencia en verde institucional. *@

<PageTitle>CG-POS · Venta</PageTitle>

@if (_cargando)
{
    <div class="cg-venta__cargando">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    </div>
}
else if (_venta is null)
{
    <PanelAperturaTurno Estado="_estadoTurno" Mensaje="_mensaje" Procesando="_procesando"
                        NombreUsuario="@Almacen.Sesion?.Nombre" CajaCodigo="@Almacen.Sesion?.CajaCodigo"
                        AlAbrir="AbrirTurnoAsync" AlReintentar="CargarAsync" AlSalir="SalirAsync" />
}
else if (_suspendida)
{
    <PanelSuspension CodigoUsuario="@(Almacen.Sesion?.Codigo ?? string.Empty)" NombreUsuario="@Almacen.Sesion?.Nombre" CajaCodigo="@Almacen.Sesion?.CajaCodigo"
                     AlReanudar="ReanudarAsync" AlSalir="SalirAsync" />
}
else
{
    <div class="cg-venta">
        <div class="cg-venta__barra-superior">
            <span class="cg-venta__marca-texto">CG-POS</span>
            <span class="cg-venta__marca-sub">Contreras Group</span>
            <span class="cg-espaciador"></span>
            <span>@Almacen.Sesion?.CajaNombre</span>
        </div>

        <header class="cg-venta__encabezado">
            <section class="cg-venta__bloque cg-venta__marca cg-venta__tocable" title="Cliente y comprobante (F12)" @onclick="AbrirClienteAsync">
                <div class="cg-venta__logo">CG</div>
                <div class="cg-venta__ncf">E@((int)_venta.TipoComprobante) · @ReglasComprobante.Nombre(_venta.TipoComprobante)</div>
            </section>

            <section class="cg-venta__bloque cg-venta__cliente">
                <div class="cg-venta__tocable" title="Cliente y comprobante (F12)" @onclick="AbrirClienteAsync">
                    <div class="cg-venta__etiqueta">@EtiquetaDocumento(_venta.Cliente?.TipoDocumento)</div>
                    <div class="cg-venta__valor">@(_venta.Cliente?.Documento ?? "—")</div>
                    <div class="cg-venta__etiqueta">Nombre del cliente</div>
                    <div class="cg-venta__cliente-nombre @(_venta.Cliente is null ? null : "cg-venta__cliente-nombre--asignado")">@(_venta.Cliente?.Nombre ?? "Cliente contado")</div>
                </div>
                <div class="cg-venta__transaccion">
                    <div class="cg-venta__etiqueta">Transacción Nº</div>
                    <div class="cg-venta__numero">@_venta.NumeroTransaccion</div>
                    <div class="cg-venta__etiqueta">@_venta.Totales.CantidadArticulos.ToString("0.###") artículos</div>
                    @if (_venta.LimiteCompra is { } limite)
                    {
                        <div class="cg-venta__etiqueta @(_venta.LimiteCompraExcedido ? "cg-venta__limite--excedido" : null)">Límite RD$@limite.ToString("N2")</div>
                    }
                </div>
            </section>

            <section class="cg-venta__bloque cg-venta__totales">
                <div class="cg-venta__total-fila"><span>Subtotal</span><span class="cg-numero">@_venta.Totales.Subtotal.ToString("N2")</span></div>
                <div class="cg-venta__total-fila"><span>ITBIS</span><span class="cg-numero">@_venta.Totales.Impuesto.ToString("N2")</span></div>
                @if (_venta.Totales.Descuento > 0)
                {
                    <div class="cg-venta__total-fila cg-venta__total-fila--descuento"><span>Descuentos</span><span class="cg-numero">−@_venta.Totales.Descuento.ToString("N2")</span></div>
                }
                <div class="cg-venta__total-fila cg-venta__total-final"><span>Total (RD$)</span><span class="cg-total-grande">@_venta.Totales.Total.ToString("N2")</span></div>
            </section>
        </header>

        <div class="cg-venta__escaneo @(_modoEliminar ? "cg-venta__escaneo--eliminar" : null)">
            <MudIcon Icon="@(_modoEliminar ? Icons.Material.Filled.RemoveShoppingCart : Icons.Material.Filled.QrCodeScanner)" Size="Size.Large" />
            <input @ref="_campoEscaneo" class="cg-venta__campo" autocomplete="off" spellcheck="false"
                   placeholder="@(_modoEliminar ? "Escanee el artículo a eliminar · Esc para salir" : "Escanee o digite el código · cantidad*código")"
                   value="@_entrada" @oninput="evento => _entrada = evento.Value?.ToString() ?? string.Empty" @onkeydown="AlTeclearAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.GridView" Size="Size.Large" Color="Color.Primary" OnClick="AbrirCatalogoAsync" aria-label="Catálogo en mosaicos" />
            <MudIconButton Icon="@Icons.Material.Filled.Keyboard" Size="Size.Large" Color="Color.Primary" OnClick="DigitarCodigoAsync" aria-label="Teclado en pantalla" />
        </div>

        @if (_mensaje is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="cg-venta__aviso" ShowCloseIcon="true" CloseIconClicked="() => _mensaje = null">@_mensaje</MudAlert>
        }
        @if (_ultimoCobro is { } cobro && _venta.Lineas.Count == 0)
        {
            <div class="cg-venta__cobro-final">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                <div>
                    <span>Transacción @cobro.NumeroTransaccion cobrada</span>
                    <strong>Total RD$@cobro.TotalCobrado.ToString("N2")</strong>
                </div>
                <div class="cg-venta__devuelta">
                    <span>Devuelta</span>
                    <strong>RD$@cobro.Devuelta.ToString("N2")</strong>
                </div>
                <span class="cg-espaciador"></span>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Print" OnClick="ReimprimirAsync">Reimprimir</MudButton>
            </div>
        }
        @if (_aviso is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="cg-venta__aviso" ShowCloseIcon="true" CloseIconClicked="() => _aviso = null">@_aviso</MudAlert>
        }
        @if (_venta.RequiereIdentificacion)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="cg-venta__aviso">
                Factura de consumo desde RD$@_venta.MontoIdentificacion.ToString("N2"): la DGII exige la cédula o el RNC del cliente (F12).
            </MudAlert>
        }
        @if (_venta.LimiteCompraExcedido)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="cg-venta__aviso">
                El total superó el límite de compra de RD$@_venta.LimiteCompra!.Value.ToString("N2") que indicó el cliente.
            </MudAlert>
        }

        <div class="cg-venta__lineas">
            <GrillaTactil TElemento="DatosLineaVenta" Elementos="_venta.Lineas" Seleccionado="LineaSeleccionada" SeleccionadoChanged="AlSeleccionarLinea"
                          EsAnulada="linea => linea.EsReverso" Altura="100%" TextoSinRegistros="Escanee un artículo para comenzar la venta">
                <Encabezado>
                    <MudTh Style="width: 96px">Ln</MudTh>
                    <MudTh Style="width: 170px">Código</MudTh>
                    <MudTh>Descripción</MudTh>
                    <MudTh Style="width: 70px">UM</MudTh>
                    <MudTh Class="cg-numero" Style="width: 110px">Cant.</MudTh>
                    <MudTh Class="cg-numero" Style="width: 130px">Precio</MudTh>
                    <MudTh Class="cg-numero" Style="width: 150px">Subtotal</MudTh>
                    <MudTh Style="width: 110px">Promo</MudTh>
                </Encabezado>
                <Fila Context="linea">
                    <MudTd Class="@ClaseCelda(linea)">
                        <div class="cg-venta__ln">
                            @if (EsEditable(linea))
                            {
                                <button type="button" class="cg-venta__eliminar" title="Eliminar línea"
                                        @onclick="() => EliminarLineaAsync(linea)" @onclick:stopPropagation="true">
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                </button>
                            }
                            <span>@linea.NumeroLinea</span>
                        </div>
                    </MudTd>
                    <MudTd Class="@ClaseCelda(linea)">
                        <span class="cg-venta__codigo" title="Tocar para ver el código interno / leído"
                              @onclick="() => AlternarCodigo(linea.NumeroLinea)" @onclick:stopPropagation="true">
                            @(_codigosInternos.Contains(linea.NumeroLinea) ? linea.CodigoInterno : linea.CodigoLeido)
                        </span>
                    </MudTd>
                    <MudTd Class="@ClaseCelda(linea)">
                        @linea.Descripcion
                        @if (linea.EsReverso)
                        {
                            <div class="cg-venta__nota">Anula la línea @linea.LineaAnuladaNumero</div>
                        }
                        @if (linea.Serial is not null)
                        {
                            <div class="cg-venta__nota">Serial @linea.Serial</div>
                        }
                        @if (!linea.EsReverso && linea.DescuentoPromocion > 0)
                        {
                            <div class="cg-venta__nota cg-venta__nota--ahorro">Oferta @linea.PromocionCodigo: −@linea.DescuentoPromocion.ToString("N2")</div>
                        }
                        @if (!linea.EsReverso && linea.DescuentoManual > 0)
                        {
                            <div class="cg-venta__nota cg-venta__nota--ahorro">Descuento (@linea.MotivoDescuento): −@linea.DescuentoManual.ToString("N2")</div>
                        }
                        @if (!linea.EsReverso && linea.DescuentoFactura > 0)
                        {
                            <div class="cg-venta__nota cg-venta__nota--ahorro">Descuento a la factura: −@linea.DescuentoFactura.ToString("N2")</div>
                        }
                    </MudTd>
                    <MudTd Class="@ClaseCelda(linea)">@linea.UnidadMedidaCodigo</MudTd>
                    <MudTd Class="@($"cg-numero {ClaseCelda(linea)}")">
                        @if (EsEditable(linea) && !linea.LeidaDeBalanza)
                        {
                            <span class="cg-venta__cantidad" @onclick="() => CambiarCantidadAsync(linea)" @onclick:stopPropagation="true">@FormatoCantidad(linea)</span>
                        }
                        else
                        {
                            @FormatoCantidad(linea)
                        }
                    </MudTd>
                    <MudTd Class="@($"cg-numero {ClaseCelda(linea)}")">
                        @if (EsEditable(linea))
                        {
                            <span class="cg-venta__cantidad" title="Descuento a la línea" @onclick="() => AbrirDescuentoLineaAsync(linea)" @onclick:stopPropagation="true">
                                @linea.PrecioUnitario.ToString("N2")
                            </span>
                        }
                        else if (!linea.EsReverso)
                        {
                            @linea.PrecioUnitario.ToString("N2")
                        }
                    </MudTd>
                    <MudTd Class="@($"cg-numero {ClaseCelda(linea)}")">@ImporteMostrado(linea).ToString("N2")</MudTd>
                    <MudTd Class="@ClaseCelda(linea)">
                        @if (!linea.EsReverso && linea.PromocionDescripcion is not null)
                        {
                            <button type="button" class="cg-venta__promo" title="@linea.PromocionNombre"
                                    @onclick="() => AbrirOfertaAsync(linea)" @onclick:stopPropagation="true">@linea.PromocionDescripcion</button>
                        }
                        @if (!linea.EsReverso && linea.DescuentoManual > 0)
                        {
                            <span class="cg-venta__promo cg-venta__promo--manual">
                                @(linea.DescuentoManualTipo == TipoDescuento.Porcentaje ? $"-{linea.DescuentoManualValor:0.##}%" : "Desc.")
                            </span>
                        }
                        @if (!linea.EsReverso && linea.Lista == ListaPrecio.Mayor)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">Mayor</MudChip>
                        }
                        @if (!linea.EsReverso && linea.LeidaDeBalanza)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Scale" Size="Size.Small" Color="Color.Primary" Title="Leído de balanza" />
                        }
                    </MudTd>
                </Fila>
            </GrillaTactil>
        </div>

        <BarraTeclasFuncion @ref="_barra">
            <PaginaPrincipal>
                <TeclaFuncion Atajo="F2" Texto="Buscar" Icono="@Icons.Material.Filled.Search" AlPresionar="BuscarArticuloAsync" />
                <TeclaFuncion Atajo="F3" Texto="Límite" Icono="@Icons.Material.Filled.Speed" AlPresionar="EstablecerLimiteAsync" />
                <TeclaFuncion Atajo="F4" Texto="Cantidad" Icono="@Icons.Material.Filled.Numbers" AlPresionar="CambiarCantidadSeleccionadaAsync" />
                <TeclaFuncion Atajo="F5" Texto="Balanza" Icono="@Icons.Material.Filled.Scale" AlPresionar="PesarAsync" />
                <TeclaFuncion Atajo="F6" Texto="Reintegro" Icono="@Icons.Material.Filled.Autorenew" Deshabilitada="true" />
                <TeclaFuncion Atajo="F7" Texto="Espera" Icono="@Icons.Material.Filled.PanTool" AlPresionar="AbrirEsperaAsync" />
                <TeclaFuncion Atajo="F8" Texto="Totalizar" Icono="@Icons.Material.Filled.Calculate" EsAccionPrincipal="true" AlPresionar="TotalizarAsync" />
                <TeclaFuncion Atajo="F9" Texto="Suspender" Icono="@Icons.Material.Filled.DesktopAccessDisabled" Deshabilitada="true" />
                <TeclaFuncion Atajo="F10" Texto="Devolver" Icono="@Icons.Material.Filled.Undo" Deshabilitada="true" />
                <TeclaFuncion Atajo="F11" Texto="Precios" Icono="@Icons.Material.Filled.LocalOffer" AlPresionar="ConsultarPrecioAsync" />
                <TeclaFuncion Atajo="F12" Texto="Clientes" Icono="@Icons.Material.Filled.Person" AlPresionar="AbrirClienteAsync" />
            </PaginaPrincipal>
            <PaginaSecundaria>
                <TeclaFuncion Texto="Catálogo" Icono="@Icons.Material.Filled.GridView" AlPresionar="AbrirCatalogoAsync" />
                <TeclaFuncion Texto="Eliminar línea" Icono="@Icons.Material.Filled.PlaylistRemove" AlPresionar="EliminarSeleccionadaAsync" />
                <TeclaFuncion Texto="Eliminar por escaneo" Icono="@Icons.Material.Filled.RemoveShoppingCart" AlPresionar="AlternarModoEliminar" />
                <TeclaFuncion Texto="Limpiar" Icono="@Icons.Material.Filled.ClearAll" AlPresionar="LimpiarAsync" />
                <TeclaFuncion Texto="Desc. línea" Icono="@Icons.Material.Filled.Percent" AlPresionar="DescuentoLineaSeleccionadaAsync" />
                <TeclaFuncion Texto="Desc. factura" Icono="@Icons.Material.Filled.Discount" AlPresionar="AbrirDescuentoFacturaAsync" />
                <TeclaFuncion Texto="Anular" Icono="@Icons.Material.Filled.Block" AlPresionar="AnularAsync" />
                <TeclaFuncion Texto="Suspender" Icono="@Icons.Material.Filled.Lock" AlPresionar="SuspenderAsync" />
                <TeclaFuncion Texto="Gaveta" Icono="@Icons.Material.Filled.PointOfSale" AlPresionar="AbrirGavetaAsync" />
                <TeclaFuncion Texto="Reimprimir" Icono="@Icons.Material.Filled.Print" AlPresionar="ReimprimirAsync" />
                <TeclaFuncion Texto="Salir" Icono="@Icons.Material.Filled.Logout" AlPresionar="SalirAsync" />
            </PaginaSecundaria>
        </BarraTeclasFuncion>

        <footer class="cg-venta__estado">
            <span>Usuario: @Almacen.Sesion?.Nombre</span>
            <span>Caja @Almacen.Sesion?.CajaCodigo · Turno @_estadoTurno?.TurnoAbierto?.Numero</span>
            <span># TRX → @_venta.NumeroTransaccion</span>
            <span>Versión @Version</span>
            <span class="cg-espaciador"></span>
            @if (_ecf is not null)
            {
                <button type="button" class="cg-venta__ecf cg-venta__ecf--@ClaseEcf" title="@string.Join("\n", _ecf.Alertas)" @onclick="AbrirCertificadoAsync">
                    <MudIcon Icon="@(_ecf.CertificadoCargado ? Icons.Material.Filled.VerifiedUser : Icons.Material.Filled.Key)" Size="Size.Small" />
                    @TextoEcf
                </button>
            }
            <span class="cg-venta__sincronizacion cg-venta__sincronizacion--@ClaseSincronizacion">
                <MudIcon Icon="@IconoSincronizacion" Size="Size.Small" />
                @TextoSincronizacion
            </span>
            <span>@_ahora.ToString("dd/MM/yyyy")</span>
            <span>@_ahora.ToString("h:mm tt")</span>
        </footer>
    </div>
}

@code {
    private static readonly string Version =
        typeof(Program).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion.Split('+')[0] ?? "—";

    private readonly SemaphoreSlim _cola = new(1, 1);
    private readonly HashSet<int> _codigosInternos = [];
    private readonly CancellationTokenSource _cierre = new();

    private DatosEstadoTurno? _estadoTurno;
    private DatosVenta? _venta;
    private DatosEstadoSincronizacion? _sincronizacion;
    private DatosEstadoEcf? _ecf;
    private bool _certificadoSolicitado;
    private BarraTeclasFuncion? _barra;
    private ElementReference _campoEscaneo;
    private string _entrada = string.Empty;
    private string? _mensaje;
    private string? _aviso;
    private DatosCobro? _ultimoCobro;
    private int? _numeroSeleccionado;
    private bool _cargando = true;
    private bool _procesando;
    private bool _suspendida;
    private bool _modoEliminar;
    private bool _dialogoAbierto;
    private bool _enfocar = true;
    private DateTime _ahora = DateTime.Now;

    private DatosLineaVenta? LineaSeleccionada => _venta?.Lineas.FirstOrDefault(linea => linea.NumeroLinea == _numeroSeleccionado);

    protected override async Task OnInitializedAsync()
    {
        Atajos.TeclaPresionada += AlPresionarTecla;
        await CargarAsync();
        _ = ActualizarRelojYSincronizacionAsync(_cierre.Token);
    }

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        // El lector de barras escribe donde esté el foco: se devuelve al campo de escaneo tras cada operación.
        if (_enfocar && _venta is not null && !_dialogoAbierto)
        {
            _enfocar = false;
            try
            {
                await _campoEscaneo.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // El campo aún no está en pantalla.
            }
        }
    }

    // ---------- Turno ----------

    private async Task CargarAsync()
    {
        _cargando = _venta is null && _estadoTurno is null;
        _mensaje = null;

        _estadoTurno = await Cliente.ObtenerEstadoTurnoAsync();
        if (_estadoTurno is { TurnoAbierto: not null, EsDeOtroUsuario: false })
        {
            var respuesta = await Cliente.ObtenerVentaActualAsync();
            AplicarRespuesta(respuesta);
        }
        else
        {
            _venta = null;
        }

        _cargando = false;
        _enfocar = true;
    }

    private async Task AbrirTurnoAsync(decimal fondo)
    {
        _procesando = true;
        var respuesta = await Cliente.AbrirTurnoAsync(fondo);
        _procesando = false;

        if (!respuesta.Exitosa && respuesta.Resultado != CodigoResultadoTurno.YaExisteTurnoAbierto)
        {
            _mensaje = respuesta.Mensaje;
            return;
        }

        await CargarAsync();
    }

    // ---------- Escaneo y líneas ----------

    private async Task AlTeclearAsync(KeyboardEventArgs evento)
    {
        if (evento.Key != "Enter")
            return;

        var codigo = _entrada.Trim();
        _entrada = string.Empty;
        if (codigo.Length == 0)
            return;

        if (_modoEliminar)
            await EliminarPorCodigoAsync(codigo);
        else
            await AgregarAsync(codigo);
    }

    private async Task AgregarAsync(string codigo)
    {
        var respuesta = await EnColaConResultadoAsync(() => Cliente.AgregarArticuloAsync(_venta!.Id, codigo));

        // Serializado: se pide el serial y se reintenta (RF-17). Pesado sin etiqueta: se toma el peso de la balanza (RF-19).
        if (respuesta.Resultado == CodigoResultadoVenta.RequiereSerial)
        {
            _mensaje = null;
            var serial = await PedirTextoAsync("Serial del artículo", respuesta.Mensaje ?? "Serial", ayuda: "Escanee el número de serie de la etiqueta del artículo.",
                decimales: false, modo: ModoTeclado.Alfanumerico);
            if (serial is null)
                return;

            respuesta = await EnColaConResultadoAsync(() => Cliente.AgregarArticuloAsync(_venta!.Id, codigo, serial: serial));
        }
        else if (respuesta.Resultado == CodigoResultadoVenta.RequiereBalanza && !codigo.Contains('*'))
        {
            respuesta = await EnColaConResultadoAsync(() => Cliente.AgregarDesdeBalanzaAsync(_venta!.Id, codigo));
        }

        AplicarRespuesta(respuesta, seleccionarUltima: true);
    }

    /// <summary>F5: pesa en la balanza el artículo cuyo código está escrito en el campo, o lo pide.</summary>
    private async Task PesarAsync()
    {
        if (_venta is null)
            return;

        var codigo = _entrada.Trim();
        _entrada = string.Empty;
        if (codigo.Length == 0)
        {
            codigo = await PedirTextoAsync("Pesar en balanza", "Código del artículo (PLU)", ayuda: "Coloque el producto en la balanza y digite su código.",
                decimales: false) ?? string.Empty;
            if (codigo.Length == 0)
                return;
        }

        await EnColaAsync(async () => AplicarRespuesta(await Cliente.AgregarDesdeBalanzaAsync(_venta!.Id, codigo), seleccionarUltima: true));
    }

    private async Task DigitarCodigoAsync()
    {
        var codigo = await PedirTextoAsync(_modoEliminar ? "Eliminar por código" : "Agregar artículo", "Código del artículo",
            ayuda: "También acepta cantidad*código, ej. 12*7891114119695", decimales: false);
        if (codigo is null)
            return;

        if (_modoEliminar)
            await EliminarPorCodigoAsync(codigo);
        else
            await AgregarAsync(codigo);
    }

    private async Task BuscarArticuloAsync()
    {
        if (_venta is null)
            return;

        var codigo = await MostrarDialogoAsync<DialogoBusquedaArticulo, string>("Buscar artículo", [], MaxWidth.Large);
        if (codigo is not null)
            await AgregarAsync(codigo);
    }

    private async Task AbrirCatalogoAsync()
    {
        if (_venta is null)
            return;

        _barra?.MostrarPrincipal();
        var codigo = await MostrarDialogoAsync<DialogoCatalogo, string>("Catálogo", [], MaxWidth.ExtraLarge);
        if (codigo is not null)
            await AgregarAsync(codigo); // un pesado toma el peso de la balanza automáticamente
    }

    private async Task ConsultarPrecioAsync() =>
        await MostrarDialogoAsync<DialogoConsultaPrecio, object>("Consulta de precio", [], MaxWidth.Medium);

    private Task CambiarCantidadSeleccionadaAsync()
    {
        var linea = LineaSeleccionada is { } seleccionada && EsEditable(seleccionada)
            ? seleccionada
            : _venta?.Lineas.LastOrDefault(EsEditable);

        if (linea is null)
        {
            _mensaje = "No hay una línea para cambiar la cantidad.";
            return Task.CompletedTask;
        }

        return CambiarCantidadAsync(linea);
    }

    private async Task CambiarCantidadAsync(DatosLineaVenta linea)
    {
        _numeroSeleccionado = linea.NumeroLinea;
        if (linea.LeidaDeBalanza)
        {
            _mensaje = "La cantidad de un artículo pesado se toma de la balanza.";
            return;
        }

        var texto = await PedirTextoAsync($"Cantidad · {linea.Descripcion}", $"Cantidad ({linea.UnidadMedidaCodigo})",
            valorInicial: linea.Cantidad.ToString("0.###", CultureInfo.InvariantCulture), decimales: linea.DecimalesCantidad > 0);
        if (texto is null)
            return;

        if (!decimal.TryParse(texto, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var cantidad))
        {
            _mensaje = "La cantidad no es válida.";
            return;
        }

        await EnColaAsync(async () => AplicarRespuesta(await Cliente.CambiarCantidadAsync(_venta!.Id, linea.NumeroLinea, cantidad)));
    }

    // ---------- Eliminar y limpiar ----------

    private Task EliminarSeleccionadaAsync()
    {
        if (LineaSeleccionada is { } linea && EsEditable(linea))
            return EliminarLineaAsync(linea);

        _mensaje = "Seleccione la línea que desea eliminar.";
        return Task.CompletedTask;
    }

    private async Task EliminarLineaAsync(DatosLineaVenta linea)
    {
        _numeroSeleccionado = linea.NumeroLinea;
        _dialogoAbierto = true;
        var confirmado = await Dialogos.ConfirmarAsync("Eliminar línea",
            $"¿Eliminar la línea {linea.NumeroLinea}: {linea.Descripcion} ({FormatoCantidad(linea)} × {linea.PrecioUnitario:N2})?", "Eliminar", esPeligrosa: true);
        _dialogoAbierto = false;
        _enfocar = true;
        if (!confirmado)
            return;

        await EjecutarConAutorizacionAsync(
            autorizacion => Cliente.EliminarLineaAsync(_venta!.Id, linea.NumeroLinea, autorizacion),
            $"Eliminar la línea {linea.NumeroLinea} ({linea.Descripcion})");
    }

    private Task EliminarPorCodigoAsync(string codigo) =>
        EjecutarConAutorizacionAsync(
            autorizacion => Cliente.EliminarPorCodigoAsync(_venta!.Id, codigo, autorizacion),
            $"Eliminar el artículo {codigo}");

    private void AlternarModoEliminar()
    {
        _modoEliminar = !_modoEliminar;
        _mensaje = null;
        _enfocar = true;
        _barra?.MostrarPrincipal();
    }

    private async Task LimpiarAsync()
    {
        if (_venta is null)
            return;

        _dialogoAbierto = true;
        var confirmado = _venta.Lineas.Count == 0 || await Dialogos.ConfirmarAsync("Limpiar pantalla",
            $"¿Anular la transacción {_venta.NumeroTransaccion} con {_venta.Totales.CantidadLineas} líneas por RD${_venta.Totales.Total:N2}?", "Limpiar", esPeligrosa: true);
        _dialogoAbierto = false;
        _enfocar = true;
        if (!confirmado)
            return;

        _barra?.MostrarPrincipal();
        await EjecutarConAutorizacionAsync(
            autorizacion => Cliente.LimpiarVentaAsync(_venta!.Id, autorizacion),
            $"Limpiar la transacción {_venta.NumeroTransaccion}");
        _codigosInternos.Clear();
    }

    /// <summary>Ejecuta la operación; si el Agente pide autorización, la solicita al supervisor y reintenta con ella.</summary>
    private Task<RespuestaVenta?> EjecutarConAutorizacionAsync(Func<Guid?, Task<RespuestaVenta>> operacion, string descripcion) =>
        EnColaConResultadoAsync(async () =>
        {
            RespuestaVenta? respuesta;
            _dialogoAbierto = true;
            try
            {
                respuesta = await Autorizaciones.EjecutarVentaAsync(operacion, descripcion, _venta?.NumeroTransaccion);
            }
            finally
            {
                _dialogoAbierto = false;
            }

            if (respuesta is null)
            {
                _mensaje = null;
                return null;
            }

            AplicarRespuesta(respuesta);
            _modoEliminar = _modoEliminar && respuesta.Exitosa is false;
            return respuesta;
        });

    // ---------- Cobro ----------

    /// <summary>F8: muestra el total con descuentos (RF-147) y abre el cobro.</summary>
    private async Task TotalizarAsync()
    {
        if (_venta is null || !_venta.Lineas.Any(EsEditable))
        {
            _mensaje = "No hay artículos que cobrar.";
            return;
        }

        if (_venta.RequiereIdentificacion)
        {
            _mensaje = $"Antes de cobrar, asigne la cédula o el RNC del cliente (factura de consumo desde RD${_venta.MontoIdentificacion:N2}).";
            await AbrirClienteAsync();
            return;
        }

        _barra?.MostrarPrincipal();
        var parametros = new DialogParameters<DialogoCobro> { { dialogo => dialogo.Venta, _venta } };
        var respuesta = await MostrarDialogoAsync<DialogoCobro, RespuestaCobro>($"Cobro · {_venta.NumeroTransaccion}", parametros, MaxWidth.ExtraLarge);
        if (respuesta is not { Exitosa: true, NuevaVenta: { } nueva })
            return;

        _venta = nueva;
        _ultimoCobro = respuesta.Cobro;
        _mensaje = null;
        _aviso = respuesta.Mensaje;
        _numeroSeleccionado = null;
        _codigosInternos.Clear();
    }

    private async Task ReimprimirAsync()
    {
        _barra?.MostrarPrincipal();
        var respuesta = await Cliente.ReimprimirUltimoAsync();
        _aviso = respuesta.Correcto ? respuesta.Mensaje : null;
        _mensaje = respuesta.Correcto ? null : respuesta.Mensaje;
        _enfocar = true;
    }

    private async Task AbrirGavetaAsync()
    {
        _barra?.MostrarPrincipal();
        await EjecutarConAutorizacionAsync(autorizacion => Cliente.AbrirGavetaAsync(autorizacion), "Abrir la gaveta sin venta");
    }

    // ---------- Descuentos y ofertas ----------

    private async Task AbrirDescuentoLineaAsync(DatosLineaVenta linea)
    {
        _numeroSeleccionado = linea.NumeroLinea;

        if (!linea.PermiteDescuentoManual)
        {
            _mensaje = $"{linea.Descripcion} no admite descuento manual; solo ofertas.";
            return;
        }

        if (linea.PromocionCodigo is not null)
        {
            // Primero se ve o se desactiva la oferta (RF-124).
            await AbrirOfertaAsync(linea);
            return;
        }

        var parametros = new DialogParameters<DialogoDescuento>
        {
            { dialogo => dialogo.Venta, _venta! },
            { dialogo => dialogo.NumeroLinea, linea.NumeroLinea },
        };
        AplicarResultadoDialogo(await MostrarDialogoAsync<DialogoDescuento, RespuestaVenta>("Descuento a la línea", parametros, MaxWidth.Medium));
    }

    private Task DescuentoLineaSeleccionadaAsync()
    {
        _barra?.MostrarPrincipal();
        var linea = LineaSeleccionada is { } seleccionada && EsEditable(seleccionada)
            ? seleccionada
            : _venta?.Lineas.LastOrDefault(EsEditable);

        if (linea is null)
        {
            _mensaje = "No hay una línea para descontar.";
            return Task.CompletedTask;
        }

        return AbrirDescuentoLineaAsync(linea);
    }

    private async Task AbrirDescuentoFacturaAsync()
    {
        if (_venta is null || !_venta.Lineas.Any(EsEditable))
        {
            _mensaje = "No hay artículos para descontar.";
            return;
        }

        _barra?.MostrarPrincipal();
        var parametros = new DialogParameters<DialogoDescuento> { { dialogo => dialogo.Venta, _venta } };
        AplicarResultadoDialogo(await MostrarDialogoAsync<DialogoDescuento, RespuestaVenta>("Descuento a la factura", parametros, MaxWidth.Medium));
    }

    private async Task AbrirOfertaAsync(DatosLineaVenta linea)
    {
        var parametros = new DialogParameters<DialogoOferta>
        {
            { dialogo => dialogo.Venta, _venta! },
            { dialogo => dialogo.NumeroLinea, linea.NumeroLinea },
        };
        AplicarResultadoDialogo(await MostrarDialogoAsync<DialogoOferta, RespuestaVenta>("Oferta", parametros, MaxWidth.Small));
    }

    private void AplicarResultadoDialogo(RespuestaVenta? respuesta)
    {
        if (respuesta is not null)
            AplicarRespuesta(respuesta);
    }

    // ---------- Cliente, límite, espera, anular y suspender ----------

    private async Task AbrirClienteAsync()
    {
        if (_venta is null)
            return;

        var parametros = new DialogParameters<DialogoCliente> { { dialogo => dialogo.Venta, _venta } };
        var venta = await MostrarDialogoAsync<DialogoCliente, DatosVenta>("Cliente y comprobante", parametros, MaxWidth.Medium);

        // Los cambios ya quedaron en el Agente: si el diálogo se cerró con Esc, se relee la venta.
        if (venta is not null)
            _venta = venta;
        else
            await EnColaAsync(async () => AplicarRespuesta(await Cliente.ObtenerVentaActualAsync()));
    }

    private async Task EstablecerLimiteAsync()
    {
        if (_venta is null)
            return;

        var texto = await PedirTextoAsync("Límite de compra", "Monto límite en RD$ (0 para quitarlo)",
            valorInicial: _venta.LimiteCompra?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty);
        if (texto is null)
            return;

        decimal? limite = decimal.TryParse(texto, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var monto) && monto > 0 ? monto : null;
        await EnColaAsync(async () => AplicarRespuesta(await Cliente.EstablecerLimiteCompraAsync(_venta!.Id, limite)));
    }

    private async Task AbrirEsperaAsync()
    {
        if (_venta is null)
            return;

        var parametros = new DialogParameters<DialogoEspera> { { dialogo => dialogo.Venta, _venta } };
        var venta = await MostrarDialogoAsync<DialogoEspera, DatosVenta>("Facturas en espera", parametros, MaxWidth.Medium);
        if (venta is null)
            return;

        _venta = venta;
        _mensaje = null;
        _numeroSeleccionado = null;
        _codigosInternos.Clear();
    }

    private async Task AnularAsync()
    {
        if (_venta is null || _venta.Lineas.Count == 0)
        {
            _mensaje = "No hay artículos que anular.";
            return;
        }

        // Con permiso propio se pide el motivo aquí; si no, el supervisor lo indica al autorizar.
        string? motivo = null;
        if (Almacen.TienePermiso(CatalogoPermisos.AnularVenta))
        {
            motivo = await PedirTextoAsync($"Anular la transacción {_venta.NumeroTransaccion}", "Motivo de la anulación", modo: ModoTeclado.Alfanumerico);
            if (motivo is null)
                return;
        }

        _barra?.MostrarPrincipal();
        await EjecutarConAutorizacionAsync(
            autorizacion => Cliente.AnularVentaAsync(_venta!.Id, motivo, autorizacion),
            $"Anular la transacción {_venta.NumeroTransaccion} por RD${_venta.Totales.Total:N2}");
        _codigosInternos.Clear();
    }

    private async Task SuspenderAsync()
    {
        var respuesta = await EjecutarConAutorizacionAsync(autorizacion => Cliente.SuspenderCajaAsync(autorizacion), "Suspender las operaciones de la caja");
        if (respuesta is { Exitosa: true })
        {
            _barra?.MostrarPrincipal();
            _suspendida = true;
        }
    }

    private Task ReanudarAsync()
    {
        _suspendida = false;
        _enfocar = true;
        return Task.CompletedTask;
    }

    private static string EtiquetaDocumento(TipoDocumentoIdentidad? tipo) => tipo switch
    {
        TipoDocumentoIdentidad.Rnc => "RNC",
        TipoDocumentoIdentidad.Cedula => "Cédula",
        TipoDocumentoIdentidad.Pasaporte => "Pasaporte",
        _ => "Código de cliente · ID",
    };

    // ---------- Soporte ----------

    private Task EnColaAsync(Func<Task> accion) =>
        EnColaConResultadoAsync<object?>(async () =>
        {
            await accion();
            return null;
        });

    private async Task<TResultado> EnColaConResultadoAsync<TResultado>(Func<Task<TResultado>> accion)
    {
        // Lecturas seguidas del escáner se procesan en orden, sin pisarse.
        await _cola.WaitAsync();
        try
        {
            _procesando = true;
            return await accion();
        }
        finally
        {
            _procesando = false;
            _enfocar = true;
            _cola.Release();
        }
    }

    private void AplicarRespuesta(RespuestaVenta respuesta, bool seleccionarUltima = false)
    {
        if (respuesta.Venta is { } venta)
            _venta = venta;

        if (respuesta.Resultado is CodigoResultadoVenta.TurnoNoAbierto or CodigoResultadoVenta.TurnoDeOtroUsuario)
        {
            _venta = null;
            _mensaje = respuesta.Mensaje;
            _ = InvokeAsync(CargarAsync);
            return;
        }

        _mensaje = respuesta.Exitosa ? null : respuesta.Mensaje;
        _aviso = respuesta.Exitosa ? respuesta.Mensaje : null;

        if (respuesta.Exitosa && seleccionarUltima && _venta is not null)
            _numeroSeleccionado = _venta.Lineas.Where(linea => !linea.EsReverso).Select(linea => (int?)linea.NumeroLinea).Max();
    }

    private async Task<string?> PedirTextoAsync(string titulo, string etiqueta, string valorInicial = "", string? ayuda = null, bool decimales = true,
        ModoTeclado modo = ModoTeclado.Numerico)
    {
        var parametros = new DialogParameters<DialogoTeclado>
        {
            { dialogo => dialogo.Etiqueta, etiqueta },
            { dialogo => dialogo.ValorInicial, valorInicial },
            { dialogo => dialogo.Ayuda, ayuda },
            { dialogo => dialogo.PermitirDecimal, decimales },
            { dialogo => dialogo.Modo, modo },
            { dialogo => dialogo.PermitirCambioModo, modo == ModoTeclado.Alfanumerico },
        };

        return await MostrarDialogoAsync<DialogoTeclado, string>(titulo, parametros, modo == ModoTeclado.Alfanumerico ? MaxWidth.Medium : MaxWidth.Small);
    }

    private async Task<TResultado?> MostrarDialogoAsync<TDialogo, TResultado>(string titulo, DialogParameters parametros, MaxWidth ancho)
        where TDialogo : IComponent
        where TResultado : class
    {
        if (_dialogoAbierto)
            return null;

        _dialogoAbierto = true;
        try
        {
            var opciones = new DialogOptions { MaxWidth = ancho, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = true };
            var referencia = await Dialogos.ShowAsync<TDialogo>(titulo, parametros, opciones);
            var resultado = await referencia.Result;
            return resultado is { Canceled: false, Data: TResultado dato } ? dato : null;
        }
        finally
        {
            _dialogoAbierto = false;
            _enfocar = true;
        }
    }

    private async Task AlPresionarTecla(string tecla)
    {
        if (_venta is null || _dialogoAbierto)
            return;

        var accion = tecla switch
        {
            "F2" => BuscarArticuloAsync(),
            "F3" => EstablecerLimiteAsync(),
            "F4" => CambiarCantidadSeleccionadaAsync(),
            "F5" => PesarAsync(),
            "F7" => AbrirEsperaAsync(),
            "F8" => TotalizarAsync(),
            "F11" => ConsultarPrecioAsync(),
            "F12" => AbrirClienteAsync(),
            "Escape" => SalirDeModosAsync(),
            _ => Task.CompletedTask,
        };

        await InvokeAsync(async () =>
        {
            await accion;
            StateHasChanged();
        });
    }

    private Task SalirDeModosAsync()
    {
        _modoEliminar = false;
        _mensaje = null;
        _enfocar = true;
        return Task.CompletedTask;
    }

    private async Task ActualizarRelojYSincronizacionAsync(CancellationToken cancelacion)
    {
        using var temporizador = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var segundos = 0;
        try
        {
            _sincronizacion = await Cliente.ObtenerEstadoSincronizacionAsync(cancelacion);
            _ecf = await Cliente.ObtenerEstadoEcfAsync(cancelacion);
            while (await temporizador.WaitForNextTickAsync(cancelacion))
            {
                _ahora = DateTime.Now;
                if (++segundos % 15 == 0)
                    _sincronizacion = await Cliente.ObtenerEstadoSincronizacionAsync(cancelacion);
                if (segundos % 60 == 0)
                    _ecf = await Cliente.ObtenerEstadoEcfAsync(cancelacion) ?? _ecf;

                // Al iniciar la jornada se pide el PIN del certificado una sola vez; luego queda en la barra de estado.
                if (_ecf is { CertificadoCargado: false } && !_certificadoSolicitado && _venta is not null && !_dialogoAbierto && !_suspendida)
                {
                    _certificadoSolicitado = true;
                    await InvokeAsync(AbrirCertificadoAsync);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SalirAsync()
    {
        // La venta en curso queda guardada y se recupera al volver a ingresar.
        await Cliente.CerrarSesionAsync();
        Navegacion.NavigateTo("ingreso", replace: true);
    }

    private void AlSeleccionarLinea(DatosLineaVenta linea)
    {
        _numeroSeleccionado = linea.NumeroLinea;
        _enfocar = true;
    }

    private void AlternarCodigo(int numeroLinea)
    {
        if (!_codigosInternos.Remove(numeroLinea))
            _codigosInternos.Add(numeroLinea);
        _enfocar = true;
    }

    private static bool EsEditable(DatosLineaVenta linea) => !linea.EsReverso && !linea.Anulada;

    private static string? ClaseCelda(DatosLineaVenta linea) => linea.Anulada ? "cg-venta__tachada" : null;

    private static string FormatoCantidad(DatosLineaVenta linea) => linea.Cantidad.ToString("N" + linea.DecimalesCantidad);

    /// <summary>El reverso muestra en negativo el importe de la línea que anula (el total ya lo excluye).</summary>
    private decimal ImporteMostrado(DatosLineaVenta linea)
    {
        if (!linea.EsReverso)
            return linea.Anulada ? linea.ImporteBruto : linea.Importe;

        var original = _venta?.Lineas.FirstOrDefault(l => l.NumeroLinea == linea.LineaAnuladaNumero);
        return original is null ? 0m : -original.ImporteBruto;
    }

    private async Task AbrirCertificadoAsync()
    {
        if (_ecf is { CertificadoCargado: true })
        {
            // Con el certificado cargado, el botón solo muestra las alertas fiscales.
            _aviso = _ecf.Alertas.Count == 0 ? "Facturación electrónica al día." : null;
            _mensaje = _ecf.Alertas.Count == 0 ? null : string.Join(" ", _ecf.Alertas);
            return;
        }

        var parametros = new DialogParameters<DialogoCertificado> { { dialogo => dialogo.Estado, _ecf } };
        if (await MostrarDialogoAsync<DialogoCertificado, DatosEstadoEcf>("Certificado digital", parametros, MaxWidth.Small) is { } estado)
        {
            _ecf = estado;
            _aviso = "Certificado digital cargado. La caja puede facturar.";
            _mensaje = null;
        }

        StateHasChanged();
    }

    private string ClaseEcf => _ecf switch
    {
        { CertificadoCargado: false } => "error",
        { Alertas.Count: > 0 } => "alerta",
        _ => "correcto",
    };

    private string TextoEcf => _ecf switch
    {
        { CertificadoCargado: false } => "e-CF: digite el PIN",
        { Alertas.Count: > 0 } estado => $"e-CF: {estado.Alertas.Count} alerta(s)",
        _ => "e-CF listo",
    };

    private string ClaseSincronizacion => _sincronizacion switch
    {
        null => "error",
        { EnLinea: true } => "enlinea",
        _ => "sinconexion",
    };

    private string IconoSincronizacion => _sincronizacion is { EnLinea: true } ? Icons.Material.Filled.CloudDone : Icons.Material.Filled.CloudOff;

    private string TextoSincronizacion => _sincronizacion switch
    {
        null => "Agente sin respuesta",
        { EnLinea: true } estado => $"En línea · {estado.DocumentosPendientes} pendientes",
        { CentralConfigurado: false } estado => $"Sin Central · {estado.DocumentosPendientes} pendientes",
        var estado => $"Fuera de línea · {estado.DocumentosPendientes} pendientes",
    };

    public void Dispose()
    {
        Atajos.TeclaPresionada -= AlPresionarTecla;
        _cierre.Cancel();
        _cierre.Dispose();
    }
}
