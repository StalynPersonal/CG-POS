@page "/"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Reflection
@inject ClienteAgente Cliente
@inject AlmacenSesion Almacen
@inject ServicioAtajosTeclado Atajos
@inject ServicioAutorizacionPantalla Autorizaciones
@inject IDialogService Dialogos
@inject NavigationManager Navegacion

@* Pantalla del cajero (M05): layout de la referencia en verde institucional. *@

<PageTitle>CG-POS · Venta</PageTitle>

@if (!PuedeVender && !Almacen.PuedeDevolver)
{
    @* Un usuario sin ventas ni devoluciones no tiene nada que hacer en la caja: se le dice y se le deja salir. *@
    <PanelSinPermiso Titulo="Sin operaciones habilitadas"
                     Detalle="Su usuario no tiene permiso para registrar ventas ni devoluciones. Pida al administrador que le asigne el rol que le corresponde." />
}
else if (_cargando)
{
    @* Espera mientras se consulta el turno y la venta en curso del Agente. *@
    <div class="cg-venta__cargando">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    </div>
}
else if (_venta is null)
{
    <PanelAperturaTurno Estado="_estadoTurno" Mensaje="@_mensaje" Procesando="_procesando"
                        NombreUsuario="@Almacen.Sesion?.Nombre" CajaCodigo="@Almacen.Sesion?.CajaCodigo"
                        AlAbrir="AbrirTurnoAsync" AlReintentar="CargarAsync" AlSalir="SalirAsync" AlRelevar="RelevarTurnoAsync" />
}
else if (_suspendida)
{
    <PanelSuspension CodigoUsuario="@(Almacen.Sesion?.Codigo ?? string.Empty)" NombreUsuario="@Almacen.Sesion?.Nombre" CajaCodigo="@Almacen.Sesion?.CajaCodigo"
                     AlReanudar="ReanudarAsync" AlSalir="SalirAsync" />
}
else
{
    @* Pantalla completa del cajero: barra superior, encabezado, escaneo, grilla de líneas, teclas F y barra de estado. *@
    <div class="cg-venta">
        @* Barra superior: marca, nombre de la pantalla, empresa y caja en la que se está trabajando. *@
        <div class="cg-venta__barra-superior">
            <span class="cg-venta__marca-texto">CG-POS</span>
            <NombrePantalla Pantalla="PantallasCaja.Principal" />
            <span class="cg-venta__marca-sub">@_empresaNombre</span>
            <span class="cg-espaciador"></span>
            <span>@Almacen.Sesion?.CajaNombre</span>
        </div>

        <header class="cg-venta__encabezado">
            <section class="cg-venta__bloque cg-venta__marca cg-venta__tocable" title="Cliente y comprobante (F12)" @onclick="AbrirClienteAsync">
                @* Iniciales de la empresa a modo de logo. *@
                <div class="cg-venta__logo">@Iniciales(_empresaNombre)</div>
                @* Tipo de comprobante de la venta; se cambia desde el mismo bloque (F12). *@
                <div class="cg-venta__ncf">E@((int)_venta.TipoComprobante) · @ReglasComprobante.Nombre(_venta.TipoComprobante)</div>
            </section>

            <section class="cg-venta__bloque cg-venta__cliente">
                @* Datos del cliente de la venta; al tocarlo se abre el diálogo de cliente y comprobante (F12). *@
                <div class="cg-venta__tocable" title="Cliente y comprobante (F12)" @onclick="AbrirClienteAsync">
                    @* Documento del cliente: cédula o RNC según el que se haya asignado. *@
                    <div class="cg-venta__etiqueta">@EtiquetaDocumento(_venta.Cliente?.TipoDocumento)</div>
                    <div class="cg-venta__valor">@(_venta.Cliente?.Documento ?? "—")</div>
                    @* Nombre del cliente; "Cliente contado" mientras no se le asigne uno. *@
                    <div class="cg-venta__etiqueta">Nombre del cliente</div>
                    <div class="cg-venta__cliente-nombre @(_venta.Cliente is null ? null : "cg-venta__cliente-nombre--asignado")">@(_venta.Cliente?.Nombre ?? "Cliente contado")</div>
                    @if (_venta.Fidelidad is { } fidelidad)
                    {
                        @* Miembro del programa de fidelidad asignado a la venta, con su nivel. *@
                        <div class="cg-venta__promo" title="Programa de fidelidad">★ @fidelidad.Nombre@(fidelidad.Nivel is null ? null : $" · {fidelidad.Nivel}")</div>
                    }
                    @if (_venta.ListaBoda is { } listaBoda)
                    {
                        @* Lista de boda del Central contra la que se está comprando (F6). *@
                        <div class="cg-venta__promo" title="Lista de boda">♥ @listaBoda.Numero · @listaBoda.Evento</div>
                    }
                </div>
                @* Identificación de la transacción: número, artículos y el límite de compra que pidió el cliente. *@
                <div class="cg-venta__transaccion">
                    <div class="cg-venta__etiqueta">Transacción Nº</div>
                    <div class="cg-venta__numero">@_venta.NumeroTransaccion</div>
                    <div class="cg-venta__etiqueta">@_venta.Totales.CantidadArticulos.ToString("0.###") artículos</div>
                    @if (_venta.LimiteCompra is { } limite)
                    {
                        @* Límite de compra (RF-18): se resalta cuando el total ya lo superó. *@
                        <div class="cg-venta__etiqueta @(_venta.LimiteCompraExcedido ? "cg-venta__limite--excedido" : null)">Límite @limite.ToString("C")</div>
                    }
                </div>
            </section>

            <section class="cg-venta__bloque cg-venta__totales">
                @* Subtotal sin ITBIS de las líneas activas. *@
                <div class="cg-venta__total-fila"><span>Subtotal</span><span class="cg-numero">@_venta.Totales.Subtotal.ToString("N2")</span></div>
                @* ITBIS de la venta, sumando todas las tasas; en régimen especial la factura va exenta y se avisa. *@
                @if (_venta.ExentaDeImpuesto)
                {
                    <div class="cg-venta__total-fila cg-venta__total-fila--descuento"><span>ITBIS</span><span class="cg-numero">Exenta · régimen especial</span></div>
                }
                else
                {
                    <div class="cg-venta__total-fila"><span>ITBIS</span><span class="cg-numero">@_venta.Totales.Impuesto.ToString("N2")</span></div>
                }
                @if (_venta.Totales.Descuento > 0)
                {
                    @* Lo que el cliente se ahorró entre ofertas y descuentos manuales. *@
                    <div class="cg-venta__total-fila cg-venta__total-fila--descuento"><span>Descuentos</span><span class="cg-numero">−@_venta.Totales.Descuento.ToString("N2")</span></div>
                }
                @* Total de la factura, el número grande de la pantalla. *@
                <div class="cg-venta__total-fila cg-venta__total-final"><span>Total (@_venta.SimboloMoneda)</span><span class="cg-total-grande">@_venta.Totales.Total.ToString("N2")</span></div>
                @if (_venta.Totales.Retencion > 0)
                {
                    @* Gubernamental (E45): la retención de la Ley 32-23 y lo que el cliente paga en caja. *@
                    <div class="cg-venta__total-fila cg-venta__total-fila--descuento"><span>Retención Ley 32-23</span><span class="cg-numero">−@_venta.Totales.Retencion.ToString("N2")</span></div>
                    <div class="cg-venta__total-fila cg-venta__total-final"><span>A pagar (@_venta.SimboloMoneda)</span><span class="cg-total-grande">@_venta.Totales.TotalAPagar.ToString("N2")</span></div>
                }
            </section>
        </header>

        @* Campo de escaneo: recibe el lector, admite "cantidad*código" y da acceso al catálogo y al teclado en pantalla. *@
        <div class="cg-venta__escaneo @(_modoEliminar ? "cg-venta__escaneo--eliminar" : null)">
            <MudIcon Icon="@(_modoEliminar ? Icons.Material.Filled.RemoveShoppingCart : Icons.Material.Filled.QrCodeScanner)" Size="Size.Large" />
            <input @ref="_campoEscaneo" class="cg-venta__campo" autocomplete="off" spellcheck="false" disabled="@(!PuedeVender)"
                   placeholder="@PlaceholderEscaneo"
                   value="@_entrada" @oninput="evento => _entrada = evento.Value?.ToString() ?? string.Empty" @onkeydown="AlTeclearAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.GridView" Size="Size.Large" Color="Color.Primary" Disabled="@(!PuedeVender)"
                           OnClick="AbrirCatalogoAsync" aria-label="Catálogo en mosaicos" />
            <MudIconButton Icon="@Icons.Material.Filled.Keyboard" Size="Size.Large" Color="Color.Primary" Disabled="@(!PuedeVender)"
                           OnClick="DigitarCodigoAsync" aria-label="Teclado en pantalla" />
            @* Las dos acciones de cada venta quedan siempre a la vista; el resto está en el menú. Buscar sirve aunque no se venda. *@
            <TeclaFuncion Atajo="F2" Texto="Buscar" Icono="@Icons.Material.Filled.Search" Clase="cg-venta__tecla-fija" AlPresionar="BuscarArticuloAsync" />
            <TeclaFuncion Atajo="F8" Texto="Totalizar" Icono="@Icons.Material.Filled.Calculate" EsAccionPrincipal="true" Clase="cg-venta__tecla-fija"
                          Deshabilitada="@(!PuedeVender)" AlPresionar="TotalizarAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Size="Size.Large" Color="Color.Primary" OnClick="AlternarPanel"
                           aria-label="Menú de funciones" title="Funciones" />
        </div>

        @if (!PuedeVender)
        {
            @* Su rol solo hace devoluciones: aquí únicamente consulta artículos y clientes. *@
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="cg-venta__aviso" Icon="@Icons.Material.Filled.Lock">
                Su usuario no registra ventas: en esta pantalla solo puede consultar artículos y clientes. Las devoluciones están en F10.
            </MudAlert>
        }
        @if (_estadoTurno?.BloqueoDiaAnterior is { } bloqueo)
        {
            @* Aviso fijo, sin cerrar: con un turno de un día anterior la caja no vende ni cobra hasta hacer el cierre. *@
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="cg-venta__aviso" Icon="@Icons.Material.Filled.EventBusy">
                @bloqueo Si tiene facturas en espera, retómelas y límpielas antes del cierre.
            </MudAlert>
        }
        @if (_mensaje is not null && _mensaje != _estadoTurno?.BloqueoDiaAnterior)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="cg-venta__aviso" ShowCloseIcon="true" CloseIconClicked="() => _mensaje = null">@_mensaje</MudAlert>
        }
        @if (_ultimoCobro is { } cobro && _venta.Lineas.Count == 0)
        {
            @* Resumen de la última venta cobrada, mientras no se escanea el primer artículo de la siguiente. *@
            <div class="cg-venta__cobro-final">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                @* Número de la transacción cobrada, sus pendientes de entrega y el total. *@
                <div>
                    <span>Transacción @cobro.NumeroTransaccion cobrada</span>
                    @if (cobro.PendientesEntrega is { Count: > 0 } pendientes)
                    {
                        <span>Pendientes: @string.Join(", ", pendientes)</span>
                    }
                    <strong>Total @cobro.TotalCobrado.ToString("C")</strong>
                </div>
                @* Devuelta del cobro, visible hasta empezar la próxima venta. *@
                <div class="cg-venta__devuelta">
                    <span>Devuelta</span>
                    <strong>@cobro.Devuelta.ToString("C")</strong>
                </div>
                <span class="cg-espaciador"></span>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Print" OnClick="ReimprimirAsync">Reimprimir</MudButton>
            </div>
        }
        @if (_aviso is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="cg-venta__aviso" ShowCloseIcon="true" CloseIconClicked="() => _aviso = null">@_aviso</MudAlert>
        }
        @if (_venta.RequiereIdentificacion)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="cg-venta__aviso">
                Factura de consumo desde @_venta.MontoIdentificacion.ToString("C"): la DGII exige la cédula o el RNC del cliente (F12).
            </MudAlert>
        }
        @if (_venta.LimiteCompraExcedido)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="cg-venta__aviso">
                El total superó el límite de compra de @_venta.LimiteCompra!.Value.ToString("C") que indicó el cliente.
            </MudAlert>
        }

        @* Grilla de las líneas de la venta: código, descripción, cantidad, precio, importe y la oferta aplicada. *@
        <div class="cg-venta__lineas">
            @* La línea eliminada se ve tachada en su lugar, con su mismo número. *@
            <GrillaTactil TElemento="DatosLineaVenta" Elementos="LineasVisibles" Seleccionado="LineaSeleccionada" SeleccionadoChanged="AlSeleccionarLinea"
                          EsAnulada="linea => linea.Anulada" Altura="100%" TextoSinRegistros="Escanee un artículo para comenzar la venta">
                <Encabezado>
                    <MudTh Style="width: 96px">Ln</MudTh>
                    <MudTh Style="width: 170px">Código</MudTh>
                    <MudTh>Descripción</MudTh>
                    <MudTh Style="width: 70px">UM</MudTh>
                    <MudTh Class="cg-numero" Style="width: 110px">Cant.</MudTh>
                    <MudTh Class="cg-numero" Style="width: 130px">Precio</MudTh>
                    <MudTh Class="cg-numero" Style="width: 150px">Subtotal</MudTh>
                    <MudTh Style="width: 110px">Promo</MudTh>
                </Encabezado>
                <Fila Context="linea">
                    @* La columna Ln se ve normal aun en la línea eliminada: solo las demás columnas van en gris y tachadas. *@
                    <MudTd Style="color: var(--mud-palette-text-primary); text-decoration: none">
                        @* Número de línea con el botón para eliminarla (pide autorización si corresponde). *@
                        <div class="cg-venta__ln">
                            @if (EsEditable(linea))
                            {
                                <button type="button" class="cg-venta__eliminar" title="Eliminar línea"
                                        @onclick="() => EliminarLineaAsync(linea)" @onclick:stopPropagation="true">
                                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                                </button>
                            }
                            else
                            {
                                @* Hueco del tamaño del botón, para que el número quede alineado con el de las demás líneas. *@
                                <span style="width: 36px; flex: 0 0 36px"></span>
                            }
                            <span>@linea.NumeroLinea</span>
                        </div>
                    </MudTd>
                    <MudTd Class="@ClaseCelda(linea)">
                        <span class="cg-venta__codigo" title="Tocar para ver el código interno / leído"
                              @onclick="() => AlternarCodigo(linea.NumeroLinea)" @onclick:stopPropagation="true">
                            @(_codigosInternos.Contains(linea.NumeroLinea) ? linea.CodigoInterno : linea.CodigoLeido)
                        </span>
                    </MudTd>
                    <MudTd Class="@ClaseCelda(linea)">
                        @linea.Descripcion
                        @if (linea.Serial is not null)
                        {
                            @* Serial del artículo serializado que se escaneó en caja. *@
                            <div class="cg-venta__nota">Serial @linea.Serial</div>
                        }
                        @if (linea.SerialPendiente)
                        {
                            @* Serializado que sale pendiente: el serial se captura en el despacho. *@
                            <div class="cg-venta__nota">Serial al entregar</div>
                        }
                        @if (linea.CantidadEnEntrega > 0)
                        {
                            @* Cantidad de la línea marcada para entrega o envío posterior. *@
                            <div class="cg-venta__nota">Entrega posterior: @linea.CantidadEnEntrega.ToString("0.###")</div>
                        }
                        @if (linea.DescuentoPromocion > 0)
                        {
                            @* Ahorro de la oferta del maestro aplicada a la línea. *@
                            <div class="cg-venta__nota cg-venta__nota--ahorro">Oferta @linea.PromocionCodigo: −@linea.DescuentoPromocion.ToString("N2")</div>
                        }
                        @if (linea.DescuentoManual > 0)
                        {
                            @* Descuento manual de la línea, con el motivo con que se autorizó. *@
                            <div class="cg-venta__nota cg-venta__nota--ahorro">Descuento (@linea.MotivoDescuento): −@linea.DescuentoManual.ToString("N2")</div>
                        }
                        @if (linea.DescuentoFactura > 0)
                        {
                            @* Parte del descuento a la factura que le tocó a esta línea al prorratearlo. *@
                            <div class="cg-venta__nota cg-venta__nota--ahorro">Descuento a la factura: −@linea.DescuentoFactura.ToString("N2")</div>
                        }
                    </MudTd>
                    <MudTd Class="@ClaseCelda(linea)">@linea.UnidadMedidaCodigo</MudTd>
                    <MudTd Class="@($"cg-numero {ClaseCelda(linea)}")">
                        @if (EsEditable(linea) && !linea.LeidaDeBalanza)
                        {
                            <span class="cg-venta__cantidad" @onclick="() => CambiarCantidadAsync(linea)" @onclick:stopPropagation="true">@FormatoCantidad(linea)</span>
                        }
                        else
                        {
                            @FormatoCantidad(linea)
                        }
                    </MudTd>
                    <MudTd Class="@($"cg-numero {ClaseCelda(linea)}")">
                        @if (EsEditable(linea))
                        {
                            <span class="cg-venta__cantidad" title="Descuento a la línea" @onclick="() => AbrirDescuentoLineaAsync(linea)" @onclick:stopPropagation="true">
                                @linea.PrecioUnitario.ToString("N2")
                            </span>
                        }
                        else
                        {
                            @linea.PrecioUnitario.ToString("N2")
                        }
                    </MudTd>
                    <MudTd Class="@($"cg-numero {ClaseCelda(linea)}")">@ImporteMostrado(linea).ToString("N2")</MudTd>
                    <MudTd Class="@ClaseCelda(linea)">
                        @if (linea.PromocionDescripcion is not null)
                        {
                            <button type="button" class="cg-venta__promo" title="@linea.PromocionNombre"
                                    @onclick="() => AbrirOfertaAsync(linea)" @onclick:stopPropagation="true">@linea.PromocionDescripcion</button>
                        }
                        @if (linea.DescuentoManual > 0)
                        {
                            <span class="cg-venta__promo cg-venta__promo--manual">
                                @(linea.DescuentoManualTipo == TipoDescuento.Porcentaje ? $"-{linea.DescuentoManualValor:0.##}%" : "Desc.")
                            </span>
                        }
                        @if (linea.Lista == ListaPrecio.Mayor)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">Mayor</MudChip>
                        }
                        @if (linea.LeidaDeBalanza)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Scale" Size="Size.Small" Color="Color.Primary" Title="Leído de balanza" />
                        }
                    </MudTd>
                </Fila>
            </GrillaTactil>
        </div>

        @if (_panelAbierto)
        {
            @* Fondo detrás del panel de funciones: tocarlo lo cierra. *@
            <div class="cg-venta__panel-fondo" @onclick="CerrarPanel"></div>

            @* Panel de funciones desde la derecha, a toda la altura. No toma el foco: el lector sigue escribiendo en el campo de escaneo. *@
            <aside class="cg-venta__panel" aria-label="Funciones" @onmousedown:preventDefault="true">
                @* Encabezado del panel con el botón para cerrarlo. *@
                <div class="cg-venta__panel-encabezado">
                    <span>Funciones</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="CerrarPanel" aria-label="Cerrar" />
                </div>

                @* Teclas de función: las mismas que responden al teclado físico (F2 a F12). *@
                <div class="cg-venta__panel-titulo">Teclas de función</div>
                <div class="cg-venta__panel-teclas">
                    <TeclaFuncion Atajo="F2" Texto="Buscar" Icono="@Icons.Material.Filled.Search" AlPresionar="() => DesdePanelAsync(BuscarArticuloAsync)" />
                    <TeclaFuncion Atajo="F3" Texto="Límite" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.Speed" AlPresionar="() => DesdePanelAsync(EstablecerLimiteAsync)" />
                    <TeclaFuncion Atajo="F4" Texto="Cantidad" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.Numbers" AlPresionar="() => DesdePanelAsync(CambiarCantidadSeleccionadaAsync)" />
                    <TeclaFuncion Atajo="F5" Texto="Balanza" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.Scale" AlPresionar="() => DesdePanelAsync(PesarAsync)" />
                    <TeclaFuncion Atajo="F6" Texto="Lista boda" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.Favorite" AlPresionar="() => DesdePanelAsync(AsignarListaBodaAsync)" />
                    <TeclaFuncion Atajo="F7" Texto="Espera" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.PanTool" AlPresionar="() => DesdePanelAsync(AbrirEsperaAsync)" />
                    <TeclaFuncion Atajo="F8" Texto="Totalizar" Icono="@Icons.Material.Filled.Calculate" EsAccionPrincipal="true" Deshabilitada="@(!PuedeVender)" AlPresionar="() => DesdePanelAsync(TotalizarAsync)" />
                    <TeclaFuncion Atajo="F9" Texto="Cotización" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.RequestQuote" AlPresionar="() => DesdePanelAsync(FacturarCotizacionAsync)" />
                    <TeclaFuncion Atajo="F10" Texto="Devolver" Deshabilitada="@(!Almacen.PuedeDevolver)" Icono="@Icons.Material.Filled.Undo" AlPresionar="() => DesdePanelAsync(IrADevolucionesAsync)" />
                    <TeclaFuncion Atajo="F11" Texto="Precios" Icono="@Icons.Material.Filled.LocalOffer" AlPresionar="() => DesdePanelAsync(ConsultarPrecioAsync)" />
                    <TeclaFuncion Atajo="F12" Texto="Clientes" Icono="@Icons.Material.Filled.Person" AlPresionar="() => DesdePanelAsync(AbrirClienteAsync)" />
                </div>

                @* Operaciones sin tecla física: líneas, descuentos, entregas, caja y turno. *@
                <div class="cg-venta__panel-titulo">Más operaciones</div>
                <div class="cg-venta__panel-teclas">
                    <TeclaFuncion Texto="Catálogo" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.GridView" AlPresionar="() => DesdePanelAsync(AbrirCatalogoAsync)" />
                    <TeclaFuncion Texto="Eliminar línea" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.PlaylistRemove" AlPresionar="() => DesdePanelAsync(EliminarSeleccionadaAsync)" />
                    <TeclaFuncion Texto="Eliminar por escaneo" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.RemoveShoppingCart" AlPresionar="() => DesdePanel(AlternarModoEliminar)" />
                    <TeclaFuncion Texto="Limpiar" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.ClearAll" AlPresionar="() => DesdePanelAsync(LimpiarAsync)" />
                    <TeclaFuncion Texto="Desc. línea" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.Percent" AlPresionar="() => DesdePanelAsync(DescuentoLineaSeleccionadaAsync)" />
                    <TeclaFuncion Texto="Desc. factura" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.Discount" AlPresionar="() => DesdePanelAsync(AbrirDescuentoFacturaAsync)" />
                    <TeclaFuncion Texto="Entrega / envío" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.LocalShipping" AlPresionar="() => DesdePanelAsync(AbrirEntregaAsync)" />
                    <TeclaFuncion Texto="Suspender" Deshabilitada="@(!PuedeVender)" Icono="@Icons.Material.Filled.Lock" AlPresionar="() => DesdePanelAsync(SuspenderAsync)" />
                    <TeclaFuncion Texto="Gaveta" Icono="@Icons.Material.Filled.PointOfSale" AlPresionar="() => DesdePanelAsync(AbrirGavetaAsync)" />
                    <TeclaFuncion Texto="Reimprimir" Icono="@Icons.Material.Filled.Print" AlPresionar="() => DesdePanelAsync(ReimprimirAsync)" />
                    <TeclaFuncion Texto="Retiro" Icono="@Icons.Material.Filled.Savings" AlPresionar="() => DesdePanelAsync(RetirarEfectivoAsync)" />
                    <TeclaFuncion Texto="Cierre de turno" Icono="@Icons.Material.Filled.LockClock" AlPresionar="() => DesdePanelAsync(CerrarTurnoAsync)" />
                    <TeclaFuncion Texto="Salir" Icono="@Icons.Material.Filled.Logout" AlPresionar="() => DesdePanelAsync(SalirAsync)" />
                </div>
            </aside>
        }

        <footer class="cg-venta__estado">
            <span>Usuario: @Almacen.Sesion?.Nombre</span>
            <span>Caja @Almacen.Sesion?.CajaCodigo · Turno @_estadoTurno?.TurnoAbierto?.Numero</span>
            <span># TRX → @_venta.NumeroTransaccion</span>
            <span>Versión @Version</span>
            <span class="cg-espaciador"></span>
            @if (_ecf is not null)
            {
                <button type="button" class="cg-venta__ecf cg-venta__ecf--@ClaseEcf" title="@string.Join("\n", _ecf.Alertas)" @onclick="AbrirCertificadoAsync">
                    <MudIcon Icon="@(_ecf.CertificadoCargado ? Icons.Material.Filled.VerifiedUser : Icons.Material.Filled.Key)" Size="Size.Small" />
                    @TextoEcf
                </button>
            }
            <span class="cg-venta__sincronizacion cg-venta__sincronizacion--@ClaseSincronizacion" title="@DetalleSincronizacion">
                <MudIcon Icon="@IconoSincronizacion" Size="Size.Small" />
                @TextoSincronizacion
            </span>
            <span>@_ahora.ToString("dd/MM/yyyy")</span>
            <span>@_ahora.ToString("h:mm tt")</span>
        </footer>
    </div>
}

@code {
    private static readonly string Version =
        typeof(Program).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion.Split('+')[0] ?? "—";

    private readonly SemaphoreSlim _cola = new(1, 1);
    private readonly HashSet<int> _codigosInternos = [];
    private readonly CancellationTokenSource _cierre = new();

    private DatosEstadoTurno? _estadoTurno;
    private DatosVenta? _venta;
    private DatosEstadoSincronizacion? _sincronizacion;
    private string? _empresaNombre;
    private DatosEstadoEcf? _ecf;
    private bool _certificadoSolicitado;
    private bool _panelAbierto;
    private ElementReference _campoEscaneo;
    private string _entrada = string.Empty;
    private string? _mensaje;
    private string? _aviso;
    private DatosCobro? _ultimoCobro;
    private int? _numeroSeleccionado;
    private bool _cargando = true;
    private bool _procesando;
    private bool _suspendida;
    private bool _modoEliminar;
    private bool _dialogoAbierto;
    private bool _enfocar = true;
    private DateTime _ahora = DateTime.Now;

    private DatosLineaVenta? LineaSeleccionada => _venta?.Lineas.FirstOrDefault(linea => linea.NumeroLinea == _numeroSeleccionado);

    protected override async Task OnInitializedAsync()
    {
        Atajos.TeclaPresionada += AlPresionarTecla;
        _empresaNombre = (await Cliente.ObtenerEstadoCajaAsync())?.EmpresaNombre;
        await CargarAsync();
        _ = ActualizarRelojYSincronizacionAsync(_cierre.Token);
    }

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        // El lector de barras escribe donde esté el foco: se devuelve al campo de escaneo tras cada operación.
        if (_enfocar && _venta is not null && !_dialogoAbierto)
        {
            _enfocar = false;
            try
            {
                await _campoEscaneo.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // El campo aún no está en pantalla.
            }
        }
    }

    // ---------- Turno ----------

    private async Task CargarAsync()
    {
        _cargando = _venta is null && _estadoTurno is null;
        _mensaje = null;

        _estadoTurno = await Cliente.ObtenerEstadoTurnoAsync();
        if (_estadoTurno is { TurnoAbierto: not null, EsDeOtroUsuario: false })
        {
            var respuesta = await Cliente.ObtenerVentaActualAsync();
            AplicarRespuesta(respuesta);

            // Si la pantalla arrancó cuando el Agente no respondía, la cultura quedó sin símbolo de moneda: la venta lo trae.
            if (string.IsNullOrEmpty(MonedaPantalla.Simbolo) && _venta?.SimboloMoneda is { Length: > 0 } simbolo)
                CgPos.Dominio.Globalizacion.CulturaRd.Aplicar(simbolo);
        }
        else
        {
            _venta = null;
        }

        _cargando = false;
        _enfocar = true;
    }

    private async Task AbrirTurnoAsync(decimal fondo)
    {
        _procesando = true;
        var respuesta = await Cliente.AbrirTurnoAsync(fondo);
        _procesando = false;

        if (!respuesta.Exitosa && respuesta.Resultado != CodigoResultadoTurno.YaExisteTurnoAbierto)
        {
            _mensaje = respuesta.Mensaje;
            return;
        }

        await CargarAsync();
    }

    /// <summary>La venta en curso queda guardada; al volver se recupera (RF-195).</summary>
    private Task IrADevolucionesAsync()
    {
        // Sin el permiso la pantalla no se abre: el botón está apagado y el atajo tampoco lleva.
        if (Almacen.PuedeDevolver)
            Navegacion.NavigateTo("devoluciones");

        return Task.CompletedTask;
    }

    // ---------- Relevo, retiros, cierre y reapertura (C8) ----------

    private async Task RelevarTurnoAsync()
    {
        _procesando = true;
        _mensaje = null;
        var respuesta = await Autorizaciones.EjecutarCajaAsync(autorizacion => Cliente.RelevarTurnoAsync(autorizacion),
            $"Relevo del turno de {_estadoTurno?.TurnoAbierto?.UsuarioActualNombre}");
        _procesando = false;
        if (respuesta is null)
            return;
        if (!respuesta.Exitosa)
        {
            _mensaje = respuesta.Mensaje;
            return;
        }

        await CargarAsync();
    }

    private async Task RetirarEfectivoAsync()
    {
        var texto = await PedirTextoAsync("Retiro de efectivo", $"Monto a retirar ({MonedaPantalla.Simbolo})", ayuda: "Se imprime el comprobante y se abre la gaveta.");
        if (texto is null || !decimal.TryParse(texto, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var monto))
            return;

        var motivo = await PedirTextoAsync("Retiro de efectivo", "Motivo del retiro", ayuda: "Ej.: remesa a bóveda.", decimales: false, modo: ModoTeclado.Alfanumerico);
        if (motivo is null)
            return;

        var respuesta = await Autorizaciones.EjecutarCajaAsync(autorizacion => Cliente.RetirarEfectivoAsync(monto, motivo, autorizacion),
            $"Retiro de efectivo por {monto:C}");
        if (respuesta is null)
            return;

        _aviso = respuesta.Exitosa ? respuesta.Mensaje : null;
        _mensaje = respuesta.Exitosa ? null : respuesta.Mensaje;
        _enfocar = true;
    }

    private async Task CerrarTurnoAsync()
    {
        var respuesta = await MostrarDialogoAsync<DialogoCierreTurno, RespuestaCaja>("Cierre de turno", new DialogParameters(), MaxWidth.ExtraLarge);

        // Se recarga siempre: si el turno quedó cerrado, la pantalla vuelve a la apertura.
        await CargarAsync();
        if (respuesta is { Exitosa: true })
            _aviso = respuesta.Mensaje;
    }

    // ---------- Escaneo y líneas ----------

    private void AlternarPanel()
    {
        _panelAbierto = !_panelAbierto;
        _enfocar = true;
    }

    private void CerrarPanel()
    {
        _panelAbierto = false;
        _enfocar = true;
    }

    /// <summary>El panel se cierra antes de la acción: si abre un diálogo, el panel no queda detrás.</summary>
    private Task DesdePanelAsync(Func<Task> accion)
    {
        CerrarPanel();
        return accion();
    }

    private void DesdePanel(Action accion)
    {
        CerrarPanel();
        accion();
    }

    private async Task AlTeclearAsync(KeyboardEventArgs evento)
    {
        // Lo que se escribe o se escanea con el panel abierto va a la venta: el panel se aparta.
        _panelAbierto = false;

        if (evento.Key != "Enter")
            return;

        var codigo = _entrada.Trim();
        _entrada = string.Empty;
        if (codigo.Length == 0)
            return;

        if (_modoEliminar)
            await EliminarPorCodigoAsync(codigo);
        else
            await AgregarAsync(codigo);
    }

    private async Task AgregarAsync(string codigo)
    {
        var respuesta = await EnColaConResultadoAsync(() => Cliente.AgregarArticuloAsync(_venta!.Id, codigo));

        // Serializado: se pide el serial y se reintenta (RF-17). Pesado sin etiqueta: se toma el peso de la balanza (RF-19).
        if (respuesta.Resultado == CodigoResultadoVenta.RequiereSerial)
        {
            _mensaje = null;
            var serial = await PedirTextoAsync("Serial del artículo", respuesta.Mensaje ?? "Serial", ayuda: "Escanee el número de serie de la etiqueta del artículo.",
                decimales: false, modo: ModoTeclado.Alfanumerico);
            if (serial is null)
            {
                // Sin serial en caja solo si se entrega después: el serial se captura en el despacho (RN-16).
                _dialogoAbierto = true;
                var sinSerial = await Dialogos.ConfirmarAsync("Artículo con serial",
                    "¿Registrarlo sin serial para entregarlo o enviarlo después? Antes de cobrar debe marcarlo con «Entrega / envío».", "Sin serial");
                _dialogoAbierto = false;
                _enfocar = true;
                if (!sinSerial)
                    return;

                respuesta = await EnColaConResultadoAsync(() => Cliente.AgregarArticuloAsync(_venta!.Id, codigo, serialEnDespacho: true));
            }
            else
            {
                respuesta = await EnColaConResultadoAsync(() => Cliente.AgregarArticuloAsync(_venta!.Id, codigo, serial: serial));
            }
        }
        else if (respuesta.Resultado == CodigoResultadoVenta.RequiereBalanza && !codigo.Contains('*'))
        {
            respuesta = await EnColaConResultadoAsync(() => Cliente.AgregarDesdeBalanzaAsync(_venta!.Id, codigo));
        }

        AplicarRespuesta(respuesta, seleccionarUltima: true);
    }

    /// <summary>F5: pesa en la balanza el artículo cuyo código está escrito en el campo, o lo pide.</summary>
    private async Task PesarAsync()
    {
        if (_venta is null)
            return;

        var codigo = _entrada.Trim();
        _entrada = string.Empty;
        if (codigo.Length == 0)
        {
            codigo = await PedirTextoAsync("Pesar en balanza", "Código del artículo (PLU)", ayuda: "Coloque el producto en la balanza y digite su código.",
                decimales: false) ?? string.Empty;
            if (codigo.Length == 0)
                return;
        }

        await EnColaAsync(async () => AplicarRespuesta(await Cliente.AgregarDesdeBalanzaAsync(_venta!.Id, codigo), seleccionarUltima: true));
    }

    private async Task DigitarCodigoAsync()
    {
        var codigo = await PedirTextoAsync(_modoEliminar ? "Eliminar por código" : "Agregar artículo", "Código del artículo",
            ayuda: "También acepta cantidad*código, ej. 12*7891114119695", decimales: false, cantidadPorCodigo: true);
        if (codigo is null)
            return;

        if (_modoEliminar)
            await EliminarPorCodigoAsync(codigo);
        else
            await AgregarAsync(codigo);
    }

    private async Task BuscarArticuloAsync()
    {
        if (_venta is null)
            return;

        var codigo = await MostrarDialogoAsync<DialogoBusquedaArticulo, string>("Buscar artículo", [], MaxWidth.Large);
        if (codigo is not null)
            await AgregarAsync(codigo);
    }

    private async Task AbrirCatalogoAsync()
    {
        if (_venta is null)
            return;

        var codigo = await MostrarDialogoAsync<DialogoCatalogo, string>("Catálogo", [], MaxWidth.ExtraLarge);
        if (codigo is not null)
            await AgregarAsync(codigo); // un pesado toma el peso de la balanza automáticamente
    }

    private async Task ConsultarPrecioAsync() =>
        await MostrarDialogoAsync<DialogoConsultaPrecio, object>("Consulta de precio", [], MaxWidth.Medium);

    private Task CambiarCantidadSeleccionadaAsync()
    {
        var linea = LineaSeleccionada is { } seleccionada && EsEditable(seleccionada)
            ? seleccionada
            : _venta?.Lineas.LastOrDefault(EsEditable);

        if (linea is null)
        {
            _mensaje = "No hay una línea para cambiar la cantidad.";
            return Task.CompletedTask;
        }

        return CambiarCantidadAsync(linea);
    }

    private async Task CambiarCantidadAsync(DatosLineaVenta linea)
    {
        _numeroSeleccionado = linea.NumeroLinea;
        if (linea.LeidaDeBalanza)
        {
            _mensaje = "La cantidad de un artículo pesado se toma de la balanza.";
            return;
        }

        var texto = await PedirTextoAsync($"Cantidad · {linea.Descripcion}", $"Cantidad ({linea.UnidadMedidaCodigo})",
            valorInicial: linea.Cantidad.ToString("0.###", CultureInfo.InvariantCulture), decimales: linea.DecimalesCantidad > 0);
        if (texto is null)
            return;

        if (!decimal.TryParse(texto, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var cantidad))
        {
            _mensaje = "La cantidad no es válida.";
            return;
        }

        await EnColaAsync(async () => AplicarRespuesta(await Cliente.CambiarCantidadAsync(_venta!.Id, linea.NumeroLinea, cantidad)));
    }

    // ---------- Eliminar y limpiar ----------

    private Task EliminarSeleccionadaAsync()
    {
        if (LineaSeleccionada is { } linea && EsEditable(linea))
            return EliminarLineaAsync(linea);

        _mensaje = "Seleccione la línea que desea eliminar.";
        return Task.CompletedTask;
    }

    private async Task EliminarLineaAsync(DatosLineaVenta linea)
    {
        _numeroSeleccionado = linea.NumeroLinea;
        _dialogoAbierto = true;
        var confirmado = await Dialogos.ConfirmarAsync("Eliminar línea",
            $"¿Eliminar la línea {linea.NumeroLinea}: {linea.Descripcion} ({FormatoCantidad(linea)} × {linea.PrecioUnitario:N2})?", "Eliminar", esPeligrosa: true);
        _dialogoAbierto = false;
        _enfocar = true;
        if (!confirmado)
            return;

        await EjecutarConAutorizacionAsync(
            autorizacion => Cliente.EliminarLineaAsync(_venta!.Id, linea.NumeroLinea, autorizacion),
            $"Eliminar la línea {linea.NumeroLinea} ({linea.Descripcion})");
    }

    private Task EliminarPorCodigoAsync(string codigo) =>
        EjecutarConAutorizacionAsync(
            autorizacion => Cliente.EliminarPorCodigoAsync(_venta!.Id, codigo, autorizacion),
            $"Eliminar el artículo {codigo}");

    private void AlternarModoEliminar()
    {
        _modoEliminar = !_modoEliminar;
        _mensaje = null;
        _enfocar = true;
    }

    private async Task LimpiarAsync()
    {
        if (_venta is null)
            return;

        // Una venta vacía no se pregunta ni se explica: no hay nada que botar.
        if (_venta.Lineas.Count == 0)
        {
            await EjecutarConAutorizacionAsync(
                autorizacion => Cliente.LimpiarVentaAsync(_venta!.Id, null, autorizacion),
                $"Limpiar la transacción {_venta.NumeroTransaccion}");
            return;
        }

        // El motivo es opcional: se puede dejar vacío y seguir. Si lo escriben, queda en la auditoría.
        var motivo = await PedirTextoAsync($"Limpiar la transacción {_venta.NumeroTransaccion}",
            $"Motivo (opcional) · {_venta.Totales.CantidadLineas} líneas por {_venta.Totales.Total:C}",
            ayuda: "Puede dejarlo en blanco. Ej.: el cliente se arrepintió.", decimales: false, modo: ModoTeclado.Alfanumerico);
        if (motivo is null)
            return;

        await EjecutarConAutorizacionAsync(
            autorizacion => Cliente.LimpiarVentaAsync(_venta!.Id, string.IsNullOrWhiteSpace(motivo) ? null : motivo, autorizacion),
            $"Limpiar la transacción {_venta.NumeroTransaccion}");
        _codigosInternos.Clear();
    }

    /// <summary>Ejecuta la operación; si el Agente pide autorización, la solicita al supervisor y reintenta con ella.</summary>
    private Task<RespuestaVenta?> EjecutarConAutorizacionAsync(Func<Guid?, Task<RespuestaVenta>> operacion, string descripcion) =>
        EnColaConResultadoAsync(async () =>
        {
            RespuestaVenta? respuesta;
            _dialogoAbierto = true;
            try
            {
                respuesta = await Autorizaciones.EjecutarVentaAsync(operacion, descripcion, _venta?.NumeroTransaccion);
            }
            finally
            {
                _dialogoAbierto = false;
            }

            if (respuesta is null)
            {
                _mensaje = null;
                return null;
            }

            AplicarRespuesta(respuesta);
            _modoEliminar = _modoEliminar && respuesta.Exitosa is false;
            return respuesta;
        });

    // ---------- Cobro ----------

    /// <summary>F8: muestra el total con descuentos (RF-147) y abre el cobro.</summary>
    private async Task TotalizarAsync()
    {
        if (_venta is null || !_venta.Lineas.Any(EsEditable))
        {
            _mensaje = "No hay artículos que cobrar.";
            return;
        }

        if (_venta.RequiereIdentificacion)
        {
            _mensaje = $"Antes de cobrar, asigne la cédula o el RNC del cliente (factura de consumo desde {_venta.MontoIdentificacion:C}).";
            await AbrirClienteAsync();
            return;
        }

        if (!await ConfirmarLimiteCompraAsync())
        {
            _enfocar = true;
            return;
        }

        var parametros = new DialogParameters<DialogoCobro> { { dialogo => dialogo.Venta, _venta } };
        var respuesta = await MostrarDialogoAsync<DialogoCobro, RespuestaCobro>($"Cobro · {_venta.NumeroTransaccion}", parametros, MaxWidth.ExtraLarge);
        if (respuesta is not { Exitosa: true, NuevaVenta: { } nueva })
            return;

        _venta = nueva;
        _ultimoCobro = respuesta.Cobro;
        _mensaje = null;
        _aviso = respuesta.Mensaje;
        _numeroSeleccionado = null;
        _codigosInternos.Clear();
    }

    /// <summary>
    /// El límite de compra lo pone el cliente: superarlo no impide cobrar, pero el cajero tiene que confirmarlo (con el
    /// cliente) antes de abrir el cobro. Devuelve si se sigue con el cobro.
    /// </summary>
    private async Task<bool> ConfirmarLimiteCompraAsync()
    {
        if (_venta is not { LimiteCompraExcedido: true, LimiteCompra: { } limite } venta)
            return true;

        _dialogoAbierto = true;
        var cobrar = await Dialogos.ConfirmarAsync("Límite de compra superado",
            $"El total ({venta.Totales.Total:C}) supera el límite de {limite:C} que indicó el cliente. ¿Cobrar de todas formas?",
            "Cobrar", textoCancelar: "Volver a la venta");
        _dialogoAbierto = false;
        return cobrar;
    }

    private async Task ReimprimirAsync()
    {
        var respuesta = await Cliente.ReimprimirUltimoAsync();
        _aviso = respuesta.Correcto ? respuesta.Mensaje : null;
        _mensaje = respuesta.Correcto ? null : respuesta.Mensaje;
        _enfocar = true;
    }

    private async Task AbrirGavetaAsync()
    {
        await EjecutarConAutorizacionAsync(autorizacion => Cliente.AbrirGavetaAsync(autorizacion), "Abrir la gaveta sin venta");
    }

    // ---------- Descuentos y ofertas ----------

    private async Task AbrirDescuentoLineaAsync(DatosLineaVenta linea)
    {
        _numeroSeleccionado = linea.NumeroLinea;

        if (!linea.PermiteDescuentoManual)
        {
            _mensaje = $"{linea.Descripcion} no admite descuento manual; solo ofertas.";
            return;
        }

        if (linea.PromocionCodigo is not null)
        {
            // Primero se ve o se desactiva la oferta (RF-124).
            await AbrirOfertaAsync(linea);
            return;
        }

        var parametros = new DialogParameters<DialogoDescuento>
        {
            { dialogo => dialogo.Venta, _venta! },
            { dialogo => dialogo.NumeroLinea, linea.NumeroLinea },
        };
        AplicarResultadoDialogo(await MostrarDialogoAsync<DialogoDescuento, RespuestaVenta>("Descuento a la línea", parametros, MaxWidth.Medium));
    }

    private Task DescuentoLineaSeleccionadaAsync()
    {
        var linea = LineaSeleccionada is { } seleccionada && EsEditable(seleccionada)
            ? seleccionada
            : _venta?.Lineas.LastOrDefault(EsEditable);

        if (linea is null)
        {
            _mensaje = "No hay una línea para descontar.";
            return Task.CompletedTask;
        }

        return AbrirDescuentoLineaAsync(linea);
    }

    private async Task AbrirDescuentoFacturaAsync()
    {
        if (_venta is null || !_venta.Lineas.Any(EsEditable))
        {
            _mensaje = "No hay artículos para descontar.";
            return;
        }

        var parametros = new DialogParameters<DialogoDescuento> { { dialogo => dialogo.Venta, _venta } };
        AplicarResultadoDialogo(await MostrarDialogoAsync<DialogoDescuento, RespuestaVenta>("Descuento a la factura", parametros, MaxWidth.Medium));
    }

    private async Task AbrirOfertaAsync(DatosLineaVenta linea)
    {
        var parametros = new DialogParameters<DialogoOferta>
        {
            { dialogo => dialogo.Venta, _venta! },
            { dialogo => dialogo.NumeroLinea, linea.NumeroLinea },
        };
        AplicarResultadoDialogo(await MostrarDialogoAsync<DialogoOferta, RespuestaVenta>("Oferta", parametros, MaxWidth.Small));
    }

    private void AplicarResultadoDialogo(RespuestaVenta? respuesta)
    {
        if (respuesta is not null)
            AplicarRespuesta(respuesta);
    }

    // ---------- Cliente, límite, espera, anular y suspender ----------

    private async Task AbrirClienteAsync()
    {
        if (_venta is null)
            return;

        var parametros = new DialogParameters<DialogoCliente> { { dialogo => dialogo.Venta, _venta } };
        var venta = await MostrarDialogoAsync<DialogoCliente, DatosVenta>("Cliente y comprobante", parametros, MaxWidth.Large);

        // Los cambios ya quedaron en el Agente: si el diálogo se cerró con Esc, se relee la venta.
        if (venta is not null)
            _venta = venta;
        else
            await EnColaAsync(async () => AplicarRespuesta(await Cliente.ObtenerVentaActualAsync()));
    }

    /// <summary>Marca artículos para retiro en almacén o envío a dirección (RF-246); requiere clave de supervisor (RF-53).</summary>
    private async Task AbrirEntregaAsync()
    {
        if (_venta is null || !_venta.Lineas.Any(EsEditable))
        {
            _mensaje = "No hay artículos para marcar como pendientes de entrega.";
            return;
        }

        var parametros = new DialogParameters<DialogoEntrega> { { dialogo => dialogo.Venta, _venta }, { dialogo => dialogo.NumeroLinea, _numeroSeleccionado } };
        var venta = await MostrarDialogoAsync<DialogoEntrega, DatosVenta>("Entrega y envío", parametros, MaxWidth.Large);
        if (venta is not null)
            _venta = venta;
        else
            await EnColaAsync(async () => AplicarRespuesta(await Cliente.ObtenerVentaActualAsync()));
    }

    private async Task EstablecerLimiteAsync()
    {
        if (_venta is null)
            return;

        var texto = await PedirTextoAsync("Límite de compra", $"Monto límite en {MonedaPantalla.Simbolo} (0 para quitarlo)",
            valorInicial: _venta.LimiteCompra?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty);
        if (texto is null)
            return;

        decimal? limite = decimal.TryParse(texto, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var monto) && monto > 0 ? monto : null;
        await EnColaAsync(async () => AplicarRespuesta(await Cliente.EstablecerLimiteCompraAsync(_venta!.Id, limite)));
    }

    /// <summary>Pide el número de la lista de boda y la valida en el Central (RF-73); vacío la quita de la venta.</summary>
    /// <summary>
    /// Trae una cotización del Central y la vuelca en la venta. El número se escanea del papel que trae el cliente o se
    /// digita; una vencida pide autorización de un supervisor.
    /// </summary>
    private async Task FacturarCotizacionAsync()
    {
        if (_venta is null)
            return;

        var numero = await PedirTextoAsync("Cotización", "Número de la cotización (escanee el papel del cliente)",
            ayuda: "La cotización se hizo en el Central; se traen sus artículos con los precios que se le prometieron.",
            decimales: false, modo: ModoTeclado.Alfanumerico);
        if (string.IsNullOrWhiteSpace(numero))
            return;

        await EnColaAsync(async () =>
        {
            var respuesta = await Autorizaciones.EjecutarCotizacionAsync(
                autorizacion => Cliente.FacturarCotizacionAsync(_venta!.Id, numero, autorizacion),
                $"Facturar la cotización {numero}, que ya venció", _venta.NumeroTransaccion);

            if (respuesta is null)
                return;

            if (respuesta.Venta is { } actualizada)
                _venta = actualizada;

            _mensaje = respuesta.Exitosa ? null : respuesta.Mensaje;
            _aviso = respuesta.Exitosa ? respuesta.Mensaje : null;
        });
    }

    private async Task AsignarListaBodaAsync()
    {
        if (_venta is null)
            return;

        var numero = await PedirTextoAsync("Lista de boda", "Número de la lista (vacío para quitarla)",
            valorInicial: _venta.ListaBoda?.Numero ?? string.Empty);
        if (numero is null)
            return;

        await EnColaAsync(async () =>
        {
            var respuesta = await Cliente.AsignarListaBodaAsync(_venta!.Id, numero);
            if (respuesta.Venta is { } actualizada)
                _venta = actualizada;

            _mensaje = respuesta.Exitosa ? null : respuesta.Mensaje;
            _aviso = respuesta.Exitosa ? respuesta.Mensaje : null;
        });
    }

    private async Task AbrirEsperaAsync()
    {
        if (_venta is null)
            return;

        var parametros = new DialogParameters<DialogoEspera> { { dialogo => dialogo.Venta, _venta } };
        var venta = await MostrarDialogoAsync<DialogoEspera, DatosVenta>("Facturas en espera", parametros, MaxWidth.Medium);
        if (venta is null)
            return;

        _venta = venta;
        _mensaje = null;
        _numeroSeleccionado = null;
        _codigosInternos.Clear();
    }

    private async Task SuspenderAsync()
    {
        var respuesta = await EjecutarConAutorizacionAsync(autorizacion => Cliente.SuspenderCajaAsync(autorizacion), "Suspender las operaciones de la caja");
        if (respuesta is { Exitosa: true })
        {
            _suspendida = true;
        }
    }

    private Task ReanudarAsync()
    {
        _suspendida = false;
        _enfocar = true;
        return Task.CompletedTask;
    }

    private static string EtiquetaDocumento(TipoDocumentoIdentidad? tipo) => tipo switch
    {
        TipoDocumentoIdentidad.Rnc => "RNC",
        TipoDocumentoIdentidad.Cedula => "Cédula",
        TipoDocumentoIdentidad.Pasaporte => "Pasaporte",
        _ => "Código de cliente · ID",
    };

    // ---------- Soporte ----------

    private Task EnColaAsync(Func<Task> accion) =>
        EnColaConResultadoAsync<object?>(async () =>
        {
            await accion();
            return null;
        });

    private async Task<TResultado> EnColaConResultadoAsync<TResultado>(Func<Task<TResultado>> accion)
    {
        // Lecturas seguidas del escáner se procesan en orden, sin pisarse.
        await _cola.WaitAsync();
        try
        {
            _procesando = true;
            return await accion();
        }
        finally
        {
            _procesando = false;
            _enfocar = true;
            _cola.Release();
        }
    }

    private void AplicarRespuesta(RespuestaVenta respuesta, bool seleccionarUltima = false)
    {
        if (respuesta.Venta is { } venta)
            _venta = venta;

        if (respuesta.Resultado is CodigoResultadoVenta.TurnoNoAbierto or CodigoResultadoVenta.TurnoDeOtroUsuario)
        {
            _venta = null;
            _mensaje = respuesta.Mensaje;
            _ = InvokeAsync(CargarAsync);
            return;
        }

        // El turno pasó a ser de un día anterior con la pantalla abierta: el aviso fijo toma el lugar del mensaje.
        if (respuesta.Resultado == CodigoResultadoVenta.TurnoDiaAnterior && _estadoTurno is { } estado)
        {
            _estadoTurno = estado with { BloqueoDiaAnterior = respuesta.Mensaje };
            _mensaje = null;
            return;
        }

        _mensaje = respuesta.Exitosa ? null : respuesta.Mensaje;
        _aviso = respuesta.Exitosa ? respuesta.Mensaje : null;

        if (respuesta.Exitosa && seleccionarUltima && _venta is not null)
            _numeroSeleccionado = _venta.Lineas.Where(linea => !linea.Anulada).Select(linea => (int?)linea.NumeroLinea).Max();
    }

    /// <summary>
    /// Códigos, documentos y textos pueden llevar letras: su teclado pasa de números a letras (ABC / 123). Las cantidades
    /// y los montos, que llevan decimales, se quedan en el numérico.
    /// </summary>
    private static bool PermiteCambioModo(ModoTeclado modo, bool decimales) => modo == ModoTeclado.Alfanumerico || !decimales;

    /// <param name="cantidadPorCodigo">El valor admite cantidad*código: el teclado muestra la tecla *.</param>
    private async Task<string?> PedirTextoAsync(string titulo, string etiqueta, string valorInicial = "", string? ayuda = null, bool decimales = true,
        ModoTeclado modo = ModoTeclado.Numerico, bool cantidadPorCodigo = false)
    {
        var parametros = new DialogParameters<DialogoTeclado>
        {
            { dialogo => dialogo.Etiqueta, etiqueta },
            { dialogo => dialogo.ValorInicial, valorInicial },
            { dialogo => dialogo.Ayuda, ayuda },
            { dialogo => dialogo.PermitirDecimal, decimales },
            { dialogo => dialogo.Modo, modo },
            { dialogo => dialogo.PermitirCambioModo, PermiteCambioModo(modo, decimales) },
            { dialogo => dialogo.PermitirAsterisco, cantidadPorCodigo },
        };

        return await MostrarDialogoAsync<DialogoTeclado, string>(titulo, parametros, PermiteCambioModo(modo, decimales) ? MaxWidth.Medium : MaxWidth.Small);
    }

    private async Task<TResultado?> MostrarDialogoAsync<TDialogo, TResultado>(string titulo, DialogParameters parametros, MaxWidth ancho)
        where TDialogo : IComponent
        where TResultado : class
    {
        if (_dialogoAbierto)
            return null;

        _dialogoAbierto = true;
        try
        {
            var opciones = new DialogOptions { MaxWidth = ancho, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = true };
            var referencia = await Dialogos.ShowAsync<TDialogo>(titulo, parametros, opciones);
            var resultado = await referencia.Result;
            return resultado is { Canceled: false, Data: TResultado dato } ? dato : null;
        }
        finally
        {
            _dialogoAbierto = false;
            _enfocar = true;
        }
    }

    /// <summary>Su rol registra ventas; si no, esta pantalla le sirve solo para consultar.</summary>
    private bool PuedeVender => Almacen.PuedeVender;

    private string PlaceholderEscaneo => !PuedeVender
        ? "Su usuario no registra ventas"
        : _modoEliminar ? "Escanee el artículo a eliminar · Esc para salir" : "Escanee o digite el código · cantidad*código";

    private async Task AlPresionarTecla(string tecla)
    {
        if (_venta is null || _dialogoAbierto)
            return;

        // Cualquier tecla de función (y Esc) cierra el panel antes de actuar.
        _panelAbierto = false;

        // Lo que mueve la venta queda fuera para quien no la registra; buscar, consultar precio y cliente siguen abiertos.
        if (!PuedeVender && tecla is "F3" or "F4" or "F5" or "F6" or "F7" or "F8" or "F9")
            return;

        var accion = tecla switch
        {
            "F2" => BuscarArticuloAsync(),
            "F3" => EstablecerLimiteAsync(),
            "F4" => CambiarCantidadSeleccionadaAsync(),
            "F5" => PesarAsync(),
            "F7" => AbrirEsperaAsync(),
            "F8" => TotalizarAsync(),
            "F9" => FacturarCotizacionAsync(),
            "F10" => IrADevolucionesAsync(),
            "F11" => ConsultarPrecioAsync(),
            "F12" => AbrirClienteAsync(),
            "Escape" => SalirDeModosAsync(),
            _ => Task.CompletedTask,
        };

        await InvokeAsync(async () =>
        {
            await accion;
            StateHasChanged();
        });
    }

    private Task SalirDeModosAsync()
    {
        _modoEliminar = false;
        _mensaje = null;
        _enfocar = true;
        return Task.CompletedTask;
    }

    private async Task ActualizarRelojYSincronizacionAsync(CancellationToken cancelacion)
    {
        using var temporizador = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var segundos = 0;
        try
        {
            _sincronizacion = await Cliente.ObtenerEstadoSincronizacionAsync(cancelacion);
            _ecf = await Cliente.ObtenerEstadoEcfAsync(cancelacion);
            while (await temporizador.WaitForNextTickAsync(cancelacion))
            {
                _ahora = DateTime.Now;
                if (++segundos % 15 == 0)
                    _sincronizacion = await Cliente.ObtenerEstadoSincronizacionAsync(cancelacion);
                if (segundos % 60 == 0)
                    _ecf = await Cliente.ObtenerEstadoEcfAsync(cancelacion) ?? _ecf;

                // Al iniciar la jornada se pide el PIN del certificado una sola vez; luego queda en la barra de estado.
                if (_ecf is { CertificadoCargado: false } && !_certificadoSolicitado && _venta is not null && !_dialogoAbierto && !_suspendida)
                {
                    _certificadoSolicitado = true;
                    await InvokeAsync(AbrirCertificadoAsync);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SalirAsync()
    {
        // La venta en curso queda guardada y se recupera al volver a ingresar.
        await Cliente.CerrarSesionAsync();
        Navegacion.NavigateTo("ingreso", replace: true);
    }

    private void AlSeleccionarLinea(DatosLineaVenta linea)
    {
        _numeroSeleccionado = linea.NumeroLinea;
        _enfocar = true;
    }

    private void AlternarCodigo(int numeroLinea)
    {
        if (!_codigosInternos.Remove(numeroLinea))
            _codigosInternos.Add(numeroLinea);
        _enfocar = true;
    }

    private static bool EsEditable(DatosLineaVenta linea) => !linea.Anulada;

    private static string? ClaseCelda(DatosLineaVenta linea) => linea.Anulada ? "cg-venta__tachada" : null;

    private static string FormatoCantidad(DatosLineaVenta linea) => linea.Cantidad.ToString("N" + linea.DecimalesCantidad);

    /// <summary>
    /// Lo que se ve en la columna del subtotal. Una línea eliminada conserva su importe, tachado: así se lee lo que se
    /// había cobrado antes de quitarla; el total de la venta ya no la cuenta.
    /// </summary>
    private static decimal ImporteMostrado(DatosLineaVenta linea) => linea.Anulada ? linea.ImporteBruto : linea.Importe;

    /// <summary>Las líneas de la venta tal como se muestran: todas, las eliminadas tachadas en su lugar.</summary>
    private IReadOnlyList<DatosLineaVenta> LineasVisibles => _venta?.Lineas ?? [];

    private async Task AbrirCertificadoAsync()
    {
        if (_ecf is { CertificadoCargado: true })
        {
            // Con el certificado cargado, el botón solo muestra las alertas fiscales.
            _aviso = _ecf.Alertas.Count == 0 ? "Facturación electrónica al día." : null;
            _mensaje = _ecf.Alertas.Count == 0 ? null : string.Join(" ", _ecf.Alertas);
            return;
        }

        var parametros = new DialogParameters<DialogoCertificado> { { dialogo => dialogo.Estado, _ecf } };
        if (await MostrarDialogoAsync<DialogoCertificado, DatosEstadoEcf>("Certificado digital", parametros, MaxWidth.Small) is { } estado)
        {
            _ecf = estado;
            _aviso = "Certificado digital cargado. La caja puede facturar.";
            _mensaje = null;
        }

        StateHasChanged();
    }

    private string ClaseEcf => _ecf switch
    {
        { CertificadoCargado: false } => "error",
        { Alertas.Count: > 0 } => "alerta",
        _ => "correcto",
    };

    private string TextoEcf => _ecf switch
    {
        { CertificadoCargado: false } => "e-CF: digite el PIN",
        { Alertas.Count: > 0 } estado => $"e-CF: {estado.Alertas.Count} alerta(s)",
        _ => "e-CF listo",
    };

    private string ClaseSincronizacion => _sincronizacion switch
    {
        null => "error",
        { EnLinea: true } => "enlinea",
        _ => "sinconexion",
    };

    private string IconoSincronizacion => _sincronizacion switch
    {
        { Actualizacion.EnCurso: true } => Icons.Material.Filled.CloudSync,
        { EnLinea: true } => Icons.Material.Filled.CloudDone,
        _ => Icons.Material.Filled.CloudOff,
    };

    /// <summary>
    /// Se distingue quedarse sin red de que el Central no acepte esta caja: lo primero se arregla solo cuando vuelva la
    /// comunicación, lo segundo hay que ir a resolverlo. En los dos casos la caja sigue vendiendo.
    /// </summary>
    private string TextoSincronizacion => _sincronizacion switch
    {
        null => "Agente sin respuesta",
        // Mientras bajan datos se dice, porque es cuando la caja puede tardar en tener un artículo que ya está en el Central.
        { Actualizacion: { EnCurso: true, Detalle: { } detalle } } => $"Actualizando · {detalle}",
        { EnLinea: true } estado => $"En línea · {estado.DocumentosPendientes} pendientes{AvisoAlertas}",
        { SinConexionPor: MotivosSinConexion.Credenciales } estado =>
            $"Sin conexión (credenciales) · {estado.DocumentosPendientes} pendientes{AvisoAlertas}",
        var estado => $"Sin conexión (red) · {estado.DocumentosPendientes} pendientes{AvisoAlertas}",
    };

    private string? AvisoAlertas => _sincronizacion?.Alertas is { Count: > 0 } alertas ? $" · {alertas.Count} alerta(s)" : null;

    /// <summary>Último error de sincronización y alertas de mantenimiento (base, documentos atrasados, hora, respaldo).</summary>
    private string? DetalleSincronizacion => _sincronizacion is { } estado
        ? string.Join("\n", new[] { estado.UltimoError, estado.Actualizacion?.UltimoError }.Concat(estado.Alertas ?? []).Where(texto => !string.IsNullOrWhiteSpace(texto)))
        : null;

    /// <summary>Iniciales de la empresa configurada en la caja, para el recuadro del logo.</summary>
    private static string Iniciales(string? nombre) =>
        string.Concat((nombre ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(palabra => char.IsLetter(palabra[0]))
            .Take(2)
            .Select(palabra => char.ToUpperInvariant(palabra[0])));

    public void Dispose()
    {
        Atajos.TeclaPresionada -= AlPresionarTecla;
        _cierre.Cancel();
        _cierre.Dispose();
    }
