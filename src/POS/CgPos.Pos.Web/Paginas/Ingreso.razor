@page "/ingreso"
@implements IDisposable
@inject ClienteAgente Cliente
@inject AlmacenSesion Almacen
@inject NavigationManager Navegacion

<PageTitle>CG-POS · Ingreso a @_pantalla.Nombre.ToLowerInvariant()</PageTitle>

<div class="cg-ingreso">
    <section class="cg-ingreso__marca">
        <div>
            <div class="cg-ingreso__logo">CG-POS</div>
            <div class="cg-ingreso__empresa">@(_estado?.EmpresaNombre ?? "Punto de venta")</div>
        </div>

        <div>
            @if (_cargando)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Inherit" />
            }
            else if (_estado is null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">No hay comunicación con el servicio de la caja (CG-POS Agente).</MudAlert>
            }
            else
            {
                @if (_estado.CajaCodigo is not null)
                {
                    <div class="cg-ingreso__caja-titulo">Caja @_estado.CajaCodigo</div>
                    <div>@_estado.CajaNombre · @_estado.SucursalNombre</div>
                }

                @* Bajar los datos de una caja nueva tarda: mientras dura no es un error, es esperar. *@
                @if (_estado.Actualizacion is { EnCurso: true } actualizacion)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mt-4">
                        @(actualizacion.Detalle ?? "Actualizando la caja…")
                    </MudAlert>

                    @* La barra va fuera del aviso: dentro no toma el ancho de la tarjeta y se queda sin verse. Nunca va en
                       movimiento continuo: entre una etapa y otra se queda donde estaba, que es lo que de verdad pasó. *@
                    <div class="cg-progreso mt-2" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)_avance)">
                        <div class="cg-progreso__relleno" style="width: @(((int)_avance).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        <span class="cg-progreso__valor">@((int)_avance) %</span>
                    </div>
                }
                else if (_estado.Problema is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4">@_estado.Problema</MudAlert>
                    @if (_estado.Actualizacion?.UltimoError is { } fallo)
                    {
                        @* Lo que rechazó el Central en la última bajada: sin esto hay que ir a leer el registro del Agente. *@
                        <div class="cg-ingreso__detalle mt-2">La última actualización no se pudo aplicar: @fallo</div>
                    }
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle" Class="mt-4 ml-0">Caja habilitada</MudChip>
                }

                @* El Central no acepta esta caja. El motivo se lee en la pantalla de configuración, que es donde se corrige. *@
                @if (_configuracion is { Configurada: true, Sirve: false })
                {
                    <MudButton Variant="Variant.Filled" Class="mt-4 cg-ingreso__configurar" StartIcon="@Icons.Material.Filled.Settings"
                               OnClick="IrAConfigurar">
                        Configurar la caja
                    </MudButton>
                }
            }
        </div>

        <div>
            <div class="cg-ingreso__hora">@_ahora.ToString("h:mm tt")</div>
            <div class="cg-ingreso__fecha">@_ahora.ToString("dddd, d 'de' MMMM 'de' yyyy")</div>
        </div>
    </section>

    <section class="cg-ingreso__formulario">
        <MudPaper Elevation="3" Class="cg-ingreso__tarjeta">
            <NombrePantalla Pantalla="_pantalla" Prefijo="Ingreso a " Class="cg-nombre-pantalla--ingreso" />

            <div class="cg-ingreso__pin">
                <div class="cg-ingreso__campos">
                    <div @onclick="() => _campo = CampoActivo.Codigo">
                        <MudTextField T="string" @bind-Value="_codigo" Label="Usuario" Variant="Variant.Outlined" Disabled="@Bloqueada"
                                      Immediate="true" Class="@ClaseCampo(CampoActivo.Codigo)" OnKeyDown="AlTeclearCodigo" />
                    </div>
                    <div @onclick="() => _campo = CampoActivo.Clave">
                        <MudTextField T="string" @bind-Value="_clave" Label="Clave" InputType="InputType.Text" Variant="Variant.Outlined"
                                      Immediate="true" Style="-webkit-text-security: disc" Class="@($"cg-campo-clave {ClaseCampo(CampoActivo.Clave)}")" OnKeyDown="AlTeclearClaveAsync" Disabled="@Bloqueada" />
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" FullWidth="true"
                               Disabled="@(!PuedeIngresar)" Style="min-height: var(--cg-toque-minimo)" OnClick="IngresarAsync">
                        Ingresar
                    </MudButton>
                </div>

                @* Mientras la caja se actualiza el teclado se apaga: es la otra manera de escribir en los campos. *@
                <div class="@(Bloqueada ? "cg-ingreso__apagado" : null)">
                    <TecladoTactil Valor="@ValorCampoActivo" ValorChanged="AlCambiarTeclado" AlConfirmar="AlConfirmarTecladoAsync"
                                   Modo="ModoTeclado.Alfanumerico" PermitirDecimal="false" PermitirCambioModo="true"
                                   LongitudMaxima="@(_campo == CampoActivo.Clave ? 64 : 20)"
                                   TextoConfirmar="@(_campo == CampoActivo.Codigo ? "Siguiente" : "Ingresar")" />
                </div>
            </div>

            @if (_procesando)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="mt-3" />
            }
            @if (_mensaje is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3" Style="font-size: 1.05rem">@_mensaje</MudAlert>
            }
        </MudPaper>
    </section>
</div>

@code {
    private enum CampoActivo
    {
        Codigo,
        Clave,
    }

    /// <summary>Pantalla a la que se entra (?pantalla=principal|secundaria|devoluciones); sin indicar, la principal.</summary>
    [SupplyParameterFromQuery(Name = "pantalla")] public string? ClavePantalla { get; set; }

    private PantallaCaja _pantalla = PantallasCaja.Principal;
    private DatosEstadoCaja? _estado;
    private DatosConfiguracionPantalla? _configuracion;
    private bool _cargando = true;
    private bool _procesando;
    private string? _mensaje;
    private CampoActivo _campo = CampoActivo.Codigo;
    private string? _codigo;
    private string? _clave;
    private DateTime _ahora = DateTime.Now;
    private Timer? _temporizadorReloj;
    private Timer? _temporizadorEstado;

    /// <summary>Cada cuánto se vuelve a preguntar por el estado de la caja mientras no esté lista.</summary>
    private static readonly TimeSpan Espera = TimeSpan.FromSeconds(3);

    private bool CajaDisponible => _estado is { Habilitada: true };

    /// <summary>
    /// Mientras la caja baja sus datos no se deja entrar: los artículos, los precios y los permisos del usuario todavía
    /// están a medio aplicar, y una venta hecha en ese momento saldría con lo que hubiera llegado hasta ahí.
    /// </summary>
    private bool Bloqueada => _estado?.Actualizacion is { EnCurso: true };

    /// <summary>
    /// Lo que marca la barra. Las etapas que no se cuentan (pedirle los datos al Central, guardarlos) no la mueven ni la
    /// devuelven a cero: se queda donde estaba, porque retroceder haría pensar que algo salió mal.
    /// </summary>
    private double _avance;

    private void ActualizarAvance()
    {
        if (_estado?.Actualizacion is not { EnCurso: true } actualizacion)
        {
            _avance = 0;
            return;
        }

        if (actualizacion is { Total: > 0 } contado)
            _avance = Math.Clamp((contado.Hechos ?? 0) * 100d / contado.Total!.Value, 0, 100);
    }

    private bool PuedeIngresar =>
        CajaDisponible && !Bloqueada && !_procesando && !string.IsNullOrWhiteSpace(_codigo) && !string.IsNullOrEmpty(_clave);

    private string ValorCampoActivo => (_campo == CampoActivo.Codigo ? _codigo : _clave) ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _pantalla = PantallasCaja.PorClave(ClavePantalla);
        if (Almacen.Activa)
        {
            Navegacion.NavigateTo(Almacen.RutaInicial(_pantalla), replace: true);
            return;
        }

        // Una caja recién instalada no sabe cuál es: antes de pedir usuario hay que decirle qué caja es y dónde está su
        // Central. Se entra por aquí sea cual sea la pantalla desde la que se abrió.
        _configuracion = await Cliente.ObtenerConfiguracionAsync();
        if (_configuracion is not { Configurada: true })
        {
            Navegacion.NavigateTo($"/configurar?pantalla={ClavePantalla}", replace: true);
            return;
        }

        _temporizadorReloj = new Timer(_ =>
        {
            _ahora = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        _estado = await Cliente.ObtenerEstadoCajaAsync();
        _cargando = false;

        _temporizadorEstado = new Timer(_ => InvokeAsync(RevisarEstadoAsync), null, Espera, Espera);
    }

    /// <summary>
    /// Mientras la caja no esté lista se sigue preguntando: una caja recién configurada pasa sola de «actualizando» a
    /// habilitada, y sin esto el cajero tendría que recargar la pantalla para enterarse.
    ///
    /// Se deja de preguntar solo cuando ya no hay nada que esperar. Son dos condiciones, no una: la caja puede estar
    /// habilitada y seguir bajando maestros, y mirar solo lo primero dejaba el aviso de «actualizando» clavado en
    /// pantalla aunque la carga hubiera terminado.
    /// </summary>
    private async Task RevisarEstadoAsync()
    {
        _estado = await Cliente.ObtenerEstadoCajaAsync();
        ActualizarAvance();
        StateHasChanged();

        if (CajaDisponible && _estado?.Actualizacion is not { EnCurso: true })
        {
            _temporizadorEstado?.Dispose();
            _temporizadorEstado = null;
        }
    }

    private void IrAConfigurar() => Navegacion.NavigateTo($"/configurar?pantalla={ClavePantalla}");

    private string? ClaseCampo(CampoActivo campo) => _campo == campo ? "cg-campo-activo" : null;

    private void AlCambiarTeclado(string valor)
    {
        if (_campo == CampoActivo.Codigo)
            _codigo = valor;
        else
            _clave = valor;
    }

    private Task AlConfirmarTecladoAsync(string _)
    {
        if (_campo == CampoActivo.Codigo)
        {
            _campo = CampoActivo.Clave;
            return Task.CompletedTask;
        }

        return IngresarAsync();
    }

    private void AlTeclearCodigo(KeyboardEventArgs evento)
    {
        if (evento.Key == "Enter")
            _campo = CampoActivo.Clave;
    }

    private Task AlTeclearClaveAsync(KeyboardEventArgs evento) =>
        evento.Key == "Enter" ? IngresarAsync() : Task.CompletedTask;

    private Task IngresarAsync() =>
        PuedeIngresar
            ? EjecutarIngresoAsync(() => Cliente.IngresarAsync(_codigo!.Trim(), _clave!))
            : Task.CompletedTask;

    private async Task EjecutarIngresoAsync(Func<Task<RespuestaIngreso>> ingresar)
    {
        if (_procesando)
            return;

        _procesando = true;
        _mensaje = null;
        var respuesta = await ingresar();
        _procesando = false;

        if (respuesta.Exitoso)
        {
            Navegacion.NavigateTo(Almacen.RutaInicial(_pantalla), replace: true);
            return;
        }

        _mensaje = respuesta.Mensaje ?? "No se pudo iniciar sesión.";
        _clave = string.Empty;
    }

    public void Dispose()
    {
        _temporizadorReloj?.Dispose();
        _temporizadorEstado?.Dispose();
    }
}
