@page "/no-encontrada"
@layout DisenoPrincipal

<PageTitle>CG-POS · Página no encontrada</PageTitle>

@* Aviso de ruta inexistente: puede salir si se abre una pantalla con una dirección mal escrita. *@
<div class="cg-venta__aviso">
    <MudAlert Severity="Severity.Info" Class="ma-6">
        La página que busca no existe. Vuelva a la pantalla de venta.
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="ma-6">Ir a la venta</MudButton>
</div>
