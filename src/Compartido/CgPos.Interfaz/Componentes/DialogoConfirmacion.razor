@* Modal de confirmación táctil. Usar con IDialogService.ConfirmarAsync(...). *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(EsPeligrosa ? Icons.Material.Filled.WarningAmber : Icons.Material.Filled.HelpOutline)"
                     Color="@(EsPeligrosa ? Color.Error : Color.Primary)" Class="mr-2" Style="vertical-align: middle" />
            @Dialogo.Title
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Style="font-size: 1.15rem">@Mensaje</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Large" Variant="Variant.Outlined" Color="Color.Default" Style="min-height: var(--cg-toque-minimo); min-width: 140px" OnClick="Cancelar">
            @TextoCancelar
        </MudButton>
        <MudButton Size="Size.Large" Variant="Variant.Filled" Color="@(EsPeligrosa ? Color.Error : Color.Secondary)" Style="min-height: var(--cg-toque-minimo); min-width: 140px" OnClick="Confirmar">
            @TextoConfirmar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter] public string Mensaje { get; set; } = string.Empty;
    [Parameter] public string TextoConfirmar { get; set; } = "Aceptar";
    [Parameter] public string TextoCancelar { get; set; } = "Cancelar";
    [Parameter] public bool EsPeligrosa { get; set; }

    private void Confirmar() => Dialogo.Close(DialogResult.Ok(true));
    private void Cancelar() => Dialogo.Cancel();
}
