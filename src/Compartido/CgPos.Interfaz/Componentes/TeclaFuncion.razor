@* Botón táctil de tecla de función (estilo barra F2…F12 de la pantalla de venta). *@
<button type="button"
        class="cg-tecla-f @(EsAccionPrincipal ? "cg-tecla-f--accion" : null) @Clase"
        disabled="@Deshabilitada"
        title="@(Titulo ?? Texto)"
        @onclick="AlPresionar">
    @if (Icono is not null)
    {
        <MudIcon Icon="@Icono" Class="cg-tecla-f__icono" />
    }
    <span>
        @if (!string.IsNullOrEmpty(Atajo))
        {
            <span class="cg-tecla-f__atajo">@Atajo</span>
        }
        @Texto
    </span>
</button>

@code {
    /// <summary>
    /// Tecla física asociada, ej. "F2". Solo se muestra; el atajo se escucha con
    /// <see cref="CgPos.Interfaz.Servicios.ServicioAtajosTeclado"/>.
    /// </summary>
    [Parameter] public string? Atajo { get; set; }

    [Parameter, EditorRequired] public string Texto { get; set; } = string.Empty;

    /// <summary>Ícono de MudBlazor, ej. <c>Icons.Material.Filled.Search</c>.</summary>
    [Parameter] public string? Icono { get; set; }

    [Parameter] public string? Titulo { get; set; }
    [Parameter] public bool Deshabilitada { get; set; }
    [Parameter] public bool EsAccionPrincipal { get; set; }
    [Parameter] public string? Clase { get; set; }
    [Parameter] public EventCallback AlPresionar { get; set; }
}
