@* Grilla con filas altas, encabezado verde y selección por toque. Base para líneas de venta, devoluciones, búsquedas. *@
@typeparam TItem

<MudTable T="TItem"
          Items="Items"
          Class="@($"cg-grilla {Class}")"
          Hover="true"
          FixedHeader="true"
          Height="@Altura"
          Elevation="0"
          RowClassFunc="ClaseFila"
          OnRowClick="AlTocarFila">
    <HeaderContent>@Encabezado</HeaderContent>
    <RowTemplate>@Fila(context)</RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body1" Class="pa-6" Color="Color.Secondary">@TextoSinRegistros</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }
    [Parameter, EditorRequired] public RenderFragment? Encabezado { get; set; }
    [Parameter, EditorRequired] public RenderFragment<TItem> Fila { get; set; } = default!;

    [Parameter] public TItem? Seleccionado { get; set; }
    [Parameter] public EventCallback<TItem> SeleccionadoChanged { get; set; }

    /// <summary>Marca filas en rojo (ej. líneas eliminadas con monto negativo).</summary>
    [Parameter] public Func<TItem, bool>? EsAnulada { get; set; }

    [Parameter] public string? Altura { get; set; }
    [Parameter] public string TextoSinRegistros { get; set; } = "Sin registros";
    [Parameter] public string? Class { get; set; }

    private string ClaseFila(TItem item, int _)
    {
        var clases = new List<string>(2);
        if (Seleccionado is not null && EqualityComparer<TItem>.Default.Equals(item, Seleccionado))
            clases.Add("cg-fila--seleccionada");
        if (EsAnulada?.Invoke(item) == true)
            clases.Add("cg-fila--anulada");
        return string.Join(' ', clases);
    }

    private Task AlTocarFila(TableRowClickEventArgs<TItem> args)
    {
        Seleccionado = args.Item;
        return SeleccionadoChanged.InvokeAsync(args.Item);
    }
}
